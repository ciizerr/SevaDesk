<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock loc:Loc.Key="Sessions.Title" Text="Counter Sessions" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            <TextBlock loc:Loc.Key="Sessions.ActiveBadge" Text="Active" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.PausedCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            <TextBlock loc:Loc.Key="Sessions.PausedBadge" Text="Paused" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock loc:Loc.Key="Sessions.Subtitle"
                           Text="Simultaneously manage multiple citizens at the desk with isolated working folders"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Sessions.RefreshBtn" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewSession_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Sessions.StartNewBtn" Text="Start New Session" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main 2-Column Split: Sessions List on Left, Active Session Console on Right -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="16">
            <!-- Left: Sessions List -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock loc:Loc.Key="Sessions.OngoingVisits" Text="Ongoing Visits" FontWeight="SemiBold" />
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActiveSessionItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" VerticalAlignment="Center">
                                    <PersonPicture Grid.Column="0" Width="36" Height="36"
                                                   Initials="{x:Bind Customer.Initials}" Margin="0,0,10,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" FontSize="14" />
                                            <Border CornerRadius="4" Padding="5,1"
                                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontFamily="Consolas" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Session.Notes}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>

                                    <!-- Status indicator badge -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="6,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Session.Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Active Session Desk Console -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- In-App Triage InfoBar for Incoming Files -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasPendingIncomingFile, Mode=OneWay}"
                             IsClosable="True"
                             CloseButtonClick="TriageClose_Click"
                             Severity="Informational"
                             Title="Incoming File Detected"
                             Message="{x:Bind ViewModel.PendingIncomingFile.FileName, Mode=OneWay}"
                             Margin="0,0,0,4">
                        <InfoBar.ActionButton>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="RoutePendingFile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                    <TextBlock loc:Loc.Key="Triage.MoveToCustomerBtn" Text="Move to Customer" />
                                </StackPanel>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Customer Profile & Session Controller Card -->
                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PersonPicture Grid.Column="0" Width="52" Height="52"
                                               Initials="{x:Bind ViewModel.SelectedSession.Customer.Initials, Mode=OneWay}"
                                               Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Name, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                        <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Code, Mode=OneWay}"
                                                       FontFamily="Consolas" FontSize="12" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Mobile, Mode=OneWay}"
                                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Village, Mode=OneWay}"
                                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons: Pause/Resume & Finish -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="ToggleStatus_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE769;" FontSize="14" />
                                            <TextBlock loc:Loc.Key="Sessions.PauseResumeBtn" Text="Pause / Resume" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="CompleteSession_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                            <TextBlock loc:Loc.Key="Sessions.FinishBillBtn" Text="Finish &amp; Bill" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Folder Location & Direct Explorer Launcher -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock loc:Loc.Key="Sessions.FolderLocationLabel" Text="Session Folder on Desktop:" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderPath, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        <TextBlock loc:Loc.Key="Sessions.OpenFolderBtn" Text="Open in Explorer" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4 Subfolder Quick Access Tiles -->
                    <!-- Subfolder Quick Access Tiles -->
                    <TextBlock loc:Loc.Key="Sessions.WorkingSubfolders" Text="Working Subfolders" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Tile 00: Loose Files -->
                        <Border Grid.Column="0" Padding="14" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="#FFFBEB" Margin="0,0,12,0">
                                    <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock loc:Loc.Key="Sessions.TileLooseFilesTitle" Text="Loose Files (Root)" FontWeight="SemiBold" />
                                    <TextBlock loc:Loc.Key="Sessions.TileLooseFilesDesc" Text="Incoming scans, photos &amp; raw files" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="#FEF3C7" Padding="8,2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderStats.UnorganisedCount, Mode=OneWay}"
                                                   FontWeight="Bold" Foreground="#D97706" FontSize="12" />
                                    </Border>
                                    <Button Background="Transparent" BorderBrush="Transparent" Padding="4" Tag="" Click="OpenSubfolderTile_Click" ToolTipService.ToolTip="Open Root Customer Folder">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tile 01: Shared Documents -->
                        <Border Grid.Column="1" Padding="14" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="#EFF6FF" Margin="0,0,12,0">
                                    <FontIcon Glyph="&#xE8A5;" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock loc:Loc.Key="Sessions.TileSharedDocsTitle" Text="Shared Docs" FontWeight="SemiBold" />
                                    <TextBlock loc:Loc.Key="Sessions.TileSharedDocsDesc" Text="Permanent Aadhaar, PAN, marksheets" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="#DBEAFE" Padding="8,2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderStats.SharedDocsCount, Mode=OneWay}"
                                                   FontWeight="Bold" Foreground="#1D4ED8" FontSize="12" />
                                    </Border>
                                    <Button Background="Transparent" BorderBrush="Transparent" Padding="4" Tag="Shared Docs" Click="OpenSubfolderTile_Click" ToolTipService.ToolTip="Open Shared Docs">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Application Subfolders Section -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock loc:Loc.Key="Sessions.AppFoldersTitle" Text="Application Subfolders" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Sessions.AppFoldersDesc" Text="Dedicated folders for specific citizen schemes (PMS, SSC, NSP, GDS)"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="AddAppFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock loc:Loc.Key="Sessions.AddAppFolderBtn" Text="Add Folder" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Dynamic Application Folders ItemsControl -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ApplicationFolders, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="OpenAppFolder_Click" Tag="{x:Bind}" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind}" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

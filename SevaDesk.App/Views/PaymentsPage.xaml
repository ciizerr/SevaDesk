<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.PaymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views"
    xmlns:vm="using:SevaDesk_App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24">
            <!-- Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Cashier &amp; Billing POS" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="1-click rate card charging, dynamic UPI QR billing, and daily cash counter ledger"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Daily Sales Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="UPI Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayUpiTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" Foreground="#10B981" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="Cash Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayCashTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock Text="Today's Total" FontSize="10" Foreground="#E0E7FF" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayTotalSales, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Status InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Success" Title="Payment"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- Main Layout: Rate Card on Left, Bill & UPI on Right -->
            <Grid ColumnDefinitions="*,420" ColumnSpacing="20">
                <!-- Left: Cyber Café Service Rate Card -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16" />
                                <TextBlock Text="Quick Charge Rate Card" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="(Tap any item to add to bill)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <GridView ItemsSource="{x:Bind ViewModel.RateCard, Mode=OneWay}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="RateCard_ItemClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServiceRateItem">
                                        <Border Width="175" Height="100" Padding="12" CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="16"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0" />

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                                    <TextBlock Text="₹" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Rate}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="/" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{x:Bind Unit}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- Today's Transactions Ledger -->
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                    <TextBlock Text="Today's Payment Ledger" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TransactionItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="12,10" VerticalAlignment="Center"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                    <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                        <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="6,2" Margin="0,0,16,0"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind PaymentMode}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"
                                                       Text="{x:Bind FormattedAmount}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right: Current Bill & Dynamic UPI Terminal -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <!-- Bill Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Current Bill" FontWeight="Bold" FontSize="16" />
                                    <TextBox Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Customer name / walk-in..." Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" Click="ClearBill_Click">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Cart Items List -->
                            <ListView ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,6" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Rate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Qty Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                                <Button Padding="6,2" Click="DecreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="-" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                                <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Width="20" TextAlignment="Center" />
                                                <Button Padding="6,2" Click="IncreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="+" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="8,0"
                                                       Text="{x:Bind FormattedTotal, Mode=OneWay}" />

                                            <Button Grid.Column="3" Padding="4" Background="Transparent" BorderThickness="0"
                                                    Click="RemoveItem_Click" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Grand Total Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total Payable:" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FormattedGrandTotal, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Dynamic UPI Card / QR Preview -->
                            <Border CornerRadius="8" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <!-- Visual QR Pattern Placeholder with Native WinUI styling -->
                                    <Border Grid.Column="0" Width="90" Height="90" CornerRadius="6" Background="White" Padding="6">
                                        <Grid>
                                            <!-- High-contrast QR simulated icon for crisp presentation -->
                                            <FontIcon Glyph="&#xED14;" FontSize="72" Foreground="#0F172A"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8C7;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Scan &amp; Pay via Any UPI App" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ShopUpiId, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                        <TextBlock Text="GPay, PhonePe, Paytm, BHIM" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Payment Settlement Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="PayCash_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="#10B981" />
                                        <TextBlock Text="Mark Paid (Cash)" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="PayUpi_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                                        <TextBlock Text="Mark Paid (UPI)" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

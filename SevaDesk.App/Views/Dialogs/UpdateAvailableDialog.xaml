<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.UpdateAvailableDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Update Available! &#x1F389;"
    PrimaryButtonText="Download &amp; Install"
    SecondaryButtonText="Later"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    mc:Ignorable="d" CornerRadius="12">

    <Grid MinWidth="480" MaxWidth="600" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TxtVersionInfo" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="What's new in this release:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Changelog -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" MaxHeight="300">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtChangelog" TextWrapping="Wrap" FontSize="13" />
            </ScrollViewer>
        </Border>

        <!-- Progress Area -->
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Spacing="8">
            <TextBlock x:Name="TxtProgressStatus" Text="Downloading update..." FontSize="13" FontWeight="SemiBold" />
            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" />
            <TextBlock x:Name="TxtProgressDetails" Text="0 MB / 0 MB" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</ContentDialog>

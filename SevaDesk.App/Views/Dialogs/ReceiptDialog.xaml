<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.ReceiptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Invoice"
    PrimaryButtonText="Done"
    DefaultButton="Primary"
    mc:Ignorable="d" CornerRadius="12">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Width="384" Margin="0,0,4,0">
            <!-- Clean Business Invoice Card -->
            <Border x:Name="ReceiptCard"
                    RequestedTheme="Light"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,16"
                    Width="384">
                <StackPanel Spacing="12">
                    <!-- Top Invoice Header: 2 Columns -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <!-- Left: Business Name & Details -->
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="TxtShopName" Text="SevaDesk Cyber Center"
                                       FontWeight="Bold" FontSize="15" Foreground="#0F172A"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtShopAddress" Text="Digital Seva &amp; CSC Center"
                                       FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtShopContact" Text=""
                                       FontSize="10" Foreground="#64748B" />
                        </StackPanel>

                        <!-- Right: INVOICE Title & Metadata -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="INVOICE" FontWeight="Bold" FontSize="15" Foreground="#0F172A"
                                       HorizontalAlignment="Right" CharacterSpacing="50" />
                            <TextBlock x:Name="TxtInvoiceNo" Text="INV-2026-0001" FontFamily="Consolas"
                                       FontWeight="SemiBold" FontSize="11.5" Foreground="#475569" HorizontalAlignment="Right" />
                            <TextBlock x:Name="TxtDateTime" Text="27-Sep-2026 10:00 AM"
                                       FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right" />
                            <Border x:Name="BadgeBorder" Margin="0,3,0,0" HorizontalAlignment="Right"
                                    Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                <TextBlock x:Name="TxtPaidBadge" Text="PAID" FontSize="9" FontWeight="Bold" Foreground="#059669" CharacterSpacing="30" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#E2E8F0" />

                    <!-- Billed To Customer Section -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="BILLED TO" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="40" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" x:Name="TxtCustomerName" Text="Walk-in Customer"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" x:Name="TxtCustomerPhone" Text=""
                                           FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="TxtCustomerAddress" Text=""
                                       FontSize="10.5" Foreground="#64748B" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Items Table Header -->
                    <Grid ColumnDefinitions="20,*,32,48,58" ColumnSpacing="6"
                          Background="#F1F5F9" CornerRadius="4" Padding="8,5">
                        <TextBlock Grid.Column="0" Text="#" FontSize="8.5" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Grid.Column="1" Text="DESCRIPTION" FontSize="8.5" FontWeight="Bold" Foreground="#475569" CharacterSpacing="20" />
                        <TextBlock Grid.Column="2" Text="QTY" FontSize="8.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="RATE" FontSize="8.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="8.5" FontWeight="Bold" Foreground="#475569" TextAlignment="Right" />
                    </Grid>

                    <!-- Items Container -->
                    <StackPanel x:Name="ItemsContainer" Spacing="4" Padding="2,0">
                        <!-- Populated in code-behind -->
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#E2E8F0" />

                    <!-- Totals Summary -->
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="11" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" x:Name="TxtSubtotal" Text="₹0" FontSize="11" Foreground="#0F172A" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" x:Name="DiscountRow" Visibility="Collapsed">
                            <TextBlock Grid.Column="0" Text="Less Discount:" FontSize="11" Foreground="#059669" />
                            <TextBlock Grid.Column="1" x:Name="TxtDiscount" Text="-₹0" FontSize="11" Foreground="#059669" FontWeight="SemiBold" />
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTotalHeading" Text="Total Paid" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" />
                                <Border x:Name="PaymentModeBadge" CornerRadius="4" Padding="6,2" Background="#F1F5F9" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPaymentMode" Text="CASH" FontSize="9" FontWeight="Bold" Foreground="#2563EB" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtGrandTotal" Text="₹0" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                        </Grid>
                    </StackPanel>

                    <!-- Clean Payment Card for Pending Bill -->
                    <Border x:Name="PendingQrContainer" Visibility="Collapsed"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Scan to Pay" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
                            <Border Width="124" Height="124" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" Padding="4">
                                <Image x:Name="ImgPendingQr" Width="114" Height="114" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="GPay • PhonePe • Paytm • BHIM" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtQrNote" Text="Ref: INV-0000" FontSize="9.5" FontFamily="Consolas" Foreground="#475569" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Slip Footer Message -->
                    <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Thank you for your visit."
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Customer Mobile Input for WhatsApp -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="WhatsApp Mobile:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="TxtMobileInput" Height="28" Padding="8,2" FontSize="11.5"
                             PlaceholderText="10-digit number" MaxLength="10" InputScope="TelephoneNumber" />
                    <Border Grid.Column="2" x:Name="MobileVerifiedBadge" Visibility="Collapsed" Width="20" Height="20" CornerRadius="10" Background="#10B981" VerticalAlignment="Center" ToolTipService.ToolTip="10-digit mobile number ready">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Format Switcher (JPG Image vs A4 PDF Document) -->
            <Grid ColumnDefinitions="*,*" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="3">
                <Button x:Name="BtnFormatJpg" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" CornerRadius="6"
                        Click="FormatJpg_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                        <TextBlock Text="JPG Image" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnFormatPdf" Grid.Column="1" HorizontalAlignment="Stretch" Height="32" CornerRadius="6"
                        Click="FormatPdf_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEA90;" FontSize="12" />
                        <TextBlock Text="PDF Document (A4)" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Invoice Actions Toolbar -->
            <StackPanel Spacing="8">
                <!-- Direct Settle Actions (Visible when Pending, 100% crash-free) -->
                <Grid x:Name="SettlePaymentPanel" Visibility="Collapsed" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Height="36" HorizontalAlignment="Stretch"
                            Background="#10B981" Foreground="White" CornerRadius="6"
                            Click="CollectCash_Click"
                            ToolTipService.ToolTip="Mark invoice paid via Cash">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" FontSize="12" />
                            <TextBlock Text="Collect Cash" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Height="36" HorizontalAlignment="Stretch"
                            Background="#2563EB" Foreground="White" CornerRadius="6"
                            Click="CollectUpi_Click"
                            ToolTipService.ToolTip="Mark invoice paid via UPI">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8C7;" FontSize="12" />
                            <TextBlock Text="Collect UPI" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Send on WhatsApp Button -->
                <Button Height="38" HorizontalAlignment="Stretch"
                        Background="#25D366" Foreground="White" CornerRadius="6"
                        Click="SendWhatsApp_Click"
                        ToolTipService.ToolTip="Copy invoice file and open customer WhatsApp chat">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8BD;" FontSize="15" />
                        <TextBlock x:Name="TxtWhatsAppBtn" Text="Send on WhatsApp" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <!-- Secondary Actions: Save File, Copy, Print -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Height="34" HorizontalAlignment="Stretch" CornerRadius="6"
                            Click="SaveFile_Click"
                            ToolTipService.ToolTip="Save invoice file to your computer">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock x:Name="TxtSaveBtn" Text="Save File" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Height="34" HorizontalAlignment="Stretch" CornerRadius="6"
                            Click="CopySlip_Click"
                            ToolTipService.ToolTip="Copy invoice to Windows clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            <TextBlock x:Name="TxtCopyBtn" Text="Copy" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Height="34" HorizontalAlignment="Stretch" CornerRadius="6"
                            Click="PrintReceipt_Click"
                            ToolTipService.ToolTip="Open A4 invoice in PDF viewer to print">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE749;" FontSize="12" />
                            <TextBlock Text="Print" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Status Guidance Banner inside dialog -->
            <Border x:Name="StatusBanner" Visibility="Collapsed"
                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                    CornerRadius="6" Padding="10,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="IconStatus" Glyph="&#xE73E;" FontSize="13" Foreground="#059669" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="TxtActionStatus" Text="" FontSize="11"
                               Foreground="#065F46" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>


<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.ManageRatesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    Title="Rate Card"
    CloseButtonText="Done"
    DefaultButton="Close"
    mc:Ignorable="d">

    <Grid MinWidth="620" MaxWidth="680" MaxHeight="500" ColumnDefinitions="310,12,310" Margin="0,4,0,0">
        <!-- Left Column: Existing Services List & Search -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SearchRateBox" PlaceholderText="Search services..."
                         TextChanged="SearchRateBox_TextChanged" />
                <Button Grid.Column="1" Click="NewServiceButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Create a new service entry">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView x:Name="ServicesListView" Grid.Row="1"
                      SelectionMode="Single"
                      SelectionChanged="ServicesListView_SelectionChanged"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8"
                      Padding="2" MaxHeight="430">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceRateItem">
                        <Grid Padding="8,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                            <!-- Icon Container -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Service Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Category}" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Rate Badge -->
                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedRate}" FontWeight="Bold" FontSize="11"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2,0" />

                            <!-- Edit Button -->
                            <Button Grid.Column="3" Padding="4" Background="Transparent" BorderBrush="Transparent"
                                    Click="EditService_Click" Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Edit Service">
                                <FontIcon Glyph="&#xE70F;" FontSize="11" />
                            </Button>

                            <!-- Delete Button with Flyout Confirmation -->
                            <Button Grid.Column="4" Padding="4" Background="Transparent" BorderBrush="Transparent"
                                    ToolTipService.ToolTip="Delete Service">
                                <FontIcon Glyph="&#xE74D;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="8" Width="170">
                                            <TextBlock Text="Delete Service?" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Remove this service from the rate card?" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Button Content="Delete" Click="ConfirmDelete_Click" Tag="{x:Bind}"
                                                    HorizontalAlignment="Stretch" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Vertical Divider -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Center" />

        <!-- Right Column: Add / Edit Service Form -->
        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="TxtFormHeader" Text="Add Service" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="TxtFormSubtitle" Text="Set price and details"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Service Name -->
                    <TextBox x:Name="TxtServiceName" PlaceholderText="e.g. Color Xerox / Print">
                        <TextBox.Header>
                            <TextBlock FontSize="12">
                                <Run Text="Service Name" />
                                <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                            </TextBlock>
                        </TextBox.Header>
                    </TextBox>

                    <!-- Category -->
                    <ComboBox x:Name="CmbCategory" Header="Category" IsEditable="True" HorizontalAlignment="Stretch" />

                    <!-- Price & Unit -->
                    <Grid ColumnDefinitions="*,8,*" ColumnSpacing="0">
                        <NumberBox x:Name="NumRate" Grid.Column="0" Value="10" Minimum="0" SpinButtonPlacementMode="Compact">
                            <NumberBox.Header>
                                <TextBlock FontSize="12">
                                    <Run Text="Rate (₹)" />
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                                </TextBlock>
                            </NumberBox.Header>
                        </NumberBox>
                        <ComboBox x:Name="CmbUnit" Grid.Column="2" Header="Unit" IsEditable="True" HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Icon Selector Grid (5 columns x 2 rows) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Service Icon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid x:Name="IconPickerGrid" ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6" />
                    </StackPanel>

                    <!-- Status Notification InfoBar -->
                    <InfoBar x:Name="DialogStatusInfoBar" IsOpen="False" Severity="Success" IsClosable="True" />

                    <!-- Form Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                        <Button x:Name="BtnSaveService" Grid.Column="0" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Content="Save" Click="SaveService_Click" />
                        <Button x:Name="BtnCancelEdit" Grid.Column="1" HorizontalAlignment="Stretch"
                                Content="Reset" Click="CancelEdit_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="None"
    CornerRadius="12">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" Margin="0,4,0,0">
        <!-- Top Header & Step Progress Tracker -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- Left: App Identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8" Width="32" Height="32">
                    <FontIcon Glyph="&#xE7EE;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SevaDesk" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="Beta 0.1.0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Step Indicator & Dots -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStepIndicator" Text="Step 1 of 5" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="Dot1" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Border x:Name="Dot2" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border x:Name="Dot3" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border x:Name="Dot4" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border x:Name="Dot5" Width="8" Height="8" CornerRadius="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Main Step Content Container (Scrollable so buttons in footer are never clipped) -->
        <ScrollViewer Grid.Row="2"
                      MaxHeight="280"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <Grid>
                <!-- ================= STEP 1: Language & Welcome ================= -->
                <StackPanel x:Name="Step1Panel" Spacing="18" Visibility="Visible">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtStep1Title" Text="Welcome to SevaDesk"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtStep1Tagline"
                               Text="Your smart companion for Cyber Cafés &amp; Digital Seva / CSC Centers"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,4,0,0">
                    <TextBlock x:Name="TxtStep1LangPrompt" Text="Select Your Language"
                               FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="TxtStep1LangSub" Text="You can change this anytime from Settings"
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- Language Selection Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,4,0,0">
                    <!-- English Card -->
                    <Button x:Name="BtnLangEnglish" Grid.Column="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="16,18" CornerRadius="8"
                            BorderThickness="2"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Click="LangEnglish_Click">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="English" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Continue in English" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon x:Name="IconCheckEnglish" Grid.Column="2" Glyph="&#xE73E;"
                                      FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" Visibility="Visible" />
                        </Grid>
                    </Button>

                    <!-- Hindi Card -->
                    <Button x:Name="BtnLangHindi" Grid.Column="1"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="16,18" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Click="LangHindi_Click">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="हिंदी (Hindi)" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="हिंदी भाषा में उपयोग करें" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon x:Name="IconCheckHindi" Grid.Column="2" Glyph="&#xE73E;"
                                      FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ================= STEP 2: Shop & Operator Profile ================= -->
            <StackPanel x:Name="Step2Panel" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtStep2Title" Text="Shop &amp; Operator Profile"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtStep2Subtitle"
                               Text="This information appears on customer receipts and invoices"
                               FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Shop Name (Mandatory) -->
                <TextBox x:Name="BoxShopName"
                         PlaceholderText="e.g. Shri Krishna Cyber Cafe / Digital Seva Kendra"
                         TextChanged="BoxShopName_TextChanged">
                    <TextBox.Header>
                        <TextBlock FontSize="12">
                            <Run x:Name="RunShopNameLabel" Text="Shop / Center Name" />
                            <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                        </TextBlock>
                    </TextBox.Header>
                </TextBox>

                <!-- 2-Column: Operator Name & Contact Number -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <TextBox x:Name="BoxOperatorName" Grid.Column="0"
                             Header="Operator / VLE Name"
                             PlaceholderText="e.g. Ramesh Kumar" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBox x:Name="BoxContactNumber"
                                 Header="WhatsApp / Mobile Number"
                                 PlaceholderText="10-digit number"
                                 MaxLength="10" />
                        <TextBlock x:Name="TxtContactError" Text="Enter a valid 10-digit mobile number"
                                   FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- Shop Address -->
                <TextBox x:Name="BoxShopAddress"
                         Header="Shop Address / Area"
                         PlaceholderText="e.g. Main Market, Near Bus Stand, Rampur" />
            </StackPanel>

            <!-- ================= STEP 3: Digital Payments & UPI QR ================= -->
            <StackPanel x:Name="Step3Panel" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtStep3Title" Text="Digital Payments &amp; UPI QR"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtStep3Subtitle"
                               Text="Show instant payment QR codes on counter and customer receipts"
                               FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,200" ColumnSpacing="18">
                    <!-- Left: UPI Inputs & Info -->
                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBox x:Name="BoxUpiId"
                                 Header="Shop UPI ID (VPA)"
                                 PlaceholderText="e.g. shopname@okhdfcbank or 9876543210@paytm"
                                 TextChanged="UpiInputs_TextChanged" />

                        <TextBox x:Name="BoxPayeeName"
                                 Header="Payee Name"
                                 PlaceholderText="e.g. Digital Seva Kendra"
                                 TextChanged="UpiInputs_TextChanged" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtUpiHint"
                                           Text="Customers can scan this to pay directly to your shop bank account via GPay, PhonePe, Paytm, or BHIM."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Live QR Preview Card -->
                    <Border Grid.Column="1"
                            RequestedTheme="Light"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,14"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FFFFFF">
                                <Grid Width="140" Height="140">
                                    <Image x:Name="ImgQrPreview" Stretch="Uniform" />
                                    <TextBlock x:Name="TxtQrPlaceholder" Text="Enter UPI ID to generate QR" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#059669" />
                                <TextBlock Text="Live Preview" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ================= STEP 4: Storage & Backups ================= -->
            <StackPanel x:Name="Step4Panel" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Storage &amp; Backups"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Choose where to save your customer records and database backups"
                               FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Working Directory -->
                <StackPanel Spacing="4">
                    <TextBlock FontSize="12">
                        <Run Text="Working Directory" />
                        <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                    </TextBlock>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="BoxWorkingDirectory" Grid.Column="0" IsReadOnly="True"
                                 PlaceholderText="Select a folder..." />
                        <Button x:Name="BtnBrowseWorkingDir" Grid.Column="1" Content="Browse..." 
                                Click="BtnBrowseWorkingDir_Click" />
                    </Grid>
                    <TextBlock Text="Where customer files, receipts, and invoices are temporarily stored"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Backup Directory -->
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Backup Location" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="BoxBackupDirectory" Grid.Column="0" IsReadOnly="True"
                                 PlaceholderText="Select a folder..." />
                        <Button x:Name="BtnBrowseBackupDir" Grid.Column="1" Content="Browse..." 
                                Click="BtnBrowseBackupDir_Click" />
                    </Grid>
                    <TextBlock Text="Where automatic database backups are saved (preferably a different drive)"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ================= STEP 5: Ready to Launch ================= -->
            <StackPanel x:Name="Step5Panel" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtStep5Title" Text="You're All Set!"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtStep5Subtitle"
                               Text="Everything is ready for your counter operations"
                               FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 3 Superpowers Cards -->
                <StackPanel Spacing="8">
                    <!-- Superpower 1: Widget -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE737;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TxtFeature1Title" Text="Desktop Floating Widget" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="TxtFeature1Desc"
                                           Text="Docked on your screen edge to manage customer sessions without leaving browser or portals."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Superpower 2: File Triage -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TxtFeature2Title" Text="Smart Auto-File Triage" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="TxtFeature2Desc"
                                           Text="Detects incoming Bluetooth and WhatsApp files and moves them directly into active customer folders."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Superpower 3: Billing & Receipts -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE717;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TxtFeature3Title" Text="Clean Invoices &amp; WhatsApp Sharing" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="TxtFeature3Desc"
                                           Text="Generate professional receipts, A4 invoices, and share via WhatsApp in 1 click."
                                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Divider above Footer -->
        <Border Grid.Row="3" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Top" Margin="0,-4,0,0" />

        <!-- Footer Actions Bar (Pinned at bottom, never clipped) -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,12,0,0">
            <!-- Left: Skip For Now -->
            <Button x:Name="BtnSkip" Grid.Column="0"
                    Content="Skip for now"
                    Style="{ThemeResource SubtleButtonStyle}"
                    FontSize="12"
                    Click="BtnSkip_Click" />

            <!-- Right: Back and Next / Finish -->
            <Button x:Name="BtnBack" Grid.Column="2"
                    Content="Back"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Visibility="Collapsed"
                    MinWidth="80"
                    Click="BtnBack_Click" />

            <Button x:Name="BtnNext" Grid.Column="3"
                    Content="Next"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="100"
                    Click="BtnNext_Click" />
        </Grid>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.UpiQrDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UPI Payment QR"
    PrimaryButtonText="Mark Paid"
    CloseButtonText="Close"
    DefaultButton="Primary"
    mc:Ignorable="d" CornerRadius="12">

    <StackPanel Spacing="14" HorizontalAlignment="Center" Width="320">
        <!-- Amount & Payee Header -->
        <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="12,10">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TxtAmount" Text="₹0" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TxtPayee" Text="SevaDesk Cyber Center" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                <TextBlock x:Name="TxtCustomer" Text="For: Walk-in Customer" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Scannable High-Contrast QR Code Image -->
        <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid Width="220" Height="220">
                <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="QrImage" Width="220" Height="220" Stretch="Uniform" />
            </Grid>
        </Border>

        <!-- VPA & Copy Button -->
        <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="UPI VPA (ID):" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtVpa" Text="" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Click="CopyVpa_Click" Padding="6,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        <TextBlock Text="Copy" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TextBlock Text="Scan using Google Pay, PhonePe, Paytm, BHIM, or any UPI App"
                   FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>

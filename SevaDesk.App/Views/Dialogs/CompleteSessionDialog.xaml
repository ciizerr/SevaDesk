<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.CompleteSessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Finish Visit"
    PrimaryButtonText="Finish"
    SecondaryButtonText="Skip"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d" CornerRadius="12">

    <StackPanel Spacing="12" Margin="0,0,16,0" MinWidth="380" MaxWidth="460">
        <TextBlock x:Name="TxtPromptSubtitle"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Spacing="4">
            <TextBox x:Name="TxtMobile"
                     Header="Mobile Number"
                     PlaceholderText="10-digit number"
                     MaxLength="10" />
            <TextBlock x:Name="TxtMobileError"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       FontSize="11"
                       Margin="2,0,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
            <TextBox x:Name="TxtIdRef"
                     Grid.Column="0"
                     Header="ID Ref / Aadhaar"
                     Margin="0,0,8,0"
                     PlaceholderText="e.g. 5678"
                     InputScope="Number" />

            <TextBox x:Name="TxtVillage"
                     Grid.Column="1"
                     Header="Village / City"
                     Margin="8,0,0,0"
                     PlaceholderText="e.g. Rampur" />
        </Grid>

        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Saving mobile number allows 1-click lookup on their next visit."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>

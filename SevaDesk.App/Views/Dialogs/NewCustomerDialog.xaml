<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.NewCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    Title="Start Session"
    PrimaryButtonText="Start"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Margin="0,0,16,0" MinWidth="380" MaxWidth="460">
        <!-- Customer Name AutoSuggestBox with real-time DB lookup -->
        <AutoSuggestBox
            x:Name="NameSuggestBox"
            PlaceholderText="Type customer name..."
            TextChanged="NameSuggestBox_TextChanged"
            SuggestionChosen="NameSuggestBox_SuggestionChosen"
            QuerySubmitted="NameSuggestBox_QuerySubmitted"
            TextMemberPath="Name">
            <AutoSuggestBox.Header>
                <TextBlock FontSize="12">
                    <Run Text="Customer Name" />
                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                </TextBlock>
            </AutoSuggestBox.Header>
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="models:Customer">
                    <StackPanel Padding="4,2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <!-- Status badge showing if an existing customer was matched -->
        <Border x:Name="ExistingCustomerBadge"
                Visibility="Collapsed"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtBadgeInfo"
                           Text="Existing profile found — visit will be linked."
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*">
            <TextBox
                x:Name="MobileBox"
                Grid.Column="0"
                Header="Mobile Number"
                Margin="0,0,8,0"
                PlaceholderText="10-digit number" />

            <TextBox
                x:Name="VillageBox"
                Grid.Column="1"
                Header="Village / City"
                Margin="8,0,0,0"
                PlaceholderText="e.g. Rampur" />
        </Grid>

        <TextBox
            x:Name="IdRefBox"
            Header="ID Ref / Aadhaar"
            PlaceholderText="e.g. Last 4 digits: 1234" />

        <TextBox
            x:Name="NotesBox"
            Header="Session Notes"
            PlaceholderText="e.g. Photo scan, PAN application" />
    </StackPanel>
</ContentDialog>

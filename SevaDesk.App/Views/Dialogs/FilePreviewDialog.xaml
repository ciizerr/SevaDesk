<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.FilePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    loc:Loc.Key="PreviewDialog.Title"
    Title="File Quick Preview"
    loc:Loc.PrimaryButtonKey="PreviewDialog.OpenDefault"
    PrimaryButtonText="Open in Default App"
    loc:Loc.SecondaryButtonKey="PreviewDialog.OpenFolder"
    SecondaryButtonText="Open Folder in Explorer"
    loc:Loc.CloseButtonKey="Common.Close"
    CloseButtonText="Close"
    DefaultButton="Close"
    mc:Ignorable="d">

    <Grid MinWidth="520" MaxWidth="680" MinHeight="380" MaxHeight="540" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <!-- File Info Header Bar -->
        <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon x:Name="FileGlyphIcon" Grid.Column="0" Glyph="&#xE8A5;" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtFileName" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TxtFileSize" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TxtFileModified" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" x:Name="FormatBadge" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFormat" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Preview Body Container -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <Grid>
                <!-- Loading Ring -->
                <ProgressRing x:Name="PreviewProgress" IsActive="True" Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Image / PDF Preview Viewport with Zoom -->
                <ScrollViewer x:Name="ImageScrollViewer"
                              ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4.0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>

                <!-- Non-visual document / generic fallback -->
                <StackPanel x:Name="GenericDocFallback" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon x:Name="FallbackGlyph" Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtFallbackTitle" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Visual preview not available for this file type. Click 'Open in Default App' below."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full File Path footer -->
        <TextBlock Grid.Row="2" x:Name="TxtFullPath" FontSize="11" FontFamily="Consolas"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SevaDesk_App.Views.Dialogs.LinkApplicationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    Title="Link Scheme / Form"
    PrimaryButtonText="Link"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Margin="0,0,16,0" MinWidth="400" MaxWidth="480">
        <!-- Customer Target Banner -->
        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtCustomerBanner"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Real-Time Catalog AutoSuggest Search -->
        <AutoSuggestBox
            x:Name="SearchSuggestBox"
            PlaceholderText="Search scheme (e.g. SSC, PAN, Kisan)..."
            TextChanged="SearchSuggestBox_TextChanged"
            SuggestionChosen="SearchSuggestBox_SuggestionChosen"
            QuerySubmitted="SearchSuggestBox_QuerySubmitted"
            TextMemberPath="Title">
            <AutoSuggestBox.Header>
                <TextBlock FontSize="12">
                    <Run Text="Scheme / Form Name" />
                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold" />
                </TextBlock>
            </AutoSuggestBox.Header>
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="models:ApplicationTemplate">
                    <Grid ColumnDefinitions="*,Auto" Padding="4,4">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind PortalUrl}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <!-- Matched Template Preview Card -->
        <Border x:Name="MatchedTemplateCard"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="TxtMatchedTitle" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="TxtMatchedPortal" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                        <TextBlock x:Name="TxtMatchedFees" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </Border>
                </Grid>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Required Documents:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="TxtMatchedDocs" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Not-Found Quick Link Banner -->
        <Border x:Name="NotFoundCard"
                Visibility="Collapsed"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtNotFoundPrompt" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="You can quick-link now and set fees later in Application Manager."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="QuickAddFallback_Click" Margin="8,0,0,0">
                    <TextBlock Text="Quick Link" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Registration / Ack Number -->
        <TextBox x:Name="TxtAppNumber"
                 Header="Application / Ack No"
                 PlaceholderText="e.g. REG-2026-001" />

        <!-- Notes -->
        <TextBox x:Name="TxtNotes"
                 Header="Notes"
                 PlaceholderText="Remarks or instructions" />
    </StackPanel>
</ContentDialog>

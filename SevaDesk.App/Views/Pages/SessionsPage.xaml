<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:controls="using:SevaDesk_App.Views.Controls"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- 1. Page Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock loc:Loc.Key="Sessions.Title" Text="Counter Sessions" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            <TextBlock loc:Loc.Key="Sessions.ActiveBadge" Text="Active" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.PausedCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            <TextBlock loc:Loc.Key="Sessions.PausedBadge" Text="Paused" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock loc:Loc.Key="Sessions.Subtitle"
                           Text="Manage multiple customers at the desk with isolated working folders"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Sessions.RefreshBtn" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewSession_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Sessions.StartNewBtn" Text="Start New Session" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main 2-Column Split: Sessions Sidebar on Left (360px), Operational Console on Right -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16">
            <!-- Left: Sessions Sidebar -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock loc:Loc.Key="Sessions.OngoingVisits" Text="Ongoing Visits" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Sessions.Count, Mode=OneWay}" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActiveSessionItem">
                                <Grid RowDefinitions="Auto,Auto,Auto" Padding="10,10" RowSpacing="6">
                                    <!-- Row 0: Avatar + Name + Code + Live Timer Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <PersonPicture Grid.Column="0" Width="38" Height="38"
                                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(Customer.PhotoPath), Mode=OneWay}"
                                                       Initials="{x:Bind Customer.Initials}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="Bold" FontSize="14" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="4" Padding="5,1" HorizontalAlignment="Left"
                                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Live Timer Badge (color-coded) -->
                                        <Border Grid.Column="2" CornerRadius="6" Padding="6,3" VerticalAlignment="Center"
                                                Background="{x:Bind local:SessionsPage.SessionBadgeBackground(Status), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind local:SessionsPage.SessionBadgeGlyph(Status), Mode=OneWay}" FontSize="10"
                                                          Foreground="{x:Bind local:SessionsPage.SessionBadgeForeground(Status), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ElapsedDisplay, Mode=OneWay}"
                                                           FontWeight="Bold" FontSize="11" FontFamily="Consolas"
                                                           Foreground="{x:Bind local:SessionsPage.SessionBadgeForeground(Status), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Row 1: Contact Summary -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind CustomerContactSummary}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />

                                    <!-- Row 2: Linked Application Chip + File Count Pill -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                Background="{x:Bind local:SessionsPage.AppStatusBackground(LinkedApplicationStatus), Mode=OneWay}"
                                                Visibility="{x:Bind local:SessionsPage.VisibleIf(HasLinkedApplication), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind LinkedApplicationTitle, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:SessionsPage.AppStatusForeground(LinkedApplicationStatus), Mode=OneWay}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind local:SessionsPage.CollapsedIf(HasLinkedApplication), Mode=OneWay}">
                                            <TextBlock Text="No application" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FolderStats.TotalFiles}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="files" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Active Session Desk Console -->
            <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" SizeChanged="WorkspaceScrollViewer_SizeChanged">
                <Grid>
                    <!-- Empty State when no session is selected -->
                    <Border Visibility="{x:Bind local:SessionsPage.CollapsedIf(ViewModel.HasSelectedSession), Mode=OneWay}"
                            Padding="32" CornerRadius="8" Margin="0,40,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="No Customer Session Selected" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Select an ongoing session from the left or click 'Start New Session' to serve a visitor."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="NewSession_Click" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Sessions.StartNewBtn" Text="Start New Session" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Active Console when session selected -->
                    <StackPanel Spacing="12" Visibility="{x:Bind local:SessionsPage.VisibleIf(ViewModel.HasSelectedSession), Mode=OneWay}">
                        <!-- In-App Triage InfoBar for Incoming Files -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasPendingIncomingFile, Mode=OneWay}"
                                 IsClosable="True"
                                 CloseButtonClick="TriageClose_Click"
                                 Severity="Informational"
                                 Title="Incoming File Detected"
                                 Message="{x:Bind ViewModel.PendingIncomingFile.FileName, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="RoutePendingFile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <TextBlock loc:Loc.Key="Triage.MoveToCustomerBtn" Text="Move to Customer" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!-- 1. High-Efficiency Top Action Bar -->
                        <Border Padding="16,12" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                <!-- Left: Avatar + Customer Details + Status -->
                                <PersonPicture Grid.Column="0" Width="46" Height="46"
                                               ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(ViewModel.SelectedSession.Customer.PhotoPath), Mode=OneWay}"
                                               Initials="{x:Bind ViewModel.SelectedSession.Customer.Initials, Mode=OneWay}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Name, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="16" />
                                        <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Code, Mode=OneWay}"
                                                       FontFamily="Consolas" FontSize="11" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                Background="{x:Bind local:SessionsPage.SessionBadgeBackground(ViewModel.SelectedSession.Status), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Status, Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:SessionsPage.SessionBadgeForeground(ViewModel.SelectedSession.Status), Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.CustomerContactSummary, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderPath, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Center/Right Action Hub -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Live Timer Pill -->
                                    <Border CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                                            Background="{x:Bind local:SessionsPage.SessionBadgeBackground(ViewModel.SelectedSession.Status), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE916;" FontSize="13"
                                                      Foreground="{x:Bind local:SessionsPage.SessionBadgeForeground(ViewModel.SelectedSession.Status), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ElapsedDisplay, Mode=OneWay}"
                                                       FontWeight="Bold" FontSize="13" FontFamily="Consolas"
                                                       Foreground="{x:Bind local:SessionsPage.SessionBadgeForeground(ViewModel.SelectedSession.Status), Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Folder Button -->
                                    <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open customer's working folder in File Explorer" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                                            <TextBlock Text="Folder" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Pause / Resume -->
                                    <Button Click="ToggleStatus_Click"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSession.ToggleActionText, Mode=OneWay}" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind ViewModel.SelectedSession.ToggleActionGlyph, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ToggleActionText, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Finish & Bill (Accent) -->
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="CompleteSession_Click" Padding="12,6"
                                            ToolTipService.ToolTip="Complete visit &amp; open cashier">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C7;" FontSize="13" />
                                            <TextBlock loc:Loc.Key="Sessions.FinishBillBtn" Text="Finish &amp; Bill" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- More Options Flyout -->
                                    <Button Width="32" Height="32" Padding="0" CornerRadius="4">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Customer Workspace" Click="OpenCustomerWorkspace_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A7;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Name="MfiToggleLayout" Text="Switch to Stacked View" Click="ToggleLayoutMode_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon x:Name="IconToggleLayout" Glyph="&#xE746;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Name="MfiResetAutoLayout" Text="Reset to Auto-Adjust" Click="ResetAutoLayout_Click" Visibility="Collapsed">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE777;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete Session" Click="DeleteSession_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Prompt Strip when NO application is linked -->
                        <Border Padding="14,10" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{x:Bind local:SessionsPage.CollapsedIf(ViewModel.HasActiveApplication), Mode=OneWay}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock loc:Loc.Key="Sessions.NoApplicationLinked" Text="No application linked to this visit" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Sessions.NoApplicationLinkedDesc" Text="Link or register a government scheme, exam form, or certificate request for this customer."
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="LinkApplication_Click" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock loc:Loc.Key="Sessions.LinkApplicationBtn" Text="Link Application" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. Adaptive Operational Workspace Grid -->
                        <Grid x:Name="WorkspaceGrid" ColumnDefinitions="380,*" ColumnSpacing="14">
                            <!-- Left / Top Pane: Application & Verification (Visible ONLY when an application is active) -->
                            <Border x:Name="AppCardBorder" Grid.Column="0" CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{x:Bind local:SessionsPage.VisibleIf(ViewModel.HasActiveApplication), Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <!-- Top Row: Title, Portal, Status, Fee breakdown, and Collapse Toggle -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveApplication.Title, Mode=OneWay}"
                                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="15"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.ActiveApplication.PortalName, Mode=OneWay}"
                                                           FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Border CornerRadius="4" Padding="4,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                    <TextBlock Text="{x:Bind ViewModel.ActiveApplication.ApplicationNumber, Mode=OneWay}"
                                                               FontFamily="Consolas" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Summary Chip (shown ONLY when collapsed) -->
                                        <Border Grid.Column="1" x:Name="AppCardSummaryChip" Visibility="Collapsed"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="{x:Bind local:SessionsPage.ChecklistSummary(ViewModel.ActiveChecklist), Mode=OneWay}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ActiveApplication.FormattedTotal, Mode=OneWay}"
                                                           FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Status DropDown & Collapse Button -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <DropDownButton VerticalAlignment="Center" Padding="8,4" CornerRadius="6"
                                                            Background="{x:Bind local:SessionsPage.AppStatusBackground(ViewModel.ActiveApplication.Status), Mode=OneWay}"
                                                            BorderBrush="{x:Bind local:SessionsPage.AppStatusBorder(ViewModel.ActiveApplication.Status), Mode=OneWay}"
                                                            BorderThickness="1">
                                                <DropDownButton.Content>
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind local:SessionsPage.AppStatusGlyph(ViewModel.ActiveApplication.Status), Mode=OneWay}"
                                                                  FontSize="11"
                                                                  Foreground="{x:Bind local:SessionsPage.AppStatusForeground(ViewModel.ActiveApplication.Status), Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind local:SessionsPage.AppStatusDisplay(ViewModel.ActiveApplication.Status), Mode=OneWay}"
                                                                   FontWeight="SemiBold" FontSize="11"
                                                                   Foreground="{x:Bind local:SessionsPage.AppStatusForeground(ViewModel.ActiveApplication.Status), Mode=OneWay}" />
                                                    </StackPanel>
                                                </DropDownButton.Content>
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="Draft" Click="StatusDraft_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A5;" Foreground="#F59E0B" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Docs Ready" Click="StatusDocsReady_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE73E;" Foreground="#3B82F6" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Completed" Click="StatusCompleted_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE930;" Foreground="#10B981" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>

                                            <!-- Collapse / Expand Toggle Button -->
                                            <Button x:Name="BtnToggleSchemeCard" Click="ToggleSchemeCard_Click"
                                                    Background="Transparent" BorderBrush="Transparent" Padding="6,4"
                                                    ToolTipService.ToolTip="Collapse scheme details">
                                                <FontIcon x:Name="IconToggleSchemeCard" Glyph="&#xE70D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Adaptive Body Grid: Single column when side-by-side, 2-column split when stacked! -->
                                    <Grid x:Name="AppCardBodyGrid">
                                        <!-- Sub-pane 1: Switcher, Fees, Action Buttons -->
                                        <StackPanel x:Name="AppDetailsSubpane" Spacing="12">
                                            <!-- Multi-Application Switcher Chips (when customer has 2+ apps) -->
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          Visibility="{x:Bind local:SessionsPage.VisibleIf(ViewModel.HasMultipleApplications), Mode=OneWay}">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CustomerApplications, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ApplicationItem">
                                                            <Button Padding="6,3" Click="AppChip_Click" Tag="{x:Bind}">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <FontIcon Glyph="&#xE7C3;" FontSize="10" />
                                                                    <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="SemiBold" />
                                                                    <Border CornerRadius="3" Padding="4,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                                        <TextBlock Text="{x:Bind Status}" FontSize="9" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Fee Breakdown Row -->
                                            <Border CornerRadius="6" Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid ColumnDefinitions="*,*,*">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock loc:Loc.Key="Sessions.ServiceFeeLabel" Text="Service Fee" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.ActiveApplication.FormattedServiceCharge, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock loc:Loc.Key="Sessions.GovtFeeLabel" Text="Govt Fee" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.ActiveApplication.FormattedGovtFee, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock loc:Loc.Key="Sessions.TotalFeeLabel" Text="Total" FontSize="10" FontWeight="Bold" />
                                                        <TextBlock Text="{x:Bind ViewModel.ActiveApplication.FormattedTotal, Mode=OneWay}"
                                                                   FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Action Buttons: Add More, Open Portal, Remove -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Click="LinkApplication_Click" ToolTipService.ToolTip="Link another application" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                        <TextBlock Text="Add" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="LaunchPortal_Click" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                        <TextBlock loc:Loc.Key="Sessions.PortalBtn" Text="Portal" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="RemoveApplication_Click" ToolTipService.ToolTip="Remove this linked application"
                                                        Background="Transparent" BorderBrush="Transparent" Padding="6,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                                                        <TextBlock Text="Remove" FontSize="11" Foreground="#EF4444" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Sub-pane 2: Interactive Document Checklist -->
                                        <Border x:Name="AppChecklistSubpane" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,*">
                                                <Border Grid.Row="0" Padding="10,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock loc:Loc.Key="Sessions.ChecklistTitle" Text="Document Checklist" FontWeight="SemiBold" FontSize="11" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Padding="4"
                                                                Click="LinkApplication_Click" ToolTipService.ToolTip="Edit Application &amp; Docs">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActiveChecklist, Mode=OneWay}" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ApplicationChecklistItem">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,5" VerticalAlignment="Center"
                                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                                                          Checked="ChecklistItem_Checked" Unchecked="ChecklistItem_Unchecked" Margin="0,0,6,0" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="11" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                                Visibility="{x:Bind local:SessionsPage.VisibleIf(HasMatchedFile), Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                                        <TextBlock Text="{x:Bind MatchedFileName, Mode=OneWay}" FontSize="9"
                                                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="5,1"
                                                                        Background="{x:Bind local:SessionsPage.ChecklistBadgeBackground(HasMatchedFile), Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind local:SessionsPage.ChecklistBadgeText(HasMatchedFile, Category), Mode=OneWay}"
                                                                               FontSize="9"
                                                                               Foreground="{x:Bind local:SessionsPage.ChecklistBadgeForeground(HasMatchedFile), Mode=OneWay}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right / Bottom Pane: Working Folder Browser -->
                            <controls:WorkingFolderBrowserControl x:Name="WorkingFolderBrowser" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

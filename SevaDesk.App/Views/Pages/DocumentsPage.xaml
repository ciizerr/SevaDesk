<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:controls="using:SevaDesk_App.Views.Controls"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock loc:Loc.Key="Documents.Title" Text="Document Processing Hub" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <Border Background="#F59E0B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.UnorganisedCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            <TextBlock loc:Loc.Key="Documents.PendingBadge" Text="Pending" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock loc:Loc.Key="Documents.Subtitle"
                           Text="Process incoming Bluetooth &amp; WhatsApp files, apply photo/signature compression presets, and sort with 1-click"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Documents.ScanRefreshBtn" Text="Scan &amp; Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="OpenExplorer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Documents.OpenWorkingRootBtn" Text="Open Working Directory" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <!-- NavigationView for Tabs -->
        <NavigationView x:Name="DocNav" Grid.Row="2" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" SelectionChanged="DocNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Organization" Tag="Org">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Document Studio" Tag="Studio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="0,16,0,0">
                <!-- Organization View -->
                <Grid x:Name="OrgView" ColumnDefinitions="420,*" ColumnSpacing="16">
                    <!-- Left: Incoming Unorganised Queue & Compression Presets -->
                    <Grid RowDefinitions="*,Auto" RowSpacing="12">
                <!-- Pending Queue Card -->
                <Border Grid.Row="0" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" FontSize="14" />
                                <TextBlock loc:Loc.Key="Documents.IncomingQueueTitle" Text="Unorganised Files (Pending)" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PendingDocuments, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" VerticalAlignment="Center">
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind CustomerName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind FileSize}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="6,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Extension}" FontSize="10" FontFamily="Consolas" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Compression Presets Card -->
                <Border Grid.Row="1" Padding="14" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                            <TextBlock loc:Loc.Key="Documents.CompressionPresetsTitle" Text="1-Click Compression Presets" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.CompressionPresets, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CompressionPreset">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Margin="0,0,0,6" Click="PresetButton_Click" Tag="{x:Bind}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
                                            <Border Grid.Column="2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind TargetSize}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: Document Inspector & Sort Actions -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Empty State when no document selected -->
                    <Border Visibility="{x:Bind local:DocumentsPage.CollapsedIf(ViewModel.HasSelectedDocument), Mode=OneWay}"
                            Padding="28" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="No Unorganized File Selected" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a file from the incoming queue to view, apply compression, or move to customer folders."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Selected Document Card & Sort Actions -->
                    <Border Visibility="{x:Bind local:DocumentsPage.VisibleIf(ViewModel.HasSelectedDocument), Mode=OneWay}"
                            Padding="20" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,16,0">
                                    <FontIcon Glyph="{x:Bind ViewModel.SelectedDocument.Glyph, Mode=OneWay}" FontSize="24"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDocument.Name, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="16" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDocument.CustomerName, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDocument.FileSize, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDocument.Status, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Click="OpenFile_Click" ToolTipService.ToolTip="Open file in default viewer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                        <TextBlock Text="Open" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Dynamic Subfolder Move Destination Buttons & New Subfolder Action -->
                            <StackPanel Grid.Row="2" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8DE;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock loc:Loc.Key="Documents.InspectorTitle" Text="Quick Sort &amp; Move to Customer Subfolder:" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>

                                    <!-- Quick New Subfolder Button -->
                                    <Button Grid.Column="1" Click="NewSubfolder_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="New Subfolder" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Dynamic Customer Subfolders List -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CustomerSubfolders, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SubfolderItem">
                                                <Button Click="MoveToSubfolder_Click" Tag="{x:Bind RelativePath}"
                                                        Padding="12,8" MinWidth="130" CornerRadius="6"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="{x:Bind RelativePath}" />
                                                    </ToolTipService.ToolTip>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" Foreground="{x:Bind AccentColor}" FontSize="15" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind FileCount}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Processed Files Archive List -->
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <TextBlock loc:Loc.Key="Documents.AssignToCustomer" Text="Organized &amp; Processed Files" FontWeight="SemiBold" />
                            </Border>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ProcessedDocuments, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DocumentItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" VerticalAlignment="Center"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="18"
                                                      Foreground="#10B981" Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind CustomerName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind Category}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="6,2"
                                                    Background="#ECFDF5">
                                                <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="#047857" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Document Studio View -->
            <controls:DocumentStudioControl x:Name="StudioView" Visibility="Collapsed" />
        </Grid>
    </NavigationView>
    </Grid>
</Page>

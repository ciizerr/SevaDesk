<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.PaymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24">

            <!-- Top Header & Navigation Bar -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock loc:Loc.Key="Payments.Title" Text="Cashier &amp; Billing POS" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock loc:Loc.Key="Payments.Subtitle"
                               Text="1-click rate charging, dynamic UPI billing, and comprehensive earnings reporting"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Daily Sales Badges (Visible on POS View) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsPosView), Mode=OneWay}">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.UpiSales" Text="UPI Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayUpiTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" Foreground="#10B981" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.CashSales" Text="Cash Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayCashTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.TodayTotal" Text="Today's Total" FontSize="10" Foreground="#E0E7FF" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayTotalSales, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation SelectorBar (Tab Switcher) -->
                <SelectorBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
                    <SelectorBarItem Text="Point of Sale (POS)" x:Name="PosTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE7BF;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Earnings &amp; Reports" x:Name="EarningsTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </Grid>


            <!-- ======================================================== -->
            <!-- TAB 1: POINT OF SALE (POS) VIEW                         -->
            <!-- ======================================================== -->
            <Grid Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsPosView), Mode=OneWay}"
                  ColumnDefinitions="*,440" ColumnSpacing="20">

                <!-- Left Column: Rate Card & Today's Ledger -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Quick Charge Rate Card Panel -->
                    <Border CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <!-- Rate Card Header & Edit Controls -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Key="Payments.RateCardTitle" Text="Service Rate Card" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Text="Click any card to add directly to current bill" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                   Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.IsEditMode), Mode=OneWay}" />
                                        <TextBlock Text="Editing service prices and units — click Save when finished" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                                   Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEditMode), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch OffContent="Edit Rates" OnContent="Editing" 
                                                  IsOn="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}" Margin="0" />
                                    
                                    <Button Content="+ Add Service" Command="{x:Bind ViewModel.AddNewServiceCommand}" 
                                            Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEditMode), Mode=OneWay}" />
                                    
                                    <Button Content="Save Changes" Command="{x:Bind ViewModel.SaveRatesCommand}" 
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEditMode), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Rate Cards Grid -->
                            <GridView ItemsSource="{x:Bind ViewModel.RateCard, Mode=OneWay}" SelectionMode="None"
                                      IsItemClickEnabled="{x:Bind local:PaymentsPage.CollapsedIfBool(ViewModel.IsEditMode), Mode=OneWay}"
                                      ItemClick="RateCard_ItemClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServiceRateItem">
                                        <Border Width="205" Height="115" Padding="14" CornerRadius="10"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <!-- Category & Icon -->
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                               Visibility="{x:Bind local:PaymentsPage.CollapsedIf(IsEditMode), Mode=OneWay}" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Category, Mode=TwoWay}" FontSize="10" Padding="4,1" MinHeight="22"
                                                             Visibility="{x:Bind local:PaymentsPage.VisibleIf(IsEditMode), Mode=OneWay}" />
                                                </Grid>

                                                <!-- Readonly Service Name -->
                                                <TextBlock Grid.Row="1" Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" Margin="0,4,0,0"
                                                           Visibility="{x:Bind local:PaymentsPage.CollapsedIf(IsEditMode), Mode=OneWay}" />
                                                <!-- Edit Service Name -->
                                                <TextBox Grid.Row="1" Text="{x:Bind ServiceName, Mode=TwoWay}" FontSize="12" Padding="4,2"
                                                         VerticalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                                         Visibility="{x:Bind local:PaymentsPage.VisibleIf(IsEditMode), Mode=OneWay}" />

                                                <!-- Readonly Rate -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom"
                                                            Visibility="{x:Bind local:PaymentsPage.CollapsedIf(IsEditMode), Mode=OneWay}">
                                                    <TextBlock Text="₹" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Rate}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="/" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{x:Bind Unit}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <!-- Edit Rate with NumberBox -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom"
                                                            Visibility="{x:Bind local:PaymentsPage.VisibleIf(IsEditMode), Mode=OneWay}">
                                                    <TextBlock Text="₹" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <NumberBox Value="{x:Bind RateDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                               Minimum="0" SmallChange="5" LargeChange="50" Width="90" />
                                                    <TextBlock Text="/" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBox Text="{x:Bind Unit, Mode=TwoWay}" FontSize="11" Padding="4,2" Width="55" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- Collapsible: Today's Payment Ledger (Expander) -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="{x:Bind ViewModel.IsTodayLedgerExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Payments.BillCartTitle" Text="Today's Payment Counter Ledger" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.TodayLedgerHeaderSummary, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>
                            <StackPanel Spacing="8" Margin="-16,0">
                                <!-- Empty state when no transactions today -->
                                <Border Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.TodayTransactionCount), Mode=OneWay}"
                                        Padding="20" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="No payments recorded today yet." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </Border>

                                <!-- Today's Transactions ListView -->
                                <ListView ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}" SelectionMode="None" MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransactionItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="14,10" VerticalAlignment="Center"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                            <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" Spacing="2">
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{x:Bind PaymentMode}" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"
                                                           Text="{x:Bind FormattedAmount}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </StackPanel>


                <!-- Right Column: Current Bill & Dynamic UPI Terminal -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <!-- Bill Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock loc:Loc.Key="Payments.BillCartTitle" Text="Current Bill" FontWeight="Bold" FontSize="16" />
                                    <TextBox Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Customer name / walk-in..." Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" Click="ClearBill_Click" ToolTipService.ToolTip="Clear current bill">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Empty Cart Placeholder -->
                            <Border Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.HasCartItems), Mode=OneWay}"
                                    Padding="18" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE719;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bill is empty" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click any item on the Service Rate Card to begin charging."
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Cart Items List -->
                            <ListView Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.HasCartItems), Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,6" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Rate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Qty Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                                <Button Padding="6,2" Click="DecreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="-" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                                <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Width="22" TextAlignment="Center" />
                                                <Button Padding="6,2" Click="IncreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="+" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="8,0"
                                                       Text="{x:Bind FormattedTotal, Mode=OneWay}" />

                                            <Button Grid.Column="3" Padding="4" Background="Transparent" BorderThickness="0"
                                                    Click="RemoveItem_Click" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Divider -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Grand Total Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total Payable:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FormattedGrandTotal, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Collapsible: Scan & Pay via Dynamic UPI (Expander) -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="{x:Bind ViewModel.IsScanAndPayExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Scan &amp; Pay via UPI" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ShopUpiId, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>

                                <Expander.Content>
                                    <Border CornerRadius="8" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="-16,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" Width="84" Height="84" CornerRadius="6" Background="White" Padding="4">
                                                <Grid>
                                                    <FontIcon Glyph="&#xED14;" FontSize="70" Foreground="#0F172A"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.PayeeName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.ShopUpiId, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Button Padding="4,2" Click="CopyUpi_Click" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Copy UPI ID">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="GPay • PhonePe • Paytm • BHIM • Cred" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Auto-encodes current bill amount in UPI QR" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontStyle="Italic" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander.Content>
                            </Expander>

                            <!-- Payment Settlement Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="PayCash_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="#10B981" />
                                        <TextBlock loc:Loc.Key="Payments.MarkCashPaidBtn" Text="Mark Paid (Cash)" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="PayUpi_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                                        <TextBlock loc:Loc.Key="Payments.GenerateQrBtn" Text="Mark Paid (UPI)" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>


            <!-- ======================================================== -->
            <!-- TAB 2: EARNINGS & REPORTS VIEW                           -->
            <!-- ======================================================== -->
            <StackPanel Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEarningsView), Mode=OneWay}"
                        Spacing="16">

                <!-- 1. Filter Control Bar -->
                <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <!-- Quick Filter Pills -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Content="Today" Tag="Today" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Today'), Mode=OneWay}" />
                                <Button Content="This Week" Tag="This Week" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'This Week'), Mode=OneWay}" />
                                <Button Content="This Month" Tag="This Month" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'This Month'), Mode=OneWay}" />
                                <Button Content="Last Month" Tag="Last Month" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Last Month'), Mode=OneWay}" />
                                <Button Content="By Year" Tag="By Year" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'By Year'), Mode=OneWay}" />
                                <Button Content="Custom Range" Tag="Custom Range" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Custom Range'), Mode=OneWay}" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadEarningsCommand}" ToolTipService.ToolTip="Refresh Earnings">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Refresh" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Secondary Filters Row -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- Year Selector (visible when By Year is chosen) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsYearFilterVisible), Mode=OneWay}">
                                <TextBlock Text="Year:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableYears, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}" MinWidth="90" />
                                
                                <TextBlock Text="Month:" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.MonthOptions, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedMonthIndex, Mode=TwoWay}" MinWidth="120" />
                            </StackPanel>

                            <!-- Custom Date Range Picker (visible when Custom Range is chosen) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsCustomRangeVisible), Mode=OneWay}">
                                <TextBlock Text="From:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.CustomFromDate, Mode=TwoWay}" Width="140" />
                                <TextBlock Text="To:" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.CustomToDate, Mode=TwoWay}" Width="140" />
                            </StackPanel>

                            <!-- Payment Mode Filter -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Mode:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.PaymentModeFilters, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPaymentMode, Mode=TwoWay}" MinWidth="85" />
                            </StackPanel>

                            <!-- Search Filter Box -->
                            <TextBox Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Filter customer, invoice..." Width="220">
                                <TextBox.Header>
                                    <TextBlock Text="" />
                                </TextBox.Header>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Summary Metric Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <!-- Total Net Sales -->
                    <Border Grid.Column="0" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Total Earnings" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredTotal, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FilterPeriodDescription, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cash Counter Sales -->
                    <Border Grid.Column="1" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#10B981">
                                <FontIcon Glyph="&#xE717;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Cash Counter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredCash, Mode=OneWay}" FontWeight="Bold" FontSize="22" />
                                <TextBlock Text="Physical cash in hand" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Digital UPI Sales -->
                    <Border Grid.Column="2" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#3B82F6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="UPI &amp; Digital" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredUpi, Mode=OneWay}" FontWeight="Bold" FontSize="22" />
                                <TextBlock Text="Direct bank settlements" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Win2D Bar Chart: Earnings Distribution -->
                <Border CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9F9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Earnings Distribution &amp; Trend" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <!-- Legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#3B82F6" />
                                    <TextBlock Text="UPI Sales" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#10B981" />
                                    <TextBlock Text="Cash Sales" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="8,12">
                            <canvas:CanvasControl x:Name="EarningsCanvas" Height="200" Draw="EarningsCanvas_Draw" ClearColor="Transparent" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Filtered Transactions Ledger -->
                <Border CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="18,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="15" />
                                    <TextBlock Text="Transaction History Ledger" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.FormattedFilteredCount, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTransactions, Mode=OneWay}" SelectionMode="None" MaxHeight="380">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,12" VerticalAlignment="Center"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,14,0">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                    <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" Spacing="2">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind PaymentMode}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"
                                                   Text="{x:Bind FormattedAmount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.PaymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24">

            <!-- Top Header & Navigation Bar -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock loc:Loc.Key="Payments.Title" Text="Cashier &amp; Billing POS" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock loc:Loc.Key="Payments.Subtitle"
                               Text="1-click rate charging, dynamic UPI billing, and comprehensive earnings reporting"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Daily Sales Badges (Visible on POS View) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsPosView), Mode=OneWay}">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.UpiSales" Text="UPI Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayUpiTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" Foreground="#10B981" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.CashSales" Text="Cash Sales" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayCashTotal, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="14" />
                            <StackPanel Spacing="0">
                                <TextBlock loc:Loc.Key="Payments.TodayTotal" Text="Today's Total" FontSize="10" Foreground="#E0E7FF" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTodayTotalSales, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation SelectorBar (Tab Switcher) -->
                <SelectorBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
                    <SelectorBarItem Text="Point of Sale (POS)" x:Name="PosTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE7BF;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Service Rates &amp; Catalog" x:Name="RatesTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Text="Earnings &amp; Reports" x:Name="EarningsTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </Grid>


            <!-- ======================================================== -->
            <!-- TAB 1: POINT OF SALE (POS) VIEW                         -->
            <!-- ======================================================== -->
            <Grid Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsPosView), Mode=OneWay}"
                  ColumnDefinitions="*,440" ColumnSpacing="20">

                <!-- Left Column: Rate Card & Today's Ledger -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Quick Charge Rate Card Panel -->
                    <Border CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Rate Card Header: Title + Search + Manage Button -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Key="Payments.RateCardTitle" Text="Service Rate Card" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Text="Click any card to add directly to current bill"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live Service Search Box -->
                                <AutoSuggestBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                                                PlaceholderText="Search services..."
                                                QueryIcon="Find"
                                                Text="{x:Bind ViewModel.RateCardSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Manage Rates Switcher Button -->
                                <Button Grid.Column="2" VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.SwitchToRatesViewCommand}"
                                        AutomationProperties.Name="Manage Service Rates"
                                        AutomationProperties.AutomationId="BtnManageRates"
                                        ToolTipService.ToolTip="Open Service Rates &amp; Catalog workspace">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="Manage Services" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Category Filter Chips -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6" />
                            </ScrollViewer>

                            <!-- Rate Cards Grid (Vibrant Fluent POS Tiles) -->
                            <GridView ItemsSource="{x:Bind ViewModel.FilteredRateCard, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="RateCard_ItemClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServiceRateItem">
                                        <Border Width="205" Height="118" Padding="14" CornerRadius="10"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <!-- Category & Icon & Add Badge -->
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="10" Padding="6,2" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Click to add to bill">
                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                            <FontIcon Glyph="&#xE710;" FontSize="9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="Add" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Service Name -->
                                                <TextBlock Grid.Row="1" Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" Margin="0,4,0,0" />

                                                <!-- Price Hierarchy -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                                    <TextBlock Text="₹" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Rate}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="/" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                                    <TextBlock Text="{x:Bind Unit}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <!-- Empty Filter Search State -->
                            <Border Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.FilteredRateCard.Count), Mode=OneWay}"
                                    Padding="28,20" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No services found matching this filter" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <Button Content="Show All Services" Click="ClearCategoryFilter_Click" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Collapsible: Today's Payment Ledger (Expander) -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="{x:Bind ViewModel.IsTodayLedgerExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Payments.BillCartTitle" Text="Today's Payment Counter Ledger" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.TodayLedgerHeaderSummary, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>
                            <StackPanel Spacing="8" Margin="-16,0">
                                <!-- Empty state when no transactions today -->
                                <Border Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.TodayTransactionCount), Mode=OneWay}"
                                        Padding="20" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="No payments recorded today yet." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                </Border>

                                <!-- Today's Transactions ListView -->
                                <ListView ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}" SelectionMode="None" MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransactionItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="14,10" VerticalAlignment="Center"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                            <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" Spacing="2">
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{x:Bind PaymentMode}" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"
                                                           Text="{x:Bind FormattedAmount}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </StackPanel>


                <!-- Right Column: Current Bill & Dynamic UPI Terminal -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <!-- Bill Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <AutoSuggestBox x:Name="CustomerAutoSuggest"
                                                    Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Customer name / walk-in..."
                                                    TextChanged="CustomerAutoSuggest_TextChanged"
                                                    SuggestionChosen="CustomerAutoSuggest_SuggestionChosen"
                                                    QueryIcon="Contact" Margin="0,6,0,0">
                                        <AutoSuggestBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Customer">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind Code}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="·" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind Mobile}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </AutoSuggestBox.ItemTemplate>
                                    </AutoSuggestBox>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" Click="ClearBill_Click" ToolTipService.ToolTip="Clear current bill">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Empty Cart Placeholder -->
                            <Border Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.HasCartItems), Mode=OneWay}"
                                    Padding="18" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE719;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bill is empty" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click any item on the Service Rate Card to begin charging."
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Cart Items List -->
                            <ListView Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.HasCartItems), Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,6" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Rate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Qty Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                                <Button Padding="6,2" Click="DecreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="-" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                                <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Width="22" TextAlignment="Center" />
                                                <Button Padding="6,2" Click="IncreaseQty_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="+" FontWeight="Bold" FontSize="12" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="8,0"
                                                       Text="{x:Bind FormattedTotal, Mode=OneWay}" />

                                            <Button Grid.Column="3" Padding="4" Background="Transparent" BorderThickness="0"
                                                    Click="RemoveItem_Click" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Divider -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Grand Total Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total Payable:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FormattedGrandTotal, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Collapsible: Scan & Pay via Dynamic UPI (Expander) -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="{x:Bind ViewModel.IsScanAndPayExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Scan &amp; Pay via UPI" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ShopUpiId, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>

                                <Expander.Content>
                                    <Border CornerRadius="8" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="-16,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Button Grid.Column="0" Click="ShowQrDialog_Click" Background="White" CornerRadius="8" Padding="4"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    ToolTipService.ToolTip="Click to enlarge QR for customer">
                                                <Grid Width="96" Height="96">
                                                    <Image x:Name="InlineQrImage" Width="92" Height="92" Stretch="Uniform" />
                                                </Grid>
                                            </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.PayeeName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.ShopUpiId, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Button Padding="4,2" Click="CopyUpi_Click" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Copy UPI ID">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="GPay • PhonePe • Paytm • BHIM • Cred" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Auto-encodes current bill amount in UPI QR" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontStyle="Italic" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander.Content>
                            </Expander>

                            <!-- Payment Settlement Action Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="PayCash_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="#10B981" />
                                        <TextBlock loc:Loc.Key="Payments.MarkCashPaidBtn" Text="Mark Paid (Cash)" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="PayUpi_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                                        <TextBlock loc:Loc.Key="Payments.GenerateQrBtn" Text="Mark Paid (UPI)" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>


            <!-- ======================================================== -->
            <!-- TAB 2: SERVICE RATES & CATALOG WORKSPACE                 -->
            <!-- ======================================================== -->
            <Grid Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsRatesView), Mode=OneWay}"
                  ColumnDefinitions="*,440" ColumnSpacing="20">

                <!-- Left Column: Services Catalog List & Filters -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Catalog Header Card -->
                    <Border CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Title Bar -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="18"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Service Rates Catalog" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="{x:Bind ViewModel.CatalogRatesSummary, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live Search Box -->
                                <AutoSuggestBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                                                PlaceholderText="Search services..."
                                                QueryIcon="Find"
                                                Text="{x:Bind ViewModel.CatalogSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Search Service Rates Catalog"
                                                AutomationProperties.AutomationId="TxtCatalogSearch" />
                            </Grid>

                            <!-- Category Filter Chips -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="CatalogCategoryChipsPanel" Orientation="Horizontal" Spacing="6" />
                            </ScrollViewer>

                            <!-- Services List -->
                            <ListView ItemsSource="{x:Bind ViewModel.CatalogFilteredRates, Mode=OneWay}"
                                      SelectionMode="None"
                                      MaxHeight="560">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,3" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServiceRateItem">
                                        <Border CornerRadius="8" Padding="14,12"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                                <!-- Icon Glyph -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Service Info: Name + Category badge -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{x:Bind ServiceName}" FontWeight="SemiBold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Rate & Unit -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind local:PaymentsPage.FormatRupee(Rate)}"
                                                               FontWeight="Bold" FontSize="16"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind local:PaymentsPage.FormatUnitSuffix(Unit)}"
                                                               FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <!-- Actions: Edit & Delete -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Padding="8,6" ToolTipService.ToolTip="Edit this service"
                                                            Click="CatalogEdit_Click" Tag="{x:Bind}"
                                                            AutomationProperties.Name="Edit service rate"
                                                            AutomationProperties.AutomationId="BtnCatalogEdit">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                                    </Button>

                                                    <Button Padding="8,6" ToolTipService.ToolTip="Delete this service"
                                                            AutomationProperties.Name="Delete service rate"
                                                            AutomationProperties.AutomationId="BtnCatalogDelete">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <StackPanel Spacing="10" Width="220">
                                                                    <TextBlock Text="Delete Service?" FontWeight="SemiBold" FontSize="13" />
                                                                    <TextBlock Text="Are you sure you want to permanently remove this service rate from the catalog?"
                                                                               FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    <Button Content="Confirm Delete" Style="{StaticResource AccentButtonStyle}"
                                                                            Background="#EF4444" BorderBrush="#DC2626"
                                                                            HorizontalAlignment="Stretch"
                                                                            Click="ConfirmCatalogDelete_Click" Tag="{x:Bind}"
                                                                            AutomationProperties.Name="Confirm delete service rate"
                                                                            AutomationProperties.AutomationId="BtnCatalogConfirmDelete" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Add / Edit Service Form -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <!-- Form Header -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.FormHeaderTitle, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{x:Bind ViewModel.FormHeaderSubtitle, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Reset / New Button -->
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.ResetRateFormCommand}"
                                        Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEditingExistingRate), Mode=OneWay}"
                                        ToolTipService.ToolTip="Cancel editing and create new"
                                        AutomationProperties.Name="New service rate"
                                        AutomationProperties.AutomationId="BtnCatalogNew">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        <TextBlock Text="New" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2,0,4" />

                            <!-- Field 1: Service Name -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Service Name *" FontSize="12" FontWeight="SemiBold" />
                                <TextBox Text="{x:Bind ViewModel.FormServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. Color Printout A4, Lamination, Aadhaar Card..."
                                         HorizontalAlignment="Stretch"
                                         AutomationProperties.Name="Service Name"
                                         AutomationProperties.AutomationId="TxtCatalogServiceName" />
                            </StackPanel>

                            <!-- Field 2: Category -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Category *" FontSize="12" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.PresetCategories}"
                                          SelectedItem="{x:Bind ViewModel.FormCategory, Mode=TwoWay}"
                                          IsEditable="True" HorizontalAlignment="Stretch"
                                          PlaceholderText="Select or type category"
                                          AutomationProperties.Name="Service Category"
                                          AutomationProperties.AutomationId="CboCatalogCategory" />
                            </StackPanel>

                            <!-- Field 3: Rate & Unit -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Rate (₹) *" FontSize="12" FontWeight="SemiBold" />
                                    <NumberBox Value="{x:Bind ViewModel.FormRate, Mode=TwoWay}"
                                               Minimum="0" SpinButtonPlacementMode="Inline"
                                               HorizontalAlignment="Stretch"
                                               AutomationProperties.Name="Service Rate"
                                               AutomationProperties.AutomationId="NumCatalogRate" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Unit / Billing Per" FontSize="12" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.PresetUnits}"
                                              SelectedItem="{x:Bind ViewModel.FormUnit, Mode=TwoWay}"
                                              IsEditable="True" HorizontalAlignment="Stretch"
                                              PlaceholderText="e.g. page, doc"
                                              AutomationProperties.Name="Billing Unit"
                                              AutomationProperties.AutomationId="CboCatalogUnit" />
                                </StackPanel>
                            </Grid>

                            <!-- Field 4: Icon / Glyph Selector -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Card Icon" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            ToolTipService.ToolTip="Selected icon preview">
                                        <FontIcon Glyph="{x:Bind ViewModel.FormGlyph, Mode=OneWay}" FontSize="12" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- 5x2 Icon Picker Grid -->
                                <Grid x:Name="CatalogIconPickerGrid"
                                      ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="6" RowSpacing="6">
                                    <!-- Row 0 -->
                                    <Button Grid.Row="0" Grid.Column="0" Tag="&#xE749;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Document">
                                        <FontIcon Glyph="&#xE749;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" Tag="&#xE74E;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Print">
                                        <FontIcon Glyph="&#xE74E;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="2" Tag="&#xE8F1;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="ID / Smart Card">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="3" Tag="&#xE91B;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Certificate / Stamp">
                                        <FontIcon Glyph="&#xE91B;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="4" Tag="&#xE8B9;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Tools / Settings">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="15" />
                                    </Button>

                                    <!-- Row 1 -->
                                    <Button Grid.Row="1" Grid.Column="0" Tag="&#xE7C5;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Photo / Camera">
                                        <FontIcon Glyph="&#xE7C5;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Tag="&#xE72D;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Share / Transfer">
                                        <FontIcon Glyph="&#xE72D;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="2" Tag="&#xE8A5;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Checklist / Form">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="3" Tag="&#xE9D9;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Cash / Bill">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="4" Tag="&#xE7BE;" Click="CatalogGlyph_Click" HorizontalAlignment="Stretch" Padding="4,8" ToolTipService.ToolTip="Workstation / Desktop">
                                        <FontIcon Glyph="&#xE7BE;" FontSize="15" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,4" />

                            <!-- Form Actions -->
                            <StackPanel Spacing="8">
                                <Button Content="{x:Bind ViewModel.FormSaveButtonText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveRateFormCommand}"
                                        HorizontalAlignment="Stretch" Height="36"
                                        AutomationProperties.Name="Save service rate"
                                        AutomationProperties.AutomationId="BtnCatalogSave" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                                      Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEditingExistingRate), Mode=OneWay}">
                                    <Button Grid.Column="0" Content="Cancel Edit"
                                            Command="{x:Bind ViewModel.ResetRateFormCommand}"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Cancel Edit"
                                            AutomationProperties.AutomationId="BtnCatalogCancelEdit" />
                                    <Button Grid.Column="1" Content="Back to POS"
                                            Command="{x:Bind ViewModel.SwitchToPosViewCommand}"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Back to Point of Sale"
                                            AutomationProperties.AutomationId="BtnCatalogBackToPos" />
                                </Grid>

                                <Button Content="Back to POS"
                                        Command="{x:Bind ViewModel.SwitchToPosViewCommand}"
                                        Visibility="{x:Bind local:PaymentsPage.CollapsedIf(ViewModel.IsEditingExistingRate), Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Back to Point of Sale"
                                        AutomationProperties.AutomationId="BtnCatalogBackToPos" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>


            <!-- ======================================================== -->
            <!-- TAB 3: EARNINGS & REPORTS VIEW                           -->
            <!-- ======================================================== -->
            <StackPanel Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsEarningsView), Mode=OneWay}"
                        Spacing="16">

                <!-- 1. Filter Control Bar -->
                <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <!-- Quick Filter Pills -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Content="Today" Tag="Today" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Today'), Mode=OneWay}" />
                                <Button Content="This Week" Tag="This Week" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'This Week'), Mode=OneWay}" />
                                <Button Content="This Month" Tag="This Month" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'This Month'), Mode=OneWay}" />
                                <Button Content="Last Month" Tag="Last Month" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Last Month'), Mode=OneWay}" />
                                <Button Content="By Year" Tag="By Year" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'By Year'), Mode=OneWay}" />
                                <Button Content="Custom Range" Tag="Custom Range" Click="QuickFilter_Click" 
                                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedQuickFilter, 'Custom Range'), Mode=OneWay}" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadEarningsCommand}" ToolTipService.ToolTip="Refresh Earnings">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Refresh" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Secondary Filters Row -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- Year Selector (visible when By Year is chosen) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsYearFilterVisible), Mode=OneWay}">
                                <TextBlock Text="Year:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableYears, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}" MinWidth="90" />
                                
                                <TextBlock Text="Month:" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.MonthOptions, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedMonthIndex, Mode=TwoWay}" MinWidth="120" />
                            </StackPanel>

                            <!-- Custom Date Range Picker (visible when Custom Range is chosen) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:PaymentsPage.VisibleIf(ViewModel.IsCustomRangeVisible), Mode=OneWay}">
                                <TextBlock Text="From:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.CustomFromDate, Mode=TwoWay}" Width="140" />
                                <TextBlock Text="To:" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.CustomToDate, Mode=TwoWay}" Width="140" />
                            </StackPanel>

                            <!-- Payment Mode Filter -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Mode:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.PaymentModeFilters, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPaymentMode, Mode=TwoWay}" MinWidth="85" />
                            </StackPanel>

                            <!-- Search Filter Box -->
                            <TextBox Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Filter customer, invoice..." Width="220">
                                <TextBox.Header>
                                    <TextBlock Text="" />
                                </TextBox.Header>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Summary Metric Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <!-- Total Net Sales -->
                    <Border Grid.Column="0" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Total Earnings" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredTotal, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FilterPeriodDescription, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cash Counter Sales -->
                    <Border Grid.Column="1" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#10B981">
                                <FontIcon Glyph="&#xE717;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Cash Counter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredCash, Mode=OneWay}" FontWeight="Bold" FontSize="22" />
                                <TextBlock Text="Physical cash in hand" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Digital UPI Sales -->
                    <Border Grid.Column="2" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#3B82F6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="UPI &amp; Digital" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFilteredUpi, Mode=OneWay}" FontWeight="Bold" FontSize="22" />
                                <TextBlock Text="Direct bank settlements" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Win2D Bar Chart: Earnings Distribution -->
                <Border CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9F9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Earnings Distribution &amp; Trend" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <!-- Legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#3B82F6" />
                                    <TextBlock Text="UPI Sales" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="#10B981" />
                                    <TextBlock Text="Cash Sales" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="8,12">
                            <canvas:CanvasControl x:Name="EarningsCanvas" Height="200" Draw="EarningsCanvas_Draw" ClearColor="Transparent" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Filtered Transactions Ledger -->
                <Border CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="18,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="15" />
                                    <TextBlock Text="Transaction History Ledger" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.FormattedFilteredCount, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTransactions, Mode=OneWay}" SelectionMode="None" MaxHeight="380">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,12" VerticalAlignment="Center"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,14,0">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                    <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" Spacing="2">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind PaymentMode}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"
                                                   Text="{x:Bind FormattedAmount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

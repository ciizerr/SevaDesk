<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Header & Search Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Customers.Title" Text="Customers Directory" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Customers.Subtitle" Text="Search customer history or register new visits" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <AutoSuggestBox
                    Width="280"
                    loc:Loc.PlaceholderKey="Customers.SearchPlaceholder"
                    PlaceholderText="Search name, phone, or code..."
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Style="{StaticResource AccentButtonStyle}" Click="AddCustomer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Customers.AddBtn" Text="Add Customer" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Tabular Header: Name | Phone | Village | Last Visit | Files | Actions -->
                    <Grid Grid.Row="0" Padding="12,12,16,12"
                          ColumnDefinitions="260, 140, 140, 160, 80, *"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                          Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                        <TextBlock Grid.Column="0" Text="Customer" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Phone" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Village / Area" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Last Visit · Visits" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Files" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="Quick Actions" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="ListView_ItemClick"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerRowModel">
                                <Grid ColumnDefinitions="260, 140, 140, 160, 80, *" Padding="12,10,0,10"
                                      VerticalAlignment="Center"
                                      PointerEntered="Row_PointerEntered"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">

                                    <!-- Column 0: Avatar + Name + Code + ID chip -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PersonPicture Width="34" Height="34"
                                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(Customer.PhotoPath), Mode=OneWay}"
                                                       Initials="{x:Bind Customer.Initials}" />
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" FontSize="14" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <!-- ID chip -->
                                                <Border CornerRadius="4" Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        Visibility="{x:Bind loc:CustomerAvatarHelper.VisibleIfNotEmpty(Customer.FormattedMaskedId)}">
                                                    <TextBlock Text="{x:Bind Customer.FormattedMaskedId}" FontSize="10"
                                                               Foreground="#8B5CF6" FontFamily="Consolas" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Column 1: Phone -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Customer.Mobile}" FontSize="13" />
                                        <TextBlock Text="—" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.VisibleIfEmpty(Customer.Mobile)}" />
                                    </StackPanel>

                                    <!-- Column 2: Village -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Customer.Village}" FontSize="13" />
                                        <TextBlock Text="—" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.VisibleIfEmpty(Customer.Village)}" />
                                    </StackPanel>

                                    <!-- Column 3: Last Visit + Visit count (lazy) -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(StatsLoaded), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind LastVisitText, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind VisitCount, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="visits" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <!-- Placeholder before hover loads stats -->
                                        <TextBlock Text="Hover to load" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(StatsLoaded), Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Column 4: File count (lazy) -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(StatsLoaded), Mode=OneWay}">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FileCount, Mode=OneWay}" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="—" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(StatsLoaded), Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Column 5: Quick Actions -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind Customer}" Click="OpenFolder_Click"
                                                ToolTipService.ToolTip="Open customer folder in Windows Explorer">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xED25;" FontSize="12" />
                                                <TextBlock Text="Folder" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{x:Bind Customer.Id}" Click="StartSession_Click"
                                                Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="Start Session" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

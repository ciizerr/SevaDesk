<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="24" RowSpacing="16">
        <!-- Row 0: Header & Primary Action -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Customers.Title" Text="Customers" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Customers.Subtitle" Text="Browse customer profiles, visit history, workspace files, and launch counter sessions"
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Click="AddCustomer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock loc:Loc.Key="Customers.AddBtn" Text="Add Customer" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Overview Summary Cards -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Metric 1: Total Customers -->
            <Border Grid.Column="0" CornerRadius="8" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.TotalCustomersCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        <TextBlock loc:Loc.Key="Customers.StatTotal" Text="Total Customers" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock loc:Loc.Key="Customers.StatTotalSub" Text="Registered in SevaDesk" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric 2: Recent Visitors -->
            <Border Grid.Column="1" CornerRadius="8" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                            Background="#1810B981">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.RecentVisitorsCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        <TextBlock loc:Loc.Key="Customers.StatRecent" Text="Recent Visitors" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock loc:Loc.Key="Customers.StatRecentSub" Text="Visited in last 30 days" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric 3: Villages & Areas -->
            <Border Grid.Column="2" CornerRadius="8" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                            Background="#188B5CF6">
                        <FontIcon Glyph="&#xE707;" FontSize="18" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.UniqueVillagesCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        <TextBlock loc:Loc.Key="Customers.StatVillages" Text="Areas &amp; Villages" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock loc:Loc.Key="Customers.StatVillagesSub" Text="Client locations recorded" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Search, Filter Chips & Sort Toolbar -->
        <Border Grid.Row="2" CornerRadius="8" Padding="12,10"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <!-- Filter Chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAllRadio" Content="All" Tag="0" IsChecked="True"
                                 GroupName="CustomerFilters" Checked="FilterRadio_Checked"
                                 Style="{StaticResource DefaultRadioButtonStyle}" />
                    <RadioButton x:Name="FilterRecentRadio" Content="Recent (30d)" Tag="1"
                                 GroupName="CustomerFilters" Checked="FilterRadio_Checked"
                                 Style="{StaticResource DefaultRadioButtonStyle}" />
                    <RadioButton x:Name="FilterFrequentRadio" Content="Frequent (2+ Visits)" Tag="2"
                                 GroupName="CustomerFilters" Checked="FilterRadio_Checked"
                                 Style="{StaticResource DefaultRadioButtonStyle}" />
                </StackPanel>

                <!-- Search Input -->
                <AutoSuggestBox
                    Grid.Column="2"
                    Width="300"
                    loc:Loc.PlaceholderKey="Customers.SearchPlaceholder"
                    PlaceholderText="Search by name, phone, village, or code..."
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Sort ComboBox -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock loc:Loc.Key="Customers.SortLabel" Text="Sort by:" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="SortCombo" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged"
                              Width="160" VerticalAlignment="Center">
                        <ComboBoxItem loc:Loc.Key="Customers.SortNameAsc" Content="Name (A to Z)" />
                        <ComboBoxItem loc:Loc.Key="Customers.SortNameDesc" Content="Name (Z to A)" />
                        <ComboBoxItem loc:Loc.Key="Customers.SortNewest" Content="Newest Added" />
                        <ComboBoxItem loc:Loc.Key="Customers.SortVisits" Content="Most Visits" />
                        <ComboBoxItem loc:Loc.Key="Customers.SortRecentVisit" Content="Recently Visited" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Customer Roster (Cards View) & Empty State -->
        <Grid Grid.Row="3">
            <!-- Active Customer Cards List -->
            <ListView ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="ListView_ItemClick"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.HasCustomers, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomerRowModel">
                        <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="320, 220, 200, *" VerticalAlignment="Center">

                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem loc:Loc.Key="Customers.OpenProfile" Text="Open Profile" Click="OpenProfile_Click" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem loc:Loc.Key="Customers.FilesBtn" Text="Open Folder in Explorer" Click="OpenFolder_Click" Tag="{x:Bind Customer}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED25;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem loc:Loc.Key="Customers.StartSessionBtn" Text="Start Session" Click="StartSession_Click" Tag="{x:Bind Customer.Id}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem loc:Loc.Key="Customers.CopyPhone" Text="Copy Phone Number" Click="CopyPhone_Click" Tag="{x:Bind Customer}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem loc:Loc.Key="Customers.DeleteCustomer" Text="Delete Customer" Click="DeleteCustomer_Click" Tag="{x:Bind Customer}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Column 0: Avatar + Customer Details + Badges -->
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <PersonPicture Grid.Column="0" Width="40" Height="40"
                                                   ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(Customer.PhotoPath), Mode=OneWay}"
                                                   Initials="{x:Bind Customer.Initials}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!-- Customer Code Badge -->
                                            <Border CornerRadius="4" Padding="4,1"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <!-- Masked ID Chip -->
                                            <Border CornerRadius="4" Padding="5,1"
                                                    Background="#188B5CF6"
                                                    Visibility="{x:Bind loc:CustomerAvatarHelper.VisibleIfNotEmpty(Customer.FormattedMaskedId)}">
                                                <TextBlock Text="{x:Bind Customer.FormattedMaskedId}" FontSize="10"
                                                           Foreground="#8B5CF6" FontFamily="Consolas" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Column 1: Contact Phone & Village Location -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <!-- Phone + Quick WhatsApp / Copy -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE717;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind FormattedPhone}" FontSize="13" VerticalAlignment="Center" />

                                        <!-- WhatsApp Quick Launcher -->
                                        <Button Tag="{x:Bind}" Click="WhatsApp_Click" Padding="4,2" CornerRadius="4"
                                                ToolTipService.ToolTip="Chat on WhatsApp"
                                                Visibility="{x:Bind CanWhatsApp, Mode=OneWay}"
                                                Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xE717;" FontSize="9" Foreground="#10B981" />
                                                <TextBlock Text="WhatsApp" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Copy Phone Button -->
                                        <Button Tag="{x:Bind Customer}" Click="CopyPhone_Click" Width="22" Height="22" Padding="0" CornerRadius="3"
                                                ToolTipService.ToolTip="Copy phone number"
                                                Visibility="{x:Bind HasMobile, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Village Location -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE825;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind FormattedVillage}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 2: Visits & Folder Files (Progressive auto-loaded stats) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <!-- Visits Tag -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind StatsLoaded, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind VisitCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="visits · Last:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind LastVisitText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="Checking history..." FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(StatsLoaded), Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Files Tag -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xED25;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind StatsLoaded, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind FileCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="files in folder" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="Scanning files..." FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(StatsLoaded), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 3: 1-Click Actions & More Menu -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Primary: Start Session -->
                                    <Button Tag="{x:Bind Customer.Id}" Click="StartSession_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Start counter session for this customer">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock loc:Loc.Key="Customers.StartSessionBtn" Text="Start Session" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Files Folder Button -->
                                    <Button Tag="{x:Bind Customer}" Click="OpenFolder_Click"
                                            ToolTipService.ToolTip="Open customer working folder in Windows Explorer">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xED25;" FontSize="11" />
                                            <TextBlock loc:Loc.Key="Customers.FilesBtn" Text="Files" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- More Options Button (⋯) -->
                                    <Button Width="32" Height="32" Padding="0" CornerRadius="4"
                                            ToolTipService.ToolTip="More options" Tag="{x:Bind Customer}">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem loc:Loc.Key="Customers.OpenProfile" Text="Open Profile" Click="OpenProfile_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE77B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem loc:Loc.Key="Customers.FilesBtn" Text="Open Folder in Explorer" Click="OpenFolder_Click" Tag="{x:Bind Customer}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xED25;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem loc:Loc.Key="Customers.StartSessionBtn" Text="Start Counter Session" Click="StartSession_Click" Tag="{x:Bind Customer.Id}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem loc:Loc.Key="Customers.CopyPhone" Text="Copy Phone Number" Click="CopyPhone_Click" Tag="{x:Bind Customer}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem loc:Loc.Key="Customers.DeleteCustomer" Text="Delete Customer" Click="DeleteCustomer_Click" Tag="{x:Bind Customer}"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty Search / Filter State -->
            <Border CornerRadius="8" Padding="32"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock loc:Loc.Key="Customers.NoCustomersTitle" Text="No customers found"
                               Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock loc:Loc.Key="Customers.NoCustomersSub"
                               Text="Try searching with a different name or number, or reset your active filters."
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" />
                    <Button loc:Loc.Key="Customers.ClearFilters" Content="Clear Filters"
                            Click="ClearFilters_Click" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 4: Pagination & Page Size Toolbar -->
        <Border Grid.Row="4" CornerRadius="8" Padding="14,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Range Text and Page Size Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PageRangeText, Mode=OneWay}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                    <TextBlock loc:Loc.Key="Customers.PageSizeLabel" Text="Per page:" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                    <ComboBox x:Name="PageSizeCombo" SelectedIndex="1" SelectionChanged="PageSizeCombo_SelectionChanged"
                              Width="72" MinHeight="28" FontSize="12" VerticalAlignment="Center">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="15" />
                        <ComboBoxItem Content="25" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                </StackPanel>

                <!-- Right: Page Navigator (Page X of Y, First, Prev, Next, Last) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Page" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="of" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <!-- First Page -->
                    <Button Command="{x:Bind ViewModel.FirstPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Width="30" Height="28" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="First page">
                        <FontIcon Glyph="&#xE892;" FontSize="11" />
                    </Button>

                    <!-- Previous Page -->
                    <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Width="30" Height="28" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="Previous page">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>

                    <!-- Next Page -->
                    <Button Command="{x:Bind ViewModel.NextPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Width="30" Height="28" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="Next page">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>

                    <!-- Last Page -->
                    <Button Command="{x:Bind ViewModel.LastPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Width="30" Height="28" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="Last page">
                        <FontIcon Glyph="&#xE893;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

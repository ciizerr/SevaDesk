<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="32" Padding="40,32,40,60" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- 1. HERO SECTION -->
            <Border CornerRadius="16" MinHeight="260" Padding="48,32">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1B2A" Offset="0.0" />
                        <GradientStop Color="#1B263B" Offset="0.5" />
                        <GradientStop Color="#415A77" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Simulated Background graphics (since no assets) -->
                    <Ellipse Width="400" Height="400" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-150,0" />
                    <Ellipse Width="200" Height="200" Fill="#15FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,50,0" />
                    
                    <StackPanel VerticalAlignment="Center" Spacing="24">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="SevaDesk" FontSize="42" FontWeight="Bold" Foreground="White" />
                                <Border Background="#D4E157" CornerRadius="12" Padding="12,4" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#33691E" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Smart counter and customer management assistant&#x0a;for cyber cafes and digital service centers."
                                       FontSize="16" Foreground="#E0E0E0" TextWrapping="Wrap" LineHeight="24" />
                        </StackPanel>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" FontSize="12" Foreground="#81D4FA" />
                                    <TextBlock Text="100% Offline" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Border>
                            <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#81D4FA" />
                                    <TextBlock Text="Local PC Privacy" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Border>
                            <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="#FFE082" />
                                    <TextBlock Text="Free to Use" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Border>
                            <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="12" Foreground="#81D4FA" />
                                    <TextBlock Text="Open Source" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <!-- View on GitHub -->
                            <Button Command="{x:Bind ViewModel.OpenGitHubCommand}" CornerRadius="8" Padding="16,10" Background="#2196F3" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE815;" FontSize="14" Foreground="White" />
                                    <TextBlock Text="View on GitHub" FontWeight="SemiBold" Foreground="White" />
                                    <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="White" />
                                </StackPanel>
                            </Button>
                            
                            <!-- Discussions -->
                            <Button Command="{x:Bind ViewModel.OpenCommunityCommand}" CornerRadius="8" Padding="16,10" Background="#10FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="White" />
                                    <TextBlock Text="Discussions" FontWeight="SemiBold" Foreground="White" />
                                    <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. HELP, UPDATES & SUPPORT -->
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="18" Width="36" Height="36">
                        <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Help, Updates &amp; Support" FontSize="20" FontWeight="SemiBold" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Check for new versions, report an issue, or ask a question in the community." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid RowSpacing="16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Check for Updates -->
                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20"
                            CornerRadius="12" Command="{x:Bind ViewModel.CheckUpdatesCommand}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Background="#1E3B32" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                                <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="#81C995" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Check for Updates" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="View latest releases and new features on GitHub."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Report a Problem -->
                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20"
                            CornerRadius="12" Command="{x:Bind ViewModel.ReportBugCommand}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Background="#4A2525" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                                <FontIcon Glyph="&#xEBE8;" FontSize="20" Foreground="#F28B82" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Report a Problem" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Facing an error or something not working? Let us know."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Suggest an Idea -->
                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20"
                            CornerRadius="12" Command="{x:Bind ViewModel.RequestFeatureCommand}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Background="#4D3B1C" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                                <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="#FDE293" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Suggest an Idea" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Request a feature to improve your counter workflow."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Community Discussions -->
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20"
                            CornerRadius="12" Command="{x:Bind ViewModel.OpenCommunityCommand}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Background="#32244B" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                                <FontIcon Glyph="&#xE8BD;" FontSize="20" Foreground="#D7B7FD" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Community Discussions" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Connect and exchange tips with other shop owners."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 3. FOOTER BANNER -->
            <StackPanel Spacing="32" Margin="0,24,0,0">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Open Source" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Built with the community, for the community." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Grid.Column="2" ColumnSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEB51;" FontSize="24" Foreground="#F28B82" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Made for Local Businesses" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Designed for cyber cafes and digital service centers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Grid.Column="4" ColumnSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE825;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="MIT License" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Free and open-source software." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <TextBlock Text="SevaDesk · Built for cyber cafes and digital service centers · Free and open-source software under the MIT License."
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

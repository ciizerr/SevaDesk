<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0" Padding="0,0,0,48">

            <!-- ================================================================ -->
            <!-- HERO HEADER                                                       -->
            <!-- ================================================================ -->
            <Grid Padding="32,32,32,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Logo -->
                <Border Grid.Column="0" CornerRadius="16" Margin="0,0,20,0"
                        Width="72" Height="72"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Image Source="Assets/Square44x44Logo.scale-200.png"
                           Width="44" Height="44"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>

                <!-- Name + Version + Build info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="SevaDesk"
                                   FontSize="26" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock loc:Loc.Key="Common.Active" Text="Active"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Cyber Café &amp; CSC Center Management Platform"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.BuildInfoDisplay, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <!-- Tech stack badges -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4" Padding="7,3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7DE;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="WinUI 3" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4" Padding="7,3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8FB;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text=".NET 8 (win-x64)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4" Padding="7,3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEDA3;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="SQLite Offline DB" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4" Padding="7,3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="Open Source" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- GitHub button -->
                <Button Grid.Column="2" VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OpenGitHub_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="15" Height="15">
                            <Path Fill="White"
                                  Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                        </Viewbox>
                        <TextBlock Text="github.com/ciizerr" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Margin="32,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ================================================================ -->
            <!-- THREE-COLUMN CARD ROW                                            -->
            <!-- ================================================================ -->
            <Grid Padding="32,24,32,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: Issues & Feedback -->
                <Border Grid.Column="0" CornerRadius="12" Padding="20,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE939;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock loc:Loc.Key="Settings.About.FeedbackTitle"
                                           Text="Issues &amp; Feedback"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock loc:Loc.Key="Settings.About.FeedbackDesc"
                                       Text="Encountered a bug or want to suggest a new feature for SevaDesk?"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Button HorizontalAlignment="Stretch" Click="ReportBug_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEBE8;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.About.ReportBugBtn" Text="Report a Bug" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Click="RequestFeature_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE734;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.About.RequestFeatureBtn" Text="Request Feature" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CENTER: Developer -->
                <Border Grid.Column="1" CornerRadius="12" Padding="20,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77B;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock loc:Loc.Key="Settings.About.DevelopedBy"
                                           Text="Developed by ciizerr"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock loc:Loc.Key="Settings.About.DeveloperDesc"
                                       Text="Open-source cyber café and CSC center workspace platform for Indian digital operators"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OpenGitHub_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="White"
                                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                                </Viewbox>
                                <TextBlock loc:Loc.Key="Settings.About.GithubBtn" Text="View on GitHub" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Support & Sponsorship -->
                <Border Grid.Column="2" CornerRadius="12" Padding="20,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB51;" FontSize="16" Foreground="#FF5E36" />
                                <TextBlock loc:Loc.Key="Settings.About.SponsorTitle"
                                           Text="Support &amp; Sponsorship"
                                           FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock loc:Loc.Key="Settings.About.SponsorDesc"
                                       Text="Help keep SevaDesk active, open-source, and free for local café operators"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <!-- Buy Me a Coffee -->
                            <Button HorizontalAlignment="Stretch" Click="BuyMeCoffee_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FFDD00" Data="M3 13.5C3 17.09 5.91 20 9.5 20h3C16.09 20 19 17.09 19 13.5V6H3v7.5z" />
                                            <Path Fill="#FFDD00" Data="M19 8h1.5C21.88 8 23 9.12 23 10.5S21.88 13 20.5 13H19V8zm0 3.5h1.5c.55 0 1-.45 1-1s-.45-1-1-1H19v2z" />
                                            <Path Fill="#FF813F" Data="M7 2h2v2H7zm4-1h2v3h-2zm4 1h2v2h-2z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock loc:Loc.Key="Settings.About.BuyMeCoffeeBtn"
                                               Text="Buy Me a Coffee" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <!-- UPI -->
                            <Button HorizontalAlignment="Stretch" Click="CopyUpi_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <Viewbox Width="15" Height="15">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#F37021" Data="M14.5 4L8 15h5.5l-2 5L18 9h-5.5z" />
                                            <Path Fill="#43A047" Data="M9.5 4L3 15h5.5l-2 5L13 9H7.5z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock loc:Loc.Key="Settings.About.CopyUpiBtn"
                                               Text="Copy UPI ID" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================================================================ -->
            <!-- COMMUNITY & DISCUSSIONS CARD (full-width)                        -->
            <!-- ================================================================ -->
            <Border Margin="32,16,32,0" CornerRadius="12" Padding="20,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Fill="#5865F2"
                                      Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                            </Viewbox>
                            <TextBlock loc:Loc.Key="Settings.About.CommunityTitle"
                                       Text="Community &amp; Discussions"
                                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock loc:Loc.Key="Settings.About.CommunityDesc"
                                   Text="Join community discussions, ask questions, and share café setups with other operators"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="Community_Click" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8BD;" FontSize="13" />
                            <TextBlock loc:Loc.Key="Settings.About.CommunityBtn" Text="GitHub Discussions" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- RESET DEFAULTS CARD (full-width, danger-adjacent)                -->
            <!-- ================================================================ -->
            <Border Margin="32,16,32,0" CornerRadius="12" Padding="20,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="15"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock loc:Loc.Key="Settings.About.ResetTitle"
                                       Text="Restore Defaults"
                                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock loc:Loc.Key="Settings.About.ResetDesc"
                                   Text="Restore all themes, rates, and configuration values to initial factory defaults. This cannot be undone."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="Reset_Click" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock loc:Loc.Key="Settings.About.ResetBtn" Text="Restore Defaults" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- RESET APP DATA CARD (nuclear / destructive)                      -->
            <!-- ================================================================ -->
            <Border Margin="32,12,32,0" CornerRadius="12" Padding="20,16"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Reset All App Data"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                        <TextBlock Text="Permanently deletes ALL customers, sessions, payments, documents, and settings from this device. Translations are preserved. This action cannot be undone."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="ResetAppData_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Erase All Data"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- FOOTER COPYRIGHT                                                  -->
            <!-- ================================================================ -->
            <TextBlock Margin="32,24,32,0"
                       Text="© 2026 ciizerr. SevaDesk is free and open-source software."
                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextAlignment="Center" />

        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="32,24,32,48" MaxWidth="960" HorizontalAlignment="Left">

            <!-- ================================================================ -->
            <!-- HERO HEADER CARD                                                 -->
            <!-- ================================================================ -->
            <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Rectangular Logo with text -->
                    <Border Grid.Column="0" CornerRadius="8"
                            Width="180" Height="88"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Wide310x150Logo.scale-200.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="SevaDesk Logo" />
                    </Border>

                    <!-- App Title + Version + Tagline + Build info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="SevaDesk"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock loc:Loc.Key="Settings.About.BrandTagline"
                                   Text="Next-Gen Cyber Café &amp; CSC Center Management System"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BuildInfoDisplay, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Primary Action Buttons (GitHub Repo) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.OpenGitHubCommand}"
                                AutomationProperties.Name="Open GitHub Repository"
                                AutomationProperties.AutomationId="BtnAboutGitHub">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                                </Viewbox>
                                <TextBlock loc:Loc.Key="Settings.About.GithubBtn" Text="View on GitHub" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.OpenCommunityCommand}"
                                AutomationProperties.Name="Open GitHub Discussions"
                                AutomationProperties.AutomationId="BtnAboutDiscussions">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.About.CommunityBtn" Text="Discussions" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- TWO-COLUMN CONTENT CARDS: SYSTEM SPECS & COMMUNITY/FEEDBACK       -->
            <!-- ================================================================ -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT CARD: Application & Runtime Specs -->
                <Border Grid.Column="0" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="6" Width="32" Height="32"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE946;" FontSize="15"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock loc:Loc.Key="Settings.About.AppSectionTitle"
                                           Text="Application &amp; Runtime"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Core technology and platform stack"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Key-Value Metadata Grid -->
                        <Grid RowSpacing="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: UI Framework -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="UI Framework"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="WinUI 3 (Windows App SDK 2.4)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="Medium" TextAlignment="Right" />

                            <!-- Row 1: Runtime -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime Engine"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 8.0 (win-x64)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="Medium" TextAlignment="Right" />

                            <!-- Row 2: Database -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Local Storage"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="SQLite Database (WAL Mode)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="Medium" TextAlignment="Right" />

                            <!-- Row 3: License -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT (Free &amp; Open Source)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="Medium" TextAlignment="Right" />

                            <!-- Row 4: Maintainer -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Developer"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.DeveloperName, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="Medium" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RIGHT CARD: Feedback & Bug Reports -->
                <Border Grid.Column="1" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="6" Width="32" Height="32"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE939;" FontSize="15"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock loc:Loc.Key="Settings.About.FeedbackTitle"
                                           Text="Issues &amp; Feedback"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock loc:Loc.Key="Settings.About.FeedbackDesc"
                                           Text="Encountered a bug or want to suggest a new feature?"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="10">
                            <!-- Report Bug -->
                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ReportBugCommand}"
                                    AutomationProperties.Name="Report a Bug on GitHub"
                                    AutomationProperties.AutomationId="BtnAboutReportBug">
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <FontIcon Grid.Column="0" Glyph="&#xEBE8;" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" loc:Loc.Key="Settings.About.ReportBugBtn"
                                               Text="Report a Bug" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>

                            <!-- Request Feature -->
                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.RequestFeatureCommand}"
                                    AutomationProperties.Name="Request Feature on GitHub"
                                    AutomationProperties.AutomationId="BtnAboutRequestFeature">
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <FontIcon Grid.Column="0" Glyph="&#xE734;" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" loc:Loc.Key="Settings.About.RequestFeatureBtn"
                                               Text="Request Feature" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>

                            <!-- Community Discussions -->
                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.OpenCommunityCommand}"
                                    AutomationProperties.Name="Join Community Discussions"
                                    AutomationProperties.AutomationId="BtnAboutCommunity">
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" loc:Loc.Key="Settings.About.CommunityBtn"
                                               Text="GitHub Discussions" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================================================================ -->
            <!-- DANGER ZONE CARD: SYSTEM MAINTENANCE & DATA RESET                -->
            <!-- ================================================================ -->
            <Border CornerRadius="12" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="6" Width="32" Height="32"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE7BA;" FontSize="15"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1">
                            <TextBlock Text="System Maintenance &amp; Reset"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Reset configuration preferences or erase local data"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Row 1: Restore Defaults -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock loc:Loc.Key="Settings.About.ResetTitle"
                                       Text="Restore Default Settings"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock loc:Loc.Key="Settings.About.ResetDesc"
                                       Text="Restore all themes, rates, and configuration values to initial factory defaults."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.ResetDefaultsCommand}"
                                AutomationProperties.Name="Restore Default Settings"
                                AutomationProperties.AutomationId="BtnAboutRestoreDefaults"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock loc:Loc.Key="Settings.About.ResetBtn" Text="Restore Defaults" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Row 2: Erase All Data -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Erase All Application Data"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Permanently deletes all customer sessions, documents, payments, and SQLite records from this PC."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.ResetAppDataCommand}"
                                AutomationProperties.Name="Erase All Application Data"
                                AutomationProperties.AutomationId="BtnAboutResetAllData"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Erase All Data"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================================================ -->
            <!-- FOOTER NOTICE                                                    -->
            <!-- ================================================================ -->
            <TextBlock Text="© 2026 ciizerr · SevaDesk is free and open-source software under the MIT License."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>

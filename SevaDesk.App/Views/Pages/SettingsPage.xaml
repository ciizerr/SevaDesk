<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ======================================================== -->
        <!-- TOP HEADER                                                -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Padding="24,20,24,12" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Settings.Title" Text="Settings"
                           Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Settings.Subtitle"
                           Text="Personalization, cyber café branding, printer configuration, and system information"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Save Changes button — visible only when there are unsaved changes -->
            <Button Grid.Column="1"
                    x:Name="BtnSaveChanges"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveChanges_Click"
                    Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.HasUnsavedChanges), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save Changes" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======================================================== -->
        <!-- SEGMENTED TAB NAVIGATION (with icons)                    -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="24,0,24,8">
            <SelectorBar x:Name="TabSelector" SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabAppearance" loc:Loc.Key="Settings.Tab.Appearance" Text="Appearance">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabProfile" loc:Loc.Key="Settings.Tab.Profile" Text="Café Profile">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabHardware" loc:Loc.Key="Settings.Tab.Hardware" Text="Hardware &amp; Rates">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9A1;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabStorage" loc:Loc.Key="Settings.Tab.Storage" Text="Storage &amp; Automation">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN SCROLLABLE CONTENT                                  -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="1040" HorizontalAlignment="Left">


                <!-- ======================================================== -->
                <!-- 1. APPEARANCE TAB                                        -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelAppearance" Spacing="4">
                    <TextBlock loc:Loc.Key="Settings.Appearance.ThemeGroup"
                               Text="Application Theme"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- Theme Mode -->
                    <ctk:SettingsCard
                        Header="Theme Mode"
                        Description="Select your preferred application color mode">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="180"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeSystem" Content="Windows Default" />
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeLight" Content="Light" />
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeDark" Content="Dark" />
                        </ComboBox>
                    </ctk:SettingsCard>

                    <!-- Mica Backdrop -->
                    <ctk:SettingsCard
                        Header="Windows 11 Mica Backdrop"
                        Description="Translucent window backdrop reflecting your desktop wallpaper">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81E;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableMicaBackdrop, Mode=TwoWay}"
                                      OnContent="Enabled" OffContent="Disabled" />
                    </ctk:SettingsCard>

                    <!-- Window Close Action -->
                    <ctk:SettingsCard
                        Header="Window Close Action"
                        Description="Choose whether clicking 'X' minimizes to the system tray or exits the app">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="180"
                                  SelectedIndex="{x:Bind ViewModel.SelectedCloseBehaviorIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="Settings.General.ClosePrompt" Content="Always Ask" />
                            <ComboBoxItem loc:Loc.Key="Settings.General.CloseMinimize" Content="Minimize to Tray" />
                            <ComboBoxItem loc:Loc.Key="Settings.General.CloseExit" Content="Exit Application" />
                        </ComboBox>
                    </ctk:SettingsCard>

                    <TextBlock loc:Loc.Key="Settings.Appearance.LanguageGroup"
                               Text="Language &amp; Regional Preferences"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,12,0,4" />

                    <!-- Language -->
                    <ctk:SettingsCard
                        Header="Language / भाषा"
                        Description="Select your application display language or sync new translations from GitHub">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="200"
                                      ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Click="CheckLanguageUpdates_Click"
                                    IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsCheckingLanguageUpdates), Mode=OneWay}"
                                    ToolTipService.ToolTip="Check GitHub repository for new language translations">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Appearance.CheckUpdatesBtn" Text="Sync Languages" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctk:SettingsCard>
                </StackPanel>


                <!-- ======================================================== -->
                <!-- 2. CAFÉ PROFILE TAB                                      -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelProfile" Spacing="4" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Cafe.Header"
                               Text="Center &amp; Operator Details"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <ctk:SettingsCard
                        Header="Cyber Café / CSC Center Name"
                        Description="Printed on customer receipts, invoices, and payment screens">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7EE;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320"
                                 Text="{x:Bind ViewModel.ShopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="VLE / Operator Name"
                        Description="Primary cashier &amp; system operator name">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320"
                                 Text="{x:Bind ViewModel.OperatorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="CSC VLE ID / Shop Code"
                        Description="Official registration ID for CSC or cyber café center">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320" FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.CscVleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="WhatsApp / Support Phone Number"
                        Description="Customer support phone displayed on bills">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE717;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320"
                                 Text="{x:Bind ViewModel.ContactNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="Shop Physical Address"
                        Description="Location address shown on receipts &amp; certificate printouts">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE707;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320"
                                 Text="{x:Bind ViewModel.ShopAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <TextBlock loc:Loc.Key="Settings.Cafe.UpiHeader"
                               Text="Digital UPI Payments"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,12,0,4" />

                    <ctk:SettingsCard
                        Header="Shop UPI VPA (UPI ID)"
                        Description="Destination address for dynamic UPI QR code generator (e.g. yourshop@upi)">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C7;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320" FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.ShopUpiVpa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="UPI Payee Display Name"
                        Description="Account holder / business name shown inside customer UPI apps">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE779;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="320"
                                 Text="{x:Bind ViewModel.PayeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>
                </StackPanel>


                <!-- ======================================================== -->
                <!-- 3. HARDWARE & RATES TAB                                  -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelHardware" Spacing="4" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Hardware.PrintersHeader"
                               Text="Connected Printers"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <ctk:SettingsCard
                        Header="Counter B&amp;W Laser Printer"
                        Description="Default hardware output for document and form printing">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE749;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="300" IsEditable="True"
                                  ItemsSource="{x:Bind ViewModel.InstalledPrinters}"
                                  Text="{x:Bind ViewModel.DefaultBwPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="Photo &amp; Color Inkjet Printer"
                        Description="High resolution printer for photo, certificate, and color work">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE749;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="300" IsEditable="True"
                                  ItemsSource="{x:Bind ViewModel.InstalledPrinters}"
                                  Text="{x:Bind ViewModel.DefaultColorPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ctk:SettingsCard>
                </StackPanel>


                <!-- ======================================================== -->
                <!-- 4. STORAGE & AUTOMATION TAB                              -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelStorage" Spacing="4" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Storage.Header"
                               Text="Working Folders &amp; Ingestion"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- Working Root Directory -->
                    <ctk:SettingsCard
                        Header="Desktop Working Root Directory">
                        <ctk:SettingsCard.Description>
                            <TextBlock Text="{x:Bind ViewModel.WorkingRootPath, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctk:SettingsCard.Description>
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xED25;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="BrowseWorkingFolder_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.ChangeFolderBtn" Text="Change Folder..." />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.OpenFolderBtn" Text="Open in Explorer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctk:SettingsCard>

                    <!-- Backup Database Folder -->
                    <ctk:SettingsCard
                        Header="Customer Database Backup (Archive) Directory">
                        <ctk:SettingsCard.Description>
                            <TextBlock Text="{x:Bind ViewModel.BackupRootPath, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctk:SettingsCard.Description>
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE792;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <Button Command="{x:Bind ViewModel.BrowseBackupFolderCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="Change Archive..." />
                            </StackPanel>
                        </Button>
                    </ctk:SettingsCard>

                    <!-- Watched Ingestion Folders (Expander) -->
                    <ctk:SettingsExpander
                        Header="Auto-Detect Incoming Files"
                        Description="Watch system and scanner folders to automatically route files to the active customer"
                        IsExpanded="True">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEC4F;" />
                        </ctk:SettingsExpander.HeaderIcon>
                        <Button Click="AddCustomWatchFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock loc:Loc.Key="Settings.Storage.AddWatchFolderBtn" Text="Add Custom Folder" />
                            </StackPanel>
                        </Button>

                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard Header="Downloads"
                                              Description="Watch the system Downloads folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE896;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDownloads, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Desktop"
                                              Description="Watch the system Desktop folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7F4;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDesktop, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Documents"
                                              Description="Watch the system Documents folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDocuments, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <!-- Custom watched folders list -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CustomWatchFolders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border CornerRadius="6" Padding="10,6" Margin="0,2,0,0"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xED25;" FontSize="13"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent"
                                                Padding="6,2"
                                                Click="RemoveCustomWatchFolder_Click" Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Remove this watched folder">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Floating Overlay Widget -->
                    <ctk:SettingsExpander
                        Header="Floating Incoming File HUD Widget"
                        Description="Pop up an always-on-top overlay widget to 1-click move files when SevaDesk is minimized"
                        IsExpanded="False"
                        Margin="0,8,0,0">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE78B;" />
                        </ctk:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsOverlayWidgetEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                Header="Overlay Screen Placement"
                                Description="Choose which corner of the monitor the floating triage popup appears in">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE744;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ComboBox Width="200"
                                          SelectedIndex="{x:Bind ViewModel.OverlayPositionIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Bottom-Right (Default)" />
                                    <ComboBoxItem Content="Top-Right" />
                                    <ComboBoxItem Content="Bottom-Left" />
                                    <ComboBoxItem Content="Top-Left" />
                                </ComboBox>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <TextBlock loc:Loc.Key="Settings.Storage.DbHeader"
                               Text="Database &amp; Data Safety"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,12,0,4" />

                    <!-- Auto-Archive Sessions -->
                    <ctk:SettingsCard
                        Header="Auto-Archive Customer Sessions"
                        Description="Automatically archive completed customer folders older than duration">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF0E2;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="180"
                                  SelectedIndex="{x:Bind ViewModel.AutoArchiveDaysIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="After 7 days" />
                            <ComboBoxItem Content="After 15 days" />
                            <ComboBoxItem Content="After 30 days" />
                            <ComboBoxItem Content="After 60 days" />
                            <ComboBoxItem Content="Never" />
                        </ComboBox>
                    </ctk:SettingsCard>

                    <!-- Database Backup -->
                    <ctk:SettingsCard
                        Header="SQLite Application Database">
                        <ctk:SettingsCard.Description>
                            <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctk:SettingsCard.Description>
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEDA3;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <Button Click="Backup_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE792;" FontSize="14" />
                                <TextBlock loc:Loc.Key="Settings.Storage.DbBackupBtn" Text="Backup Database Now" />
                            </StackPanel>
                        </Button>
                    </ctk:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="True"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          PointerPressed="Background_PointerPressed">

        <!-- ======================================================== -->
        <!-- TOP HEADER: TITLE & SUBTLE AUTO-SAVE STATUS              -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Padding="28,20,28,12" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Settings.Title" Text="Settings"
                           Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Settings.Subtitle"
                           Text="Manage your shop details, app appearance, and local storage safety"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Subtle Auto-Save Indicator -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    CornerRadius="6" Padding="12,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3 SIMPLE TABS: SHOP PROFILE, APPEARANCE, STORAGE         -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="28,0,28,8">
            <SelectorBar x:Name="TabSelector" SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabProfile" loc:Loc.Key="Settings.Tab.Profile" Text="Shop Profile">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabAppearance" loc:Loc.Key="Settings.Tab.Appearance" Text="Appearance">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabStorage" loc:Loc.Key="Settings.Tab.Storage" Text="Storage">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN SCROLLABLE CONTENT                                  -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      PointerPressed="Background_PointerPressed">
            <StackPanel Spacing="16" Padding="28,18,28,48" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- ======================================================== -->
                <!-- 1. SHOP PROFILE TAB (DEFAULT ACTIVE)                     -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelProfile" Spacing="6">
                    <TextBlock loc:Loc.Key="Settings.Cafe.Header"
                               Text="Shop &amp; Billing Details"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- Shop Name -->
                    <ctk:SettingsCard
                        Header="Shop Name"
                        Description="Your cyber café or CSC center name printed on bills and receipts">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7EE;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340"
                                 Text="{x:Bind ViewModel.ShopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- Operator Name -->
                    <ctk:SettingsCard
                        Header="Operator / Owner Name"
                        Description="Primary cashier or center operator name">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340"
                                 Text="{x:Bind ViewModel.OperatorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- CSC ID -->
                    <ctk:SettingsCard
                        Header="CSC Center ID / Shop Code"
                        Description="Official registration ID or center reference code (optional)">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340" FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.CscVleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- WhatsApp Contact -->
                    <ctk:SettingsCard
                        Header="WhatsApp / Support Phone Number"
                        Description="Customer support number shown on invoices and receipts">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE717;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340"
                                 Text="{x:Bind ViewModel.ContactNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- Shop Address -->
                    <ctk:SettingsCard
                        Header="Shop Address"
                        Description="Location address shown on receipts and customer invoices">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE707;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340"
                                 Text="{x:Bind ViewModel.ShopAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- Section: UPI Payments -->
                    <TextBlock loc:Loc.Key="Settings.Cafe.UpiHeader"
                               Text="Digital UPI Payments"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <!-- Shop UPI ID -->
                    <ctk:SettingsCard
                        Header="Shop UPI ID (VPA)"
                        Description="Payment destination for customer UPI QR codes (e.g. yourshop@upi)">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C7;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340" FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.ShopUpiVpa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- Payee Display Name -->
                    <ctk:SettingsCard
                        Header="UPI Payee Name"
                        Description="Business or account name shown inside customer UPI apps when scanning">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE779;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <TextBox Width="340"
                                 Text="{x:Bind ViewModel.PayeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Input_LostFocus" />
                    </ctk:SettingsCard>

                    <!-- Section: Welcome Setup & Onboarding -->
                    <TextBlock Text="Welcome Setup &amp; Onboarding"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <ctk:SettingsCard
                        Header="Replay Welcome Setup"
                        Description="Run the initial first-time onboarding wizard again anytime">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7EE;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <Button Click="ReplayOnboarding_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                <TextBlock loc:Loc.Key="Settings.Shop.ReplaySetupBtn" Text="Launch Setup Wizard" />
                            </StackPanel>
                        </Button>
                    </ctk:SettingsCard>
                </StackPanel>


                <!-- ======================================================== -->
                <!-- 2. APPEARANCE TAB                                        -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelAppearance" Spacing="6" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Appearance.ThemeGroup"
                               Text="Application Theme &amp; Window"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- Theme Mode -->
                    <ctk:SettingsCard
                        Header="Theme Mode"
                        Description="Select your preferred application color mode">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="200"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeSystem" Content="Windows Default" />
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeLight" Content="Light" />
                            <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeDark" Content="Dark" />
                        </ComboBox>
                    </ctk:SettingsCard>

                    <!-- Mica Backdrop -->
                    <ctk:SettingsCard
                        Header="Windows 11 Mica Effect"
                        Description="Translucent window background reflecting your desktop wallpaper">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81E;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableMicaBackdrop, Mode=TwoWay}"
                                      OnContent="Enabled" OffContent="Disabled" />
                    </ctk:SettingsCard>

                    <!-- Window Close Action -->
                    <ctk:SettingsCard
                        Header="When Closing the Window"
                        Description="Choose what happens when clicking the 'X' button">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <ComboBox Width="200"
                                  SelectedIndex="{x:Bind ViewModel.SelectedCloseBehaviorIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="Settings.General.ClosePrompt" Content="Always Ask" />
                            <ComboBoxItem loc:Loc.Key="Settings.General.CloseMinimize" Content="Minimize to System Tray" />
                            <ComboBoxItem loc:Loc.Key="Settings.General.CloseExit" Content="Exit Application" />
                        </ComboBox>
                    </ctk:SettingsCard>

                    <!-- Section: Language -->
                    <TextBlock loc:Loc.Key="Settings.Appearance.LanguageGroup"
                               Text="Language &amp; Region"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <!-- Language Selector -->
                    <ctk:SettingsCard
                        Header="Language / भाषा"
                        Description="Choose your application display language">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="200"
                                      ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Click="CheckLanguageUpdates_Click"
                                    IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsCheckingLanguageUpdates), Mode=OneWay}"
                                    ToolTipService.ToolTip="Check for latest translations">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Appearance.CheckUpdatesBtn" Text="Sync Languages" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctk:SettingsCard>
                </StackPanel>


                <!-- ======================================================== -->
                <!-- 3. STORAGE & AUTOMATION TAB                              -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelStorage" Spacing="6" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Storage.Header"
                               Text="Customer Files &amp; Storage Locations"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,4" />

                    <!-- Working Root Directory -->
                    <ctk:SettingsCard
                        Header="Customer Working Folder"
                        Description="Where customer folders, photos, and scanned documents are stored">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xED25;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="BrowseWorkingFolder_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.ChangeFolderBtn" Text="Change Folder..." />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.OpenFolderBtn" Text="Open in Explorer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctk:SettingsCard>

                    <!-- Working Root Path Caption -->
                    <TextBlock Text="{x:Bind ViewModel.WorkingRootPath, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11" Margin="44,-2,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Backup Database Folder -->
                    <ctk:SettingsCard
                        Header="Backup Archive Folder"
                        Description="Where customer database backup archives are safely stored">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE792;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <Button Command="{x:Bind ViewModel.BrowseBackupFolderCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="Change Archive..." />
                            </StackPanel>
                        </Button>
                    </ctk:SettingsCard>

                    <!-- Backup Archive Path Caption -->
                    <TextBlock Text="{x:Bind ViewModel.BackupRootPath, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11" Margin="44,-2,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Auto-delete Working Folders with Slider & Preset Chips -->
                    <ctk:SettingsCard
                        Header="Auto-Clean Desktop Customer Folders"
                        Description="After customer files are backed up, automatically remove their Desktop working folder to keep your screen clean">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74D;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Width="420" Spacing="8" Margin="0,4,0,4">
                            <!-- Live status display (zero toast spam while dragging) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="Clean timing:" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.WorkingFolderTtlDisplay, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Responsive Slider -->
                            <Slider x:Name="SldTtlHours"
                                    Minimum="0" Maximum="168"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.WorkingFolderTtlHours, Mode=TwoWay}"
                                    ValueChanged="SldTtlHours_ValueChanged"
                                    PointerCaptureLost="SldTtlHours_PointerCaptureLost"
                                    PointerReleased="SldTtlHours_PointerReleased"
                                    HorizontalAlignment="Stretch" />

                            <!-- Preset Chips -->
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Tag="0" Click="PresetHours_Click" Padding="8,4" FontSize="11"
                                        ToolTipService.ToolTip="Clean immediately on next startup">
                                    <TextBlock Text="Immediate" />
                                </Button>
                                <Button Tag="12" Click="PresetHours_Click" Padding="8,4" FontSize="11"
                                        ToolTipService.ToolTip="12 Hours">
                                    <TextBlock Text="12 Hours" />
                                </Button>
                                <Button Tag="24" Click="PresetHours_Click" Padding="8,4" FontSize="11"
                                        ToolTipService.ToolTip="24 Hours (1 Day)">
                                    <TextBlock Text="24 Hours" />
                                </Button>
                                <Button Tag="48" Click="PresetHours_Click" Padding="8,4" FontSize="11"
                                        ToolTipService.ToolTip="48 Hours (2 Days)">
                                    <TextBlock Text="2 Days" />
                                </Button>
                                <Button Tag="168" Click="PresetHours_Click" Padding="8,4" FontSize="11"
                                        ToolTipService.ToolTip="168 Hours (7 Days)">
                                    <TextBlock Text="7 Days" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ctk:SettingsCard>

                    <!-- Auto-Detect Incoming Files (Expander) -->
                    <ctk:SettingsExpander
                        Header="Auto-Detect Incoming Files"
                        Description="Watch folders to automatically route downloaded or scanned files to the active customer"
                        IsExpanded="True"
                        Margin="0,4,0,0">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEC4F;" />
                        </ctk:SettingsExpander.HeaderIcon>
                        <Button Click="AddCustomWatchFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock loc:Loc.Key="Settings.Storage.AddWatchFolderBtn" Text="Add Custom Folder" />
                            </StackPanel>
                        </Button>

                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard Header="Downloads"
                                              Description="Watch system Downloads folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE896;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDownloads, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Desktop"
                                              Description="Watch system Desktop folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7F4;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDesktop, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="Documents"
                                              Description="Watch system Documents folder for incoming files">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.WatchDocuments, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <!-- Custom watched folders list -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CustomWatchFolders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border CornerRadius="6" Padding="10,6" Margin="0,2,0,0"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xED25;" FontSize="13"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent"
                                                Padding="6,2"
                                                Click="RemoveCustomWatchFolder_Click" Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Remove this watched folder">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Floating Overlay Widget -->
                    <ctk:SettingsExpander
                        Header="Floating Incoming File HUD Widget"
                        Description="Always-on-top quick box to 1-click move files when SevaDesk is minimized"
                        IsExpanded="False"
                        Margin="0,4,0,0">
                        <ctk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE78B;" />
                        </ctk:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsOverlayWidgetEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                Header="Widget Screen Position"
                                Description="Which corner of the monitor the floating popup appears in">
                                <ctk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE744;" />
                                </ctk:SettingsCard.HeaderIcon>
                                <ComboBox Width="200"
                                          SelectedIndex="{x:Bind ViewModel.OverlayPositionIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Bottom-Right (Default)" />
                                    <ComboBoxItem Content="Top-Right" />
                                    <ComboBoxItem Content="Bottom-Left" />
                                    <ComboBoxItem Content="Top-Left" />
                                </ComboBox>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>

                    <!-- Section: Database Safety -->
                    <TextBlock loc:Loc.Key="Settings.Storage.DbHeader"
                               Text="Database &amp; Data Safety"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <!-- Database Backup & Restore -->
                    <ctk:SettingsCard
                        Header="SQLite Customer Database"
                        Description="Save a backup to a USB drive or folder, or restore records from a backup file">
                        <ctk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEDA3;" />
                        </ctk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Backup_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE792;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.DbBackupBtn" Text="Backup Database..." />
                                </StackPanel>
                            </Button>
                            <Button Click="Restore_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.DbRestoreBtn" Text="Restore Backup..." />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctk:SettingsCard>

                    <!-- Database Path Caption -->
                    <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11" Margin="44,-2,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

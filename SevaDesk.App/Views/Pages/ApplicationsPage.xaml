<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="14">
        <!-- 0. Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Applications.Title" Text="Online Forms &amp; Schemes" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Applications.Subtitle"
                           Text="Track customer applications, check required documents, and manage scheme templates"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh applications and forms">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Applications.RefreshBtn" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="HeaderAction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{x:Bind local:ApplicationsPage.GetHeaderButtonText(ViewModel.SelectedTabIndex), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Segmented View Switcher (SelectorBar) -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,0,0,6">
            <SelectorBar x:Name="AppTabSelector" SelectionChanged="AppTabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabApplications" loc:Loc.Key="Applications.TabApplications" Text="Customer Applications" />
                <SelectorBarItem x:Name="TabTemplates" loc:Loc.Key="Applications.TabTemplates" Text="Form Templates" />
            </SelectorBar>
        </Border>


        <!-- 2A. TAB 0: CUSTOMER APPLICATIONS -->
        <Grid Grid.Row="2" ColumnDefinitions="440,*" ColumnSpacing="16"
              Visibility="{x:Bind local:ApplicationsPage.VisibleIf(ViewModel.IsApplicationsTab), Mode=OneWay}">
            <!-- Left: Applications List & Filter Bar -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <!-- Search Input -->
                    <Grid Grid.Row="0" Padding="12,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBox x:Name="TxtAppSearch"
                                 PlaceholderText="Search by customer, scheme, or app #..."
                                 TextChanged="AppSearch_TextChanged" />
                    </Grid>

                    <!-- Status Filter Buttons Bar -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Padding="10,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnFilterAll" Click="FilterStatus_Click" Tag="All"
                                    Style="{StaticResource AccentButtonStyle}" Padding="8,4" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="All" FontSize="11" FontWeight="SemiBold" />
                                    <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.AllApplicationsCount, Mode=OneWay}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnFilterDraft" Click="FilterStatus_Click" Tag="Draft"
                                    Padding="8,4" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Draft" FontSize="11" />
                                    <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.DraftCount, Mode=OneWay}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnFilterDocsReady" Click="FilterStatus_Click" Tag="Docs Ready"
                                    Padding="8,4" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Docs Ready" FontSize="11" />
                                    <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.DocsReadyCount, Mode=OneWay}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnFilterCompleted" Click="FilterStatus_Click" Tag="Completed"
                                    Padding="8,4" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Completed" FontSize="11" />
                                    <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Applications ListView -->
                    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Applications, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ApplicationItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,12" VerticalAlignment="Center"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind CustomerName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind PortalName}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{x:Bind local:ApplicationsPage.AppStatusBackground(Status), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind local:ApplicationsPage.AppStatusDisplay(Status), Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:ApplicationsPage.AppStatusForeground(Status), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind FormattedTotal}"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Application Details & Required Documents Checklist -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty State when no application is selected -->
                    <Border Visibility="{x:Bind local:ApplicationsPage.CollapsedIf(ViewModel.HasSelectedApplication), Mode=OneWay}"
                            Padding="32" CornerRadius="8" Margin="0,40,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7C3;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="No Customer Application Selected" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Select an ongoing application from the left, or click 'New Application' to register a form."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="NewApplication_Click" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Register Application" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Active Application Details & Checklist -->
                    <StackPanel Spacing="16" Visibility="{x:Bind local:ApplicationsPage.VisibleIf(ViewModel.HasSelectedApplication), Mode=OneWay}">
                        <!-- Top Application Header Card -->
                        <Border Padding="20" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                                <!-- Title, Customer, and Action Buttons -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedApplication.Title, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="18" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedApplication.CustomerName, Mode=OneWay}"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedApplication.ApplicationNumber, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons: Open Portal, Open Customer Folder, Delete -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Click="OpenCustomerFolder_Click" ToolTipService.ToolTip="Open customer's working folder in File Explorer">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xED25;" FontSize="13" />
                                                <TextBlock Text="Customer Folder" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource AccentButtonStyle}" Click="LaunchPortal_Click" ToolTipService.ToolTip="Open portal in default web browser">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                                <TextBlock loc:Loc.Key="Common.Open" Text="Open Portal" />
                                            </StackPanel>
                                        </Button>

                                        <Button Click="DeleteApplication_Click" ToolTipService.ToolTip="Remove this application">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <!-- Fee Breakdown & Status Workflow -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Fee Breakdown" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Service Fee:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedApplication.FormattedServiceCharge, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Govt Fee:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedApplication.FormattedGovtFee, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Total:" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedApplication.FormattedTotal, Mode=OneWay}"
                                                           FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Automatic Visual Status Badge with Manual Override Menu -->
                                    <DropDownButton Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                                    Background="{x:Bind local:ApplicationsPage.AppStatusBackground(ViewModel.SelectedApplication.Status), Mode=OneWay}"
                                                    BorderBrush="{x:Bind local:ApplicationsPage.AppStatusBorder(ViewModel.SelectedApplication.Status), Mode=OneWay}"
                                                    BorderThickness="1">
                                        <DropDownButton.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind local:ApplicationsPage.AppStatusGlyph(ViewModel.SelectedApplication.Status), Mode=OneWay}"
                                                          FontSize="12"
                                                          Foreground="{x:Bind local:ApplicationsPage.AppStatusForeground(ViewModel.SelectedApplication.Status), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind local:ApplicationsPage.AppStatusDisplay(ViewModel.SelectedApplication.Status), Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{x:Bind local:ApplicationsPage.AppStatusForeground(ViewModel.SelectedApplication.Status), Mode=OneWay}" />
                                            </StackPanel>
                                        </DropDownButton.Content>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="Draft" Click="StatusDraft_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A5;" Foreground="#F59E0B" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Docs Ready" Click="StatusDocsReady_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE73E;" Foreground="#3B82F6" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Completed" Click="StatusCompleted_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE930;" Foreground="#10B981" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Required Document Checklist Card with Visual Progress -->
                        <Border CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <!-- Checklist Header with Progress Stats -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,12"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                                        <TextBlock Text="Document Readiness Checklist" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChecklistProgressText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Visual Progress Bar -->
                                <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.ChecklistProgressPercent, Mode=OneWay}"
                                             Height="4" Margin="0" HorizontalAlignment="Stretch" />

                                <!-- Checklist Items List -->
                                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedChecklist, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ApplicationChecklistItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,10" VerticalAlignment="Center"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                                          Checked="ChecklistItem_Checked" Unchecked="ChecklistItem_Unchecked" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                Visibility="{x:Bind local:ApplicationsPage.VisibleIf(HasMatchedFile), Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                        <TextBlock Text="{x:Bind MatchedFileName, Mode=OneWay}" FontSize="11"
                                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                                                        Background="{x:Bind local:ApplicationsPage.ChecklistBadgeBackground(HasMatchedFile), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind local:ApplicationsPage.ChecklistBadgeText(HasMatchedFile, Category), Mode=OneWay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{x:Bind local:ApplicationsPage.ChecklistBadgeForeground(HasMatchedFile), Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>


        <!-- 2B. TAB 1: FORM TEMPLATES CATALOG -->
        <Grid Grid.Row="2" ColumnDefinitions="440,*" ColumnSpacing="16"
              Visibility="{x:Bind local:ApplicationsPage.VisibleIf(ViewModel.IsTemplatesTab), Mode=OneWay}">
            <!-- Left: Templates List -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Search & Filter Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,10"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
                        <TextBox x:Name="TxtTemplateSearch"
                                 Grid.Column="0"
                                 PlaceholderText="Search form templates..."
                                 TextChanged="TemplateSearch_TextChanged" />

                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="NewTemplate_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="New Form" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Category Filter Dropdown -->
                    <Grid Grid.Row="1" Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="CmbCategoryFilter"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="CategoryFilter_SelectionChanged">
                            <ComboBoxItem Content="All Categories" />
                            <ComboBoxItem Content="Jobs &amp; Exams" />
                            <ComboBoxItem Content="Identity &amp; Tax" />
                            <ComboBoxItem Content="Scholarships" />
                            <ComboBoxItem Content="Govt Schemes" />
                            <ComboBoxItem Content="Online Services" />
                        </ComboBox>
                    </Grid>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ApplicationTemplate">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,12" VerticalAlignment="Center"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind PortalUrl}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{x:Bind FormattedTotalFee}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Total Fee" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Template Editor & Inspector -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty State -->
                    <Border Visibility="{x:Bind local:ApplicationsPage.CollapsedIf(ViewModel.HasSelectedTemplate), Mode=OneWay}"
                            Padding="32" CornerRadius="8" Margin="0,40,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7C3;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="No Form Template Selected" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a template from the left or click 'New Form' to define a reusable scheme or exam registration."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="NewTemplate_Click" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create New Template" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Template Editor -->
                    <StackPanel Spacing="16" Visibility="{x:Bind local:ApplicationsPage.VisibleIf(ViewModel.HasSelectedTemplate), Mode=OneWay}">
                        <Border Padding="20" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <!-- Editor Header & Action Bar -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Form Template Details" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <!-- Start for Customer Action -->
                                        <Button Click="StartForCustomer_Click" ToolTipService.ToolTip="Link this form to an ongoing customer session">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Start for Customer" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout x:Name="FlyoutStartForCustomer" Placement="Bottom" />
                                            </Button.Flyout>
                                        </Button>

                                        <Button Click="DeleteTemplate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="Delete" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource AccentButtonStyle}" Click="SaveTemplate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                <TextBlock loc:Loc.Key="Common.Save" Text="Save Template" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <!-- Section 1: Basic Information -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Basic Information" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    
                                    <TextBox Header="Form / Scheme Title *"
                                             Text="{x:Bind ViewModel.SelectedTemplate.Title, Mode=TwoWay}"
                                             PlaceholderText="e.g. SSC CGL 2026, PAN Card Form 49A, PM Kisan" />

                                    <Grid ColumnDefinitions="*,*">
                                        <TextBox Grid.Column="0"
                                                 Header="Category"
                                                 Text="{x:Bind ViewModel.SelectedTemplate.Category, Mode=TwoWay}"
                                                 PlaceholderText="e.g. Jobs &amp; Exams, Identity &amp; Tax"
                                                 Margin="0,0,8,0" />

                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="8,0,0,0">
                                            <TextBox Grid.Column="0"
                                                     Header="Official Portal URL"
                                                     Text="{x:Bind ViewModel.SelectedTemplate.PortalUrl, Mode=TwoWay}"
                                                     PlaceholderText="https://..."
                                                     Margin="0,0,6,0" />
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="TestPortal_Click" ToolTipService.ToolTip="Visit Portal in Browser">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- Section 2: Default Charges -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Default Charges &amp; Fees" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <Grid ColumnDefinitions="*,*,*">
                                        <NumberBox Grid.Column="0"
                                                   Header="Shop Service Fee (₹)"
                                                   Value="{x:Bind ViewModel.SelectedTemplate.DefaultServiceFeeDouble, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Margin="0,0,6,0" />

                                        <NumberBox Grid.Column="1"
                                                   Header="Govt Fee (₹)"
                                                   Value="{x:Bind ViewModel.SelectedTemplate.DefaultGovtFeeDouble, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Margin="6,0,6,0" />

                                        <Border Grid.Column="2" Margin="6,0,0,0" Padding="12,8" CornerRadius="6"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="Total Customer Fee" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.FormattedTotalFee, Mode=OneWay}"
                                                           FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Section 3: Required Documents with 1-Click Common Chips -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Required Documents Checklist" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Click chip to add or remove" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <!-- Quick-Add Document Chips -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="QuickDocChipsPanel" Orientation="Horizontal" Spacing="6" Margin="0,2,0,4">
                                            <!-- Dynamically populated or rendered chips -->
                                        </StackPanel>
                                    </ScrollViewer>

                                    <TextBox x:Name="TxtRequiredDocs"
                                             Header="Document List (Comma-separated)"
                                             Text="{x:Bind ViewModel.SelectedTemplate.RequiredDocs, Mode=TwoWay}"
                                             PlaceholderText="Photo, Signature, Aadhaar, Marksheet..." />
                                </StackPanel>

                                <!-- Section 4: Instructions & Guidelines -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Operator Instructions &amp; Guidelines (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedTemplate.Notes, Mode=TwoWay}"
                                             PlaceholderText="Important requirements, photo dimensions, or cutoff dates"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="75" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

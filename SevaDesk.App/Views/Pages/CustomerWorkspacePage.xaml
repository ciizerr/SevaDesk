<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.CustomerWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Customer Profile Card -->
        <Border Grid.Row="0" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Padding="20,16">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Top Row: Back button, Avatar, Details, and Action Buttons -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
                    <!-- Back Button -->
                    <Button Grid.Column="0" Click="BackButton_Click"
                            Style="{StaticResource AlternateCloseButtonStyle}" Background="Transparent"
                            BorderThickness="0" Width="38" Height="38" CornerRadius="19"
                            VerticalAlignment="Top" ToolTipService.ToolTip="Back to Customers">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>

                    <!-- Customer Photo Avatar with quick change/remove -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <PersonPicture Width="68" Height="68"
                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(ViewModel.Customer.PhotoPath), Mode=OneWay}"
                                       Initials="{x:Bind ViewModel.Customer.Initials, Mode=OneWay}" />
                        <!-- Change / Remove Photo Badge Button -->
                        <Button Click="AvatarPhoto_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="26" Height="26" CornerRadius="13" Padding="0" Margin="0,0,-4,-4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="Change or Remove Profile Photo">
                            <FontIcon Glyph="&#xE722;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Name, Badges, and Contact Chips -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                        <!-- Name + Code -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Customer.Name, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                            <Border CornerRadius="4" Padding="7,2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Customer.Code, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Contact & ID Chips -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Phone Chip + WhatsApp + Copy -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Mobile), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE717;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.Mobile, Mode=OneWay}" FontSize="12" />

                                    <!-- WhatsApp Button -->
                                    <Button Click="WhatsApp_Click" Padding="4,2" CornerRadius="4"
                                            ToolTipService.ToolTip="Chat on WhatsApp"
                                            Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfCanWhatsApp(ViewModel.Customer.Mobile), Mode=OneWay}"
                                            Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE717;" FontSize="9" Foreground="#10B981" />
                                            <TextBlock Text="WhatsApp" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy Phone Button -->
                                    <Button Click="CopyPhone_Click" Width="22" Height="22" Padding="0" CornerRadius="3"
                                            ToolTipService.ToolTip="Copy phone number">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Village Chip -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Village), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="#10B981" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.Village, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- ID Reference Chip -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.IdReference), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="11" Foreground="#8B5CF6" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.FormattedMaskedId, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons: Start Session, New Bill, Folder, Edit, Delete -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Start Session (Primary Accent) -->
                        <Button Click="StartSession_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Start counter session for this customer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                <TextBlock loc:Loc.Key="CustomerProfile.StartSessionBtn" Text="Start Session" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Direct New Bill in POS -->
                        <Button Click="NewBill_Click" ToolTipService.ToolTip="Create direct counter bill in POS">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock loc:Loc.Key="CustomerProfile.NewBillBtn" Text="New Bill" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Open Folder in Explorer -->
                        <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open customer working folder in Windows Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="12" />
                                <TextBlock loc:Loc.Key="CustomerProfile.FolderBtn" Text="Folder" />
                            </StackPanel>
                        </Button>

                        <!-- Edit Profile -->
                        <Button Click="EditCustomer_Click" ToolTipService.ToolTip="Edit customer profile">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                <TextBlock loc:Loc.Key="CustomerProfile.EditBtn" Text="Edit" />
                            </StackPanel>
                        </Button>

                        <!-- More Menu (with Delete) -->
                        <Button Width="32" Height="32" Padding="0" CornerRadius="4" ToolTipService.ToolTip="More options">
                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem loc:Loc.Key="CustomerProfile.StartSessionBtn" Text="Start Session" Click="StartSession_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem loc:Loc.Key="CustomerProfile.NewBillBtn" Text="Create New Bill" Click="NewBill_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem loc:Loc.Key="CustomerProfile.FolderBtn" Text="Open Folder in Explorer" Click="OpenFolder_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED25;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem loc:Loc.Key="CustomerProfile.CopyPhoneBtn" Text="Copy Phone Number" Click="CopyPhone_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Key="CustomerProfile.DeleteBtn" Text="Delete Customer" Click="DeleteCustomer_Click"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Bottom Stats & Notes Strip -->
                <Grid Grid.Row="1" Margin="54,12,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <!-- Stat Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Total Visits -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock loc:Loc.Key="CustomerProfile.VisitsLabel" Text="Visits:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalVisits, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <!-- Total Spent -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock loc:Loc.Key="CustomerProfile.SpentLabel" Text="Total Billed:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTotalSpent, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Last Active -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock loc:Loc.Key="CustomerProfile.LastActiveLabel" Text="Last Active:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastVisitText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Customer Notes (if present) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Notes), Mode=OneWay}">
                        <FontIcon Glyph="&#xE70B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Customer.Notes, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="16">
            
            <!-- Left: Documents & Files -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header with Search & Import -->
                    <Grid Grid.Row="0" Padding="16,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock loc:Loc.Key="CustomerProfile.FilesHeader" Text="Documents &amp; Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border CornerRadius="10" Padding="8,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.TotalFileCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <!-- Subtle Backup Archive Badge -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(ViewModel.IsShowingBackup), Mode=OneWay}"
                                    ToolTipService.ToolTip="Working folder was cleaned up; viewing archived files from Backup folder">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock loc:Loc.Key="CustomerProfile.BackupArchiveBadge" Text="Backup Archive" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Search and Import Toolbar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <AutoSuggestBox
                                Width="180"
                                loc:Loc.PlaceholderKey="CustomerProfile.SearchFilesPlaceholder"
                                PlaceholderText="Search customer files..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.FileSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Click="ImportFiles_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Import documents into customer folder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    <TextBlock loc:Loc.Key="CustomerProfile.AddFilesBtn" Text="Add Files" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Click="OpenFolder_Click"
                                    ToolTipService.ToolTip="Open folder in Windows Explorer"
                                    Background="Transparent" BorderBrush="Transparent" Padding="6">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Grouped File List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(ViewModel.HasFiles), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredFolderGroups, Mode=OneWay}" Padding="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderGroup">
                                    <StackPanel>
                                        <!-- Folder Section Header -->
                                        <Grid Padding="16,10,16,6" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="13"
                                                      Foreground="{x:Bind AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind FolderName}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="8" Padding="6,1"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind FileCount}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <!-- File Rows -->
                                        <ItemsControl ItemsSource="{x:Bind Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:FolderFileItem">
                                                    <Grid ColumnDefinitions="*,110,130,Auto" Padding="16,9"
                                                          Background="Transparent"
                                                          DoubleTapped="CustomerFileRow_DoubleTapped" Tag="{x:Bind}"
                                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                             <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{x:Bind GlyphColor}" />
                                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedDate}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                        <!-- Per-file action buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <Button Click="OpenFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Open">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            </Button>
                                                            <Button Click="SmartTagFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Smart Tag &amp; Rename">
                                                                <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="#F59E0B" />
                                                            </Button>
                                                            <Button Click="DeleteFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Delete">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Blank State for Files (Centered) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="32"
                                Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(ViewModel.HasFiles), Mode=OneWay}">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C3;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock loc:Loc.Key="CustomerProfile.NoFilesFound" Text="No files found for this customer" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock loc:Loc.Key="CustomerProfile.NoFilesSub" Text="Click 'Add Files' or copy documents into the customer's folder." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                        <Button Click="ImportFiles_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                <TextBlock loc:Loc.Key="CustomerProfile.AddFilesBtn" Text="Add Files" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Sidebar: Full-Height Segmented Activity Hub -->
            <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Segmented Activity Switcher (Pill Layout with Zero Clipping) -->
                    <Border Grid.Row="0" Padding="8,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Button Grid.Column="0" Click="ActivityTabBtn_Click" Tag="0" HorizontalAlignment="Stretch" Padding="0,6"
                                    Background="{x:Bind local:CustomerWorkspacePage.TabSegmentBackground(ViewModel.SelectedActivityTab, 0), Mode=OneWay}"
                                    BorderBrush="{x:Bind local:CustomerWorkspacePage.TabSegmentBorder(ViewModel.SelectedActivityTab, 0), Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="11" Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 0), Mode=OneWay}" />
                                    <TextBlock Text="Bills" FontSize="12" FontWeight="{x:Bind local:CustomerWorkspacePage.TabSegmentFontWeight(ViewModel.SelectedActivityTab, 0), Mode=OneWay}"
                                               Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 0), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="ActivityTabBtn_Click" Tag="1" HorizontalAlignment="Stretch" Padding="0,6"
                                    Background="{x:Bind local:CustomerWorkspacePage.TabSegmentBackground(ViewModel.SelectedActivityTab, 1), Mode=OneWay}"
                                    BorderBrush="{x:Bind local:CustomerWorkspacePage.TabSegmentBorder(ViewModel.SelectedActivityTab, 1), Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 1), Mode=OneWay}" />
                                    <TextBlock Text="Sessions" FontSize="12" FontWeight="{x:Bind local:CustomerWorkspacePage.TabSegmentFontWeight(ViewModel.SelectedActivityTab, 1), Mode=OneWay}"
                                               Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 1), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="ActivityTabBtn_Click" Tag="2" HorizontalAlignment="Stretch" Padding="0,6"
                                    Background="{x:Bind local:CustomerWorkspacePage.TabSegmentBackground(ViewModel.SelectedActivityTab, 2), Mode=OneWay}"
                                    BorderBrush="{x:Bind local:CustomerWorkspacePage.TabSegmentBorder(ViewModel.SelectedActivityTab, 2), Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE81C;" FontSize="11" Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 2), Mode=OneWay}" />
                                    <TextBlock Text="Timeline" FontSize="12" FontWeight="{x:Bind local:CustomerWorkspacePage.TabSegmentFontWeight(ViewModel.SelectedActivityTab, 2), Mode=OneWay}"
                                               Foreground="{x:Bind local:CustomerWorkspacePage.TabSegmentForeground(ViewModel.SelectedActivityTab, 2), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab 0: Bills & Receipts -->
                    <Grid Grid.Row="1" Visibility="{x:Bind local:CustomerWorkspacePage.TabVisibility(ViewModel.SelectedActivityTab, 0), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.Payments, Mode=OneWay}"
                                  IsItemClickEnabled="True" ItemClick="PaymentItem_Click" SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasPayments, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Payment">
                                    <Border CornerRadius="6" Margin="8,4" Padding="12,10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="Click to view full receipt, thermal slip &amp; WhatsApp">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <!-- Top Row: Date & Amount -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind local:CustomerWorkspacePage.FormatPaymentDate(PaymentDate)}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind local:CustomerWorkspacePage.FormatRupee(Amount)}"
                                                           FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Middle Row: Invoice No & Payment Method -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border CornerRadius="3" Padding="4,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <Border CornerRadius="3" Padding="4,1" Background="#1810B981">
                                                    <TextBlock Text="{x:Bind PaymentMethod}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Bottom Row: Billed Items Chips -->
                                            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                <ItemsControl ItemsSource="{x:Bind BilledItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BilledServiceItem">
                                                            <Border CornerRadius="6" Padding="6,2" Background="{x:Bind local:CustomerWorkspacePage.ItemBadgeBackground(IsDiscount)}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="9" Foreground="{x:Bind local:CustomerWorkspacePage.ItemGlyphForeground(IsDiscount)}" />
                                                                    <TextBlock Text="{x:Bind DisplayChipText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:CustomerWorkspacePage.ItemTextForeground(IsDiscount)}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Blank State for Bills (Centered) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24"
                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(ViewModel.HasPayments), Mode=OneWay}">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C7;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock loc:Loc.Key="CustomerProfile.NoBills" Text="No bills or receipts recorded" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="Quick bills and counter receipts will show here." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button Click="NewBill_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="11" />
                                    <TextBlock loc:Loc.Key="CustomerProfile.NewBillBtn" Text="New Bill" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tab 1: Counter Sessions -->
                    <Grid Grid.Row="1" Visibility="{x:Bind local:CustomerWorkspacePage.TabVisibility(ViewModel.SelectedActivityTab, 1), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.SessionHistory, Mode=OneWay}"
                                  IsItemClickEnabled="True" ItemClick="SessionHistory_ItemClick" SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomerSessionRowModel">
                                    <Border CornerRadius="6" Margin="8,4" Padding="12,10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="Click to view details or receipt">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <!-- Top Row: Date/Time + Status Badge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate}" FontWeight="SemiBold" FontSize="12" />
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle Row: Work Summary / Services Chips -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                <ItemsControl ItemsSource="{x:Bind BilledItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BilledServiceItem">
                                                            <Border CornerRadius="6" Padding="6,2" Background="{x:Bind local:CustomerWorkspacePage.ItemBadgeBackground(IsDiscount)}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="9" Foreground="{x:Bind local:CustomerWorkspacePage.ItemGlyphForeground(IsDiscount)}" />
                                                                    <TextBlock Text="{x:Bind DisplayChipText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:CustomerWorkspacePage.ItemTextForeground(IsDiscount)}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Bottom Row: Duration + Amount / Billing Status -->
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <!-- Duration -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedDuration}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>

                                                <!-- Amount / Billing Status -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind AmountText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                               Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(HasPayment)}" />
                                                    <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(HasPayment)}">
                                                        <TextBlock loc:Loc.Key="CustomerProfile.Unbilled" Text="Unbilled" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Blank State for Sessions (Centered) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24"
                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(ViewModel.HasSessions), Mode=OneWay}">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE916;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock loc:Loc.Key="CustomerProfile.NoSessions" Text="No past sessions recorded" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="Active desk sessions will be saved here." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button Click="StartSession_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="11" />
                                    <TextBlock loc:Loc.Key="CustomerProfile.StartSessionBtn" Text="Start Session" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tab 2: All Activity (Timeline) -->
                    <Grid Grid.Row="1" Visibility="{x:Bind local:CustomerWorkspacePage.TabVisibility(ViewModel.SelectedActivityTab, 2), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.TimelineItems, Mode=OneWay}"
                                  IsItemClickEnabled="True" ItemClick="TimelineItem_Click" SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasTimelineItems, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomerTimelineItemModel">
                                    <Border CornerRadius="6" Margin="8,4" Padding="12,10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="Click to view details or receipt">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                            <!-- Icon Badge -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{x:Bind GlyphColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SecondaryInfo}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!-- Tag Badge -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TagText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Blank State for Timeline (Centered) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24"
                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(ViewModel.HasTimelineItems), Mode=OneWay}">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock loc:Loc.Key="CustomerProfile.NoActivity" Text="No activity recorded yet" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="Bills and counter visits will appear in this timeline." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>


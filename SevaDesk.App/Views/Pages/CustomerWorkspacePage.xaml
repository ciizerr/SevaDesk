<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.CustomerWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Customer Profile Card -->
        <Border Grid.Row="0" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Padding="20,16">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Top Row: Back button, Avatar, Details, and Action Buttons -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
                    <!-- Back Button -->
                    <Button Grid.Column="0" Click="BackButton_Click"
                            Style="{StaticResource AlternateCloseButtonStyle}" Background="Transparent"
                            BorderThickness="0" Width="38" Height="38" CornerRadius="19"
                            VerticalAlignment="Top" ToolTipService.ToolTip="Back to Customers">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>

                    <!-- Customer Photo Avatar with quick change/remove -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <PersonPicture Width="68" Height="68"
                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(ViewModel.Customer.PhotoPath), Mode=OneWay}"
                                       Initials="{x:Bind ViewModel.Customer.Initials, Mode=OneWay}" />
                        <!-- Change / Remove Photo Badge Button -->
                        <Button Click="AvatarPhoto_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="26" Height="26" CornerRadius="13" Padding="0" Margin="0,0,-4,-4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="Change or Remove Profile Photo">
                            <FontIcon Glyph="&#xE722;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Name, Badges, and Contact Chips -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                        <!-- Name + Code -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Customer.Name, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                            <Border CornerRadius="4" Padding="7,2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Customer.Code, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Contact & ID Chips -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Phone Chip -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Mobile), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE717;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.Mobile, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Village Chip -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Village), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="#10B981" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.Village, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- ID Reference Chip -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="8,4"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.IdReference), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="11" Foreground="#8B5CF6" />
                                    <TextBlock Text="{x:Bind ViewModel.Customer.FormattedMaskedId, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons: Edit Details, Folder, Start Session, Delete -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="EditCustomer_Click" ToolTipService.ToolTip="Edit Customer Details">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.OpenCustomerFolderCommand}" ToolTipService.ToolTip="Open in Windows Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="13" />
                                <TextBlock Text="Folder" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.StartSessionCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="Start Session" />
                            </StackPanel>
                        </Button>
                        <Button Click="DeleteCustomer_Click" ToolTipService.ToolTip="Delete Customer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Bottom Stats & Notes Strip -->
                <Grid Grid.Row="1" Margin="54,12,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <!-- Stat Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Total Visits -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Visits:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalVisits, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <!-- Total Spent -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Spent:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTotalSpent, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Last Active -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Last Active:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastVisitText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Customer Notes (if present) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind local:CustomerWorkspacePage.VisibleIfHasText(ViewModel.Customer.Notes), Mode=OneWay}">
                        <FontIcon Glyph="&#xE70B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Customer.Notes, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="16">
            
            <!-- Left: Files (Primary Focus) -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Documents &amp; Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border CornerRadius="10" Padding="8,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.TotalFileCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <!-- Subtle Backup Archive Badge -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(ViewModel.IsShowingBackup), Mode=OneWay}"
                                    ToolTipService.ToolTip="Working folder was cleaned up; viewing archived files from Backup folder">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Backup Archive" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenCustomerFolderCommand}"
                                ToolTipService.ToolTip="Open folder in Windows Explorer"
                                Background="Transparent" BorderBrush="Transparent" Padding="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- Grouped File List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind local:CustomerWorkspacePage.HasItemsVisibility(ViewModel.FolderGroups.Count), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FolderGroups, Mode=OneWay}" Padding="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderGroup">
                                    <StackPanel>
                                        <!-- Folder Section Header -->
                                        <Grid Padding="16,10,16,6" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="13"
                                                      Foreground="{x:Bind AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind FolderName}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="8" Padding="6,1"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind FileCount}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <!-- File Rows -->
                                        <ItemsControl ItemsSource="{x:Bind Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:FolderFileItem">
                                                    <Grid ColumnDefinitions="*,110,130,Auto" Padding="16,9"
                                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{x:Bind GlyphColor}" />
                                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedDate}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                        <!-- Per-file action buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <Button Click="OpenFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Open">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            </Button>
                                                            <Button Click="SmartTagFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Smart Tag &amp; Rename">
                                                                <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="#F59E0B" />
                                                            </Button>
                                                            <Button Click="DeleteFile_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Delete">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Blank State for Files -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                                Visibility="{x:Bind local:CustomerWorkspacePage.EmptyListVisibility(ViewModel.FolderGroups.Count), Mode=OneWay}">
                        <FontIcon Glyph="&#xE7C3;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No files found for this customer" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Command="{x:Bind ViewModel.OpenCustomerFolderCommand}">Open Folder</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Sidebar: Sessions & Payments -->
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="16">
                <!-- Session History -->
                <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Padding="16,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Session History" FontWeight="SemiBold" FontSize="13" />
                                <Border CornerRadius="8" Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.SessionHistory.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Sessions List -->
                        <ListView Grid.Row="1" x:Name="SessionHistoryList" ItemsSource="{x:Bind ViewModel.SessionHistory, Mode=OneWay}"
                                  IsItemClickEnabled="True" ItemClick="SessionHistory_ItemClick" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomerSessionRowModel">
                                    <Border CornerRadius="6" Margin="0,2"
                                            Background="{x:Bind local:CustomerWorkspacePage.SessionHighlightBackground(IsHighlighted), Mode=OneWay}"
                                            BorderBrush="{x:Bind local:CustomerWorkspacePage.SessionHighlightBorder(IsHighlighted), Mode=OneWay}"
                                            BorderThickness="{x:Bind local:CustomerWorkspacePage.SessionHighlightThickness(IsHighlighted), Mode=OneWay}">
                                        <Grid Padding="14,10" RowDefinitions="Auto,Auto,Auto" RowSpacing="5"
                                              Background="Transparent">
                                            <!-- Top Row: Date/Time + Status Badge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate}" FontWeight="SemiBold" FontSize="12" />
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle Row: Work Done Summary / Services Chips -->
                                            <ScrollViewer Grid.Row="1"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Enabled"
                                                          VerticalScrollMode="Disabled">
                                                <ItemsControl ItemsSource="{x:Bind BilledItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BilledServiceItem">
                                                            <Border CornerRadius="8" Padding="7,2"
                                                                    Background="{x:Bind local:CustomerWorkspacePage.ItemBadgeBackground(IsDiscount)}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="10"
                                                                              Foreground="{x:Bind local:CustomerWorkspacePage.ItemGlyphForeground(IsDiscount)}" />
                                                                    <TextBlock Text="{x:Bind DisplayChipText}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{x:Bind local:CustomerWorkspacePage.ItemTextForeground(IsDiscount)}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Bottom Row: Duration Chip + Amount Paid Chip -->
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <!-- Duration -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedDuration}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>

                                                <!-- Amount / Billing Status -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind AmountText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                               Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(HasPayment)}" />
                                                    <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(HasPayment)}">
                                                        <TextBlock Text="Unbilled" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Blank State for Sessions -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,20"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.EmptyListVisibility(ViewModel.SessionHistory.Count), Mode=OneWay}">
                            <FontIcon Glyph="&#xE916;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No past sessions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Payments -->
                <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Padding="16,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Recent Payments" FontWeight="SemiBold" FontSize="13" />
                                <Border CornerRadius="8" Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Payments.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="PaymentsList" ItemsSource="{x:Bind ViewModel.Payments, Mode=OneWay}"
                                  IsItemClickEnabled="True" ItemClick="PaymentItem_Click" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Payment">
                                    <Grid Padding="14,10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <!-- Top Row: Date & Amount -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind local:CustomerWorkspacePage.FormatPaymentDate(PaymentDate)}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:CustomerWorkspacePage.FormatRupee(Amount)}"
                                                       FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Middle Row: Invoice No & Payment Method -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind PaymentMethod}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Bottom Row: Billed Items Chips -->
                                        <ScrollViewer Grid.Row="2"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Enabled"
                                                      VerticalScrollMode="Disabled">
                                            <ItemsControl ItemsSource="{x:Bind BilledItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:BilledServiceItem">
                                                        <Border CornerRadius="8" Padding="7,2"
                                                                Background="{x:Bind local:CustomerWorkspacePage.ItemBadgeBackground(IsDiscount)}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="10"
                                                                          Foreground="{x:Bind local:CustomerWorkspacePage.ItemGlyphForeground(IsDiscount)}" />
                                                                <TextBlock Text="{x:Bind DisplayChipText}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Bind local:CustomerWorkspacePage.ItemTextForeground(IsDiscount)}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Blank State for Payments -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,20"
                                    Visibility="{x:Bind local:CustomerWorkspacePage.EmptyListVisibility(ViewModel.Payments.Count), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C7;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No payments recorded" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

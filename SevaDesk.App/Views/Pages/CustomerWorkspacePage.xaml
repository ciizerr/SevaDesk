<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.CustomerWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource AlternateCloseButtonStyle}" Background="Transparent" BorderThickness="0" Width="40" Height="40" CornerRadius="20" ToolTipService.ToolTip="Back to Customers">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <PersonPicture Width="56" Height="56" Initials="{x:Bind ViewModel.Customer.Initials, Mode=OneWay}" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Customer.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Customer.Code, Mode=OneWay}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Customer.Mobile, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Customer.Village, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.OpenCustomerFolderCommand}" ToolTipService.ToolTip="Open in Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock Text="Folder" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.StartSessionCommand}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Start Session" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="16">
            
            <!-- Left: Files (Primary Focus) -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                        <TextBlock Text="Documents &amp; Files" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FolderFiles, Mode=OneWay}" 
                              SelectionMode="Single" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView.Header>
                            <Grid Padding="16,8" ColumnDefinitions="*,120,150" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="Name" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Size" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="Modified" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FolderFileItem">
                                <Grid ColumnDefinitions="*,120,150" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Medium" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedDate}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    
                    <!-- Blank State for Files -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                                Visibility="{x:Bind local:CustomerWorkspacePage.EmptyListVisibility(ViewModel.FolderFiles.Count), Mode=OneWay}">
                        <FontIcon Glyph="&#xE7C3;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No files found for this customer" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Command="{x:Bind ViewModel.OpenCustomerFolderCommand}">Open Folder</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Sidebar: Sessions & Payments -->
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="16">
                <!-- Session History -->
                <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                            <TextBlock Text="Session History" FontWeight="SemiBold" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Session">
                                    <StackPanel Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding StartedAt}" FontWeight="Medium"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DurationSeconds}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                
                <!-- Payments -->
                <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8,8,0,0">
                            <TextBlock Text="Recent Payments" FontWeight="SemiBold" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Payments, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Payment">
                                    <Grid Padding="16,12" ColumnDefinitions="*,Auto" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding PaymentDate}" FontWeight="Medium"/>
                                            <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Amount}" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{x:Bind PaymentMethod}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

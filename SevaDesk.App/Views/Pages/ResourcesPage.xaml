<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">
        <!-- Header & Search Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Resources.Title" Text="Templates &amp; Offline Resources" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Resources.Subtitle"
                           Text="Ready-to-print legal affidavits, blank government forms, and cyber café rate notices"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <AutoSuggestBox Width="260"
                                loc:Loc.PlaceholderKey="Resources.SearchPlaceholder"
                                PlaceholderText="Search templates, forms..." QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Style="{StaticResource AccentButtonStyle}" Click="AddNewResource_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Resources.AddBtn" Text="Add Template" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Category Filter Chips & Status Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Click="CategoryAll_Click">
                    <TextBlock loc:Loc.Key="Resources.FilterAll" Text="All Resources" FontWeight="SemiBold" FontSize="12" />
                </Button>
                <Button Click="CategoryAffidavits_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C1;" FontSize="12" Foreground="#8B5CF6" />
                        <TextBlock loc:Loc.Key="Resources.FilterAffidavits" Text="Affidavits" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="CategoryForms_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#3B82F6" />
                        <TextBlock loc:Loc.Key="Resources.FilterForms" Text="Blank Forms" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="CategoryGuidelines_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="12" Foreground="#10B981" />
                        <TextBlock loc:Loc.Key="Resources.FilterGuidelines" Text="Guidelines" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>


        </Grid>

        <!-- 2 Column Layout: Resources Catalog on Left, Template Inspector on Right -->
        <Grid Grid.Row="2" ColumnDefinitions="*,380" ColumnSpacing="16">
            <!-- Left: Resources Catalog Grid -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView ItemsSource="{x:Bind ViewModel.FilteredResources, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ResourceItem">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="14,12" VerticalAlignment="Center"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FileType}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FileSize}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Favorite Button -->
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Margin="0,0,8,0"
                                        Click="ToggleFavorite_Click" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE735;" FontSize="14"
                                              Foreground="{x:Bind StarForeground, Mode=OneWay}" />
                                </Button>

                                <!-- Quick Print Button -->
                                <Button Grid.Column="3" Click="QuickPrint_Click" Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE749;" FontSize="12" />
                                        <TextBlock loc:Loc.Key="Settings.Hardware.RatesHeader" Text="Print" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right: Template Inspector & Direct Folder Injector -->
            <Border Grid.Column="1" Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Border Width="64" Height="64" CornerRadius="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                        <FontIcon Glyph="{x:Bind ViewModel.SelectedResource.Glyph, Mode=OneWay}" FontSize="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedResource.Title, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedResource.Category, Mode=OneWay}"
                                           FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedResource.FileType, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Cyber Café Operator Instructions:" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Standard template verified for government acceptance. Print directly or inject copy into the customer's working folder for custom details editing."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="InspectorPrint_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE749;" FontSize="14" />
                                <TextBlock Text="Quick Print to Counter Printer" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" Click="InspectorCopyToFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                <TextBlock Text="Copy to Active Customer Folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

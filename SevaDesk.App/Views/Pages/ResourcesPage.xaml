<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">
        <!-- Header & Search Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Key="Resources.Title" Text="Offline Forms &amp; Resources" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock loc:Loc.Key="Resources.Subtitle"
                           Text="Ready-to-print legal affidavits, blank government forms, guidelines, and document checklists"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <AutoSuggestBox Width="260"
                                loc:Loc.PlaceholderKey="Resources.SearchPlaceholder"
                                PlaceholderText="Search templates, forms..." QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Search templates and forms"
                                AutomationProperties.AutomationId="TxtSearchResources" />

                <Button Style="{StaticResource AccentButtonStyle}" Click="AddNewResource_Click"
                        AutomationProperties.Name="Add Template or Form"
                        AutomationProperties.AutomationId="BtnAddResource">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock loc:Loc.Key="Resources.AddBtn" Text="Add Template" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Category Filter Chips -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Click="CategoryAll_Click"
                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedCategory, 'All'), Mode=OneWay}"
                        AutomationProperties.Name="Filter all resources">
                    <TextBlock loc:Loc.Key="Resources.FilterAll" Text="All Resources" FontWeight="SemiBold" FontSize="12" />
                </Button>
                <Button Click="CategoryAffidavits_Click"
                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedCategory, 'Affidavits'), Mode=OneWay}"
                        AutomationProperties.Name="Filter affidavits">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C1;" FontSize="12" Foreground="#8B5CF6" />
                        <TextBlock loc:Loc.Key="Resources.FilterAffidavits" Text="Affidavits" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="CategoryForms_Click"
                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedCategory, 'Blank Forms'), Mode=OneWay}"
                        AutomationProperties.Name="Filter blank forms">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="#3B82F6" />
                        <TextBlock loc:Loc.Key="Resources.FilterForms" Text="Blank Forms" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="CategoryGuidelines_Click"
                        Style="{x:Bind FilterButtonStyle(ViewModel.SelectedCategory, 'Guidelines'), Mode=OneWay}"
                        AutomationProperties.Name="Filter guidelines">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="12" Foreground="#10B981" />
                        <TextBlock loc:Loc.Key="Resources.FilterGuidelines" Text="Guidelines" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2 Column Layout: Resources Catalog on Left, Template Inspector on Right -->
        <Grid Grid.Row="2" ColumnDefinitions="*,440" ColumnSpacing="16">
            <!-- Left: Resources Catalog Grid -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView ItemsSource="{x:Bind ViewModel.FilteredResources, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="ListView_SelectionChanged"
                          AutomationProperties.Name="Templates and resources list"
                          AutomationProperties.AutomationId="ListResources">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ResourceItem">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="14,12" VerticalAlignment="Center"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FileType}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FileSize}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Favorite Button -->
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Margin="0,0,6,0"
                                        Click="ToggleFavorite_Click" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Toggle favorite"
                                        AutomationProperties.Name="Toggle favorite">
                                    <FontIcon Glyph="&#xE735;" FontSize="14"
                                              Foreground="{x:Bind StarForeground, Mode=OneWay}" />
                                </Button>

                                <!-- Quick Open Button -->
                                <Button Grid.Column="3" Click="ListItemOpen_Click" Tag="{x:Bind}" Margin="0,0,6,0"
                                        ToolTipService.ToolTip="Open document in default viewer"
                                        AutomationProperties.Name="Open document">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </Button>

                                <!-- Quick Print Button -->
                                <Button Grid.Column="4" Click="QuickPrint_Click" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Print to counter printer"
                                        AutomationProperties.Name="Print document">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE749;" FontSize="12" />
                                        <TextBlock Text="Print" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right: Template Inspector & Direct Folder Injector -->
            <Border Grid.Column="1" Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Visibility="{x:Bind local:ResourcesPage.VisibleIfHasResource(ViewModel.SelectedResource), Mode=OneWay}">
                        
                        <!-- Header with Glyph, Title, Badges -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Top">
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="{x:Bind ViewModel.SelectedResource.Glyph, Mode=OneWay}" FontSize="24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedResource.Title, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedResource.Category, Mode=OneWay}"
                                                   FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedResource.FileType, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <!-- File Linked Status Badge -->
                                    <Border CornerRadius="4" Padding="6,2"
                                            Background="{x:Bind local:ResourcesPage.FileStatusBadgeBackground(ViewModel.SelectedResource.HasFile), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{x:Bind local:ResourcesPage.FileStatusBadgeGlyph(ViewModel.SelectedResource.HasFile), Mode=OneWay}"
                                                      FontSize="10" Foreground="{x:Bind local:ResourcesPage.FileStatusBadgeForeground(ViewModel.SelectedResource.HasFile), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedResource.FileStatusText, Mode=OneWay}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:ResourcesPage.FileStatusBadgeForeground(ViewModel.SelectedResource.HasFile), Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- File Path Display -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedResource.FileLocationDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedResource.FilePath, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Action Commands Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <!-- Row 0: Open Document & Open Folder Location -->
                            <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                    Click="InspectorOpen_Click" ToolTipService.ToolTip="Open in default application"
                                    AutomationProperties.Name="Open Document" AutomationProperties.AutomationId="BtnInspectorOpen">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock Text="Open Document" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                    Click="InspectorOpenFileLocation_Click" ToolTipService.ToolTip="Locate file in File Explorer"
                                    AutomationProperties.Name="Open File Location" AutomationProperties.AutomationId="BtnInspectorLocation">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="13" />
                                    <TextBlock Text="Open Location" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Row 1: Attach / Replace File & Quick Print -->
                            <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                    Click="InspectorAttachFile_Click" ToolTipService.ToolTip="Attach or update document file"
                                    AutomationProperties.Name="Attach or Replace File" AutomationProperties.AutomationId="BtnInspectorAttach">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                                    <TextBlock Text="Attach / Replace" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                    Click="InspectorPrint_Click" ToolTipService.ToolTip="Print to counter printer"
                                    AutomationProperties.Name="Quick Print" AutomationProperties.AutomationId="BtnInspectorPrint">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE749;" FontSize="13" />
                                    <TextBlock Text="Quick Print" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Row 2: Copy to Active Customer Session Folder -->
                            <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                                    Click="InspectorCopyToFolder_Click" ToolTipService.ToolTip="Copy file into active customer's Shared Docs folder"
                                    AutomationProperties.Name="Copy to Active Customer Folder" AutomationProperties.AutomationId="BtnInspectorCopy">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DE;" FontSize="13" />
                                    <TextBlock Text="Copy to Active Customer Folder" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Required Supporting Documents Section -->
                        <StackPanel Spacing="6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Required Supporting Documents" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Documents the applicant must attach with this form"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Checklist Chips Preview -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="RequiredDocsChipsPanel" Orientation="Horizontal" Spacing="6" />
                            </ScrollViewer>

                            <!-- Editable Comma-Separated Input -->
                            <TextBox Text="{x:Bind ViewModel.SelectedResource.RequiredDocs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="RequiredDocs_TextChanged"
                                     PlaceholderText="e.g. Aadhaar Card, Passport Photo, Marksheet, Ration Card..."
                                     AutomationProperties.Name="Required Supporting Documents"
                                     AutomationProperties.AutomationId="TxtRequiredDocs" />
                        </StackPanel>

                        <!-- Operator Guidelines & Checklist Notes -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Operator Guidelines &amp; Notes" FontWeight="SemiBold" FontSize="12" />
                            <TextBox Text="{x:Bind ViewModel.SelectedResource.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Stamp paper denomination (₹10/₹100), cutoff dates, attestation requirements..."
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                     AutomationProperties.Name="Operator Guidelines and Notes"
                                     AutomationProperties.AutomationId="TxtResourceNotes" />
                        </StackPanel>

                        <!-- Save Details Button -->
                        <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                Click="SaveDetails_Click"
                                AutomationProperties.Name="Save Template Details"
                                AutomationProperties.AutomationId="BtnSaveResourceDetails">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                <TextBlock Text="Save Changes &amp; Checklist" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

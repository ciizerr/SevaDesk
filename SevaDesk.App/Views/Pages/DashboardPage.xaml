<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:controls="using:SevaDesk_App.Views.Controls"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    xmlns:local="using:SevaDesk_App.Views.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="28">

            <!-- 1. Executive Greeting Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedDateText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="TogglePrivacy_Click" ToolTipService.ToolTip="{x:Bind ViewModel.PrivacyToggleToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind ViewModel.PrivacyToggleGlyph, Mode=OneWay}" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.PrivacyToggleText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewBill_Click" ToolTipService.ToolTip="Open Cashier &amp; Billing">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                            <TextBlock Text="New Bill / POS" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="NewCustomerSession_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Start Customer Session" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. KPI Business Summary Row (4 Columns) -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <!-- KPI 1: Today's Revenue -->
                <Border Grid.Column="0" Padding="16,14" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#1810B981" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C7;" FontSize="16" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Today's Revenue" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.FormattedTodayTotalSalesDisplay, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="26" Margin="0,10,0,4" Foreground="#10B981" />
                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="Cash: " /><Run Text="{x:Bind ViewModel.FormattedTodayCashSalesDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · UPI: " /><Run Text="{x:Bind ViewModel.FormattedTodayUpiSalesDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- KPI 2: Active Counter Sessions -->
                <Border Grid.Column="1" Padding="16,14" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#183B82F6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Active at Counter" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ActiveSessionsCount, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="26" Margin="0,10,0,4" />
                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" active · " />
                            <Run Text="{x:Bind ViewModel.PausedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" paused" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- KPI 3: Today's Visits -->
                <Border Grid.Column="2" Padding="16,14" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#188B5CF6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Today's Visits" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.TodayVisitsCount, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="26" Margin="0,10,0,4" />
                        <TextBlock Grid.Row="2" Text="Customers served today" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- KPI 4: Pending Tasks -->
                <Border Grid.Column="3" Padding="16,14" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#18F59E0B" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Pending Tasks" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.PendingTasksCount, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="26" Margin="0,10,0,4" Foreground="#F59E0B" />
                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind ViewModel.DocsReadyAppsCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" apps ready · " />
                            <Run Text="{x:Bind ViewModel.TotalPendingFiles, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" files pending" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Active Counter Sessions Section -->
            <StackPanel Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Active Counter Sessions" FontWeight="Bold" FontSize="18" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveSessionsCount, Mode=OneWay}" FontWeight="Bold" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Click="ViewAllSessions_Click" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="View All in Counter Console" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Cards Container (when active sessions exist) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                              Visibility="{x:Bind local:DashboardPage.VisibleIf(ViewModel.HasActiveSessions), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveSessions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ActiveSessionItem">
                                <Border Width="380" Margin="0,0,0,4" Padding="16" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <!-- Top Row: Avatar + Name + Code + Live Timer -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <PersonPicture Grid.Column="0" Width="42" Height="42"
                                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(Customer.PhotoPath), Mode=OneWay}"
                                                       Initials="{x:Bind Customer.Initials}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="Bold" FontSize="15" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind CustomerContactSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Live Timer Badge -->
                                        <Border Grid.Column="2" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"
                                                Background="{x:Bind local:DashboardPage.SessionBadgeBackground(Status), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind local:DashboardPage.SessionBadgeGlyph(Status), Mode=OneWay}" FontSize="11"
                                                          Foreground="{x:Bind local:DashboardPage.SessionBadgeForeground(Status), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ElapsedDisplay, Mode=OneWay}"
                                                           FontWeight="Bold" FontSize="12" FontFamily="Consolas"
                                                           Foreground="{x:Bind local:DashboardPage.SessionBadgeForeground(Status), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Middle Row: Linked Application Banner (if any) -->
                                    <Border CornerRadius="6" Padding="10,6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{x:Bind local:DashboardPage.VisibleIf(HasLinkedApplication), Mode=OneWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind LinkedApplicationTitle, Mode=OneWay}"
                                                       FontWeight="SemiBold" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,1"
                                                    Background="{x:Bind local:DashboardPage.AppStatusBackground(LinkedApplicationStatus), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind LinkedApplicationStatus, Mode=OneWay}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{x:Bind local:DashboardPage.AppStatusForeground(LinkedApplicationStatus), Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Row: File Stats & Actions -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FolderStats.TotalFiles}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="files" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Tag="{x:Bind}" Click="SessionFolder_Click" ToolTipService.ToolTip="Open folder in Explorer"
                                                    Padding="8,5">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                                    <TextBlock Text="Folder" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <Button Tag="{x:Bind}" Click="SessionCompleteAndBill_Click" Style="{StaticResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="Complete visit &amp; open cashier" Padding="10,5">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE8C7;" FontSize="12" />
                                                    <TextBlock Text="Bill &amp; Finish" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- More Flyout -->
                                            <Button Width="30" Height="30" Padding="0" CornerRadius="4" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="{x:Bind ToggleActionText, Mode=OneWay}" Tag="{x:Bind}" Click="SessionTogglePause_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="{x:Bind ToggleActionGlyph, Mode=OneWay}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Open in Counter Sessions" Tag="{x:Bind}" Click="SessionOpenInConsole_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE716;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete Session" Tag="{x:Bind}" Click="SessionDelete_Click"
                                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State (when 0 active sessions) -->
                <Border Padding="32" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{x:Bind local:DashboardPage.CollapsedIf(ViewModel.HasActiveSessions), Mode=OneWay}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No Customers Currently at the Desk" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="Start a customer session to isolate their files on the desktop, track their visit time, and auto-verify documents for online applications."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Style="{StaticResource AccentButtonStyle}" Click="NewCustomerSession_Click" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Start Customer Session" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. Lower 2-Column Split: Applications Ready to Submit + Recent Receipts -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Left Column: Applications Ready to Submit -->
                <Border Grid.Column="0" CornerRadius="10" Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Applications Ready to Submit" FontWeight="Bold" FontSize="15" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.PendingApplications.Count, Mode=OneWay}" FontWeight="Bold" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Click="ViewAllApplications_Click" Background="Transparent" BorderBrush="Transparent" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="View All" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Applications List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PendingApplications, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind local:DashboardPage.VisibleIf(ViewModel.HasPendingApplications), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ApplicationItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="8,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="4" Padding="6,1"
                                                        Background="{x:Bind local:DashboardPage.AppStatusBackground(Status)}">
                                                    <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{x:Bind local:DashboardPage.AppStatusForeground(Status)}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind CustomerName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind PortalName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedTotal}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Tag="{x:Bind}" Click="ApplicationOpenWorkspace_Click" ToolTipService.ToolTip="Open Customer Workspace" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                    <TextBlock Text="Workspace" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state if 0 apps -->
                        <StackPanel Grid.Row="1" Spacing="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind local:DashboardPage.CollapsedIf(ViewModel.HasPendingApplications), Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="#10B981" HorizontalAlignment="Center" />
                            <TextBlock Text="All caught up! No applications waiting for submission." FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Today's Recent Receipts -->
                <Border Grid.Column="1" CornerRadius="10" Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="#10B981" />
                                <TextBlock Text="Today's Receipts" FontWeight="Bold" FontSize="15" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:DashboardPage.VisibleIf(ViewModel.HasRecentPayments), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.TodayReceiptsCount, Mode=OneWay}"
                                               FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Click="ViewCashier_Click" Background="Transparent" BorderBrush="Transparent" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Open Cashier" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Recent Payments List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentPayments, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentPayment_ItemClick"
                                  MaxHeight="380"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind local:DashboardPage.VisibleIf(ViewModel.HasRecentPayments), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardRecentPaymentItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="8,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Padding="5,1"
                                                        Background="{x:Bind local:DashboardPage.PaymentModeBadgeBackground(PaymentMethod)}">
                                                    <TextBlock Text="{x:Bind PaymentMethod}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{x:Bind local:DashboardPage.PaymentModeBadgeForeground(PaymentMethod)}" />
                                                </Border>
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind local:DashboardPage.FormatPaymentTime(PaymentDate)}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedAmount, Mode=OneWay}"
                                                       FontWeight="Bold" FontSize="14" Foreground="#10B981" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state if 0 payments -->
                        <StackPanel Grid.Row="1" Spacing="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind local:DashboardPage.CollapsedIf(ViewModel.HasRecentPayments), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C7;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No transactions recorded yet today." FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

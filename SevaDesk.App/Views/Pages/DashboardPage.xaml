<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:controls="using:SevaDesk_App.Views.Controls"
    xmlns:vm="using:SevaDesk_App.ViewModels.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24">

            <!-- Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock loc:Loc.Key="Dashboard.Header" Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock loc:Loc.Key="Dashboard.Subheader" Text="Active customer visits and desktop working folders" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock loc:Loc.Key="Dashboard.RefreshBtn" Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="NewCustomerSession_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock loc:Loc.Key="Dashboard.StartSessionBtn" Text="Start Customer Session" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Stat Summary Cards Row -->
            <Grid ColumnDefinitions="*,*,*">
                <!-- Card 1: Active Sessions -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock loc:Loc.Key="Dashboard.ActiveSessions" Text="Active Sessions" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ActiveSessionsCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                        <TextBlock loc:Loc.Key="Dashboard.ActiveSessionsSub" Text="Customers currently at counter" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Unorganised Files -->
                <Border Grid.Column="1" Margin="4,0,4,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" />
                            <TextBlock loc:Loc.Key="Dashboard.PendingFiles" Text="Pending Files" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalPendingFiles, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                        <TextBlock loc:Loc.Key="Dashboard.PendingFilesSub" Text="Files in 00_Unorganised folders" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Desktop Status -->
                <Border Grid.Column="2" Margin="8,0,0,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" Foreground="#10B981" />
                            <TextBlock loc:Loc.Key="Dashboard.WorkingFolders" Text="Working Folders" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Desktop Active"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                        <TextBlock loc:Loc.Key="Dashboard.WorkingFoldersSub" Text="Synchronized &amp; retained for 24h" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Workspace: Active Sessions & Working Folder View -->
            <Grid ColumnDefinitions="360,*" MinHeight="420">
                <!-- Left: Sessions List -->
                <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock loc:Loc.Key="Dashboard.OngoingVisits" Text="Active Customer Visits" FontWeight="SemiBold" />
                        </Border>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.ActiveSessions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ActiveSessionItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" VerticalAlignment="Center">
                                        <PersonPicture Grid.Column="0" Width="36" Height="36"
                                                       ProfilePicture="{x:Bind loc:CustomerAvatarHelper.GetProfilePicture(Customer.PhotoPath), Mode=OneWay}"
                                                       Initials="{x:Bind Customer.Initials}" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Customer.Mobile}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <InfoBadge Grid.Column="2" Value="{x:Bind FolderStats.TotalFiles}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right: Selected Session Working Folder & Actions -->
                <Border Grid.Column="1" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasActiveSessions, Mode=OneWay}">
                        <!-- Customer Banner -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,12"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Name, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Code, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Status, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.ElapsedDisplay, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderPath, Mode=OneWay}"
                                           FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Session Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="DeleteSession_Click" ToolTipService.ToolTip="Delete accidental session"
                                        Background="Transparent" BorderBrush="Transparent" Padding="8,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                        <TextBlock Text="Delete" Foreground="#EF4444" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="FinishSession_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                        <TextBlock loc:Loc.Key="Common.Finish" Text="Finish Session" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive Working Subfolders Component -->
                        <controls:WorkingFolderBrowserControl x:Name="WorkingFolderBrowser" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

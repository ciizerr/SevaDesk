<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SevaDesk_App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:vm="using:SevaDesk_App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24">

            <!-- Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="Active customer visits and desktop working folders" Style="{StaticResource BodySubheaderTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="NewCustomerSession_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Start Customer Session" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Stat Summary Cards Row -->
            <Grid ColumnDefinitions="*,*,*">
                <!-- Card 1: Active Sessions -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                            <TextBlock Text="Active Sessions" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ActiveSessionsCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                        <TextBlock Text="Customers currently at counter" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Unorganised Files -->
                <Border Grid.Column="1" Margin="4,0,4,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" />
                            <TextBlock Text="Pending Files" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalPendingFiles, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                        <TextBlock Text="Files in 00_Unorganised folders" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Desktop Status -->
                <Border Grid.Column="2" Margin="8,0,0,0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" Foreground="#10B981" />
                            <TextBlock Text="Working Folders" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Desktop Active"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                        <TextBlock Text="Synchronized &amp; retained for 24h" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Workspace: Active Sessions & Working Folder View -->
            <Grid ColumnDefinitions="360,*" MinHeight="420">
                <!-- Left: Sessions List -->
                <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Active Customer Visits" FontWeight="SemiBold" />
                        </Border>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.ActiveSessions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ActiveSessionItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" VerticalAlignment="Center">
                                        <PersonPicture Grid.Column="0" Width="36" Height="36"
                                                       Initials="{x:Bind Customer.Initials}" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Customer.Code}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Customer.Mobile}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <InfoBadge Grid.Column="2" Value="{x:Bind FolderStats.TotalFiles}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right: Selected Session Working Folder & Actions -->
                <Border Grid.Column="1" CornerRadius="8" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasActiveSessions, Mode=OneWay}">
                        <!-- Customer Banner -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,12"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Name, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                    <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Customer.Code, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <InfoBadge Value="{x:Bind ViewModel.SelectedSession.Session.Status, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.FolderPath, Mode=OneWay}"
                                           FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Folder & Session Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="OpenDesktopFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="Open Desktop Folder" />
                                    </StackPanel>
                                </Button>
                                <Button Click="FinishSession_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" />
                                        <TextBlock Text="Finish Session" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 4 Working Subfolders Grid -->
                        <TextBlock Text="Customer Working Subfolders on Desktop" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <!-- 00_Unorganised -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="14" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" FontSize="15" />
                                            <TextBlock Text="00_Unorganised" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock Text="Fresh downloads &amp; raw scanner outputs" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Tag="00_Unorganised" Click="OpenSubfolder_Click">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 01_Shared Documents -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="14" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" Foreground="#06B6D4" FontSize="15" />
                                            <TextBlock Text="01_Shared Documents" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock Text="Aadhaar, Photo, Signature, Marks" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Tag="01_Shared Documents" Click="OpenSubfolder_Click">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 02_Applications -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" Padding="14" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE82D;" Foreground="#818CF8" FontSize="15" />
                                            <TextBlock Text="02_Applications" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock Text="PAN, SSC, UPSC, Scholarship forms" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Tag="02_Applications" Click="OpenSubfolder_Click">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 03_Ready to Print -->
                            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" Padding="14" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE749;" Foreground="#10B981" FontSize="15" />
                                            <TextBlock Text="03_Ready to Print" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock Text="Receipts &amp; print-ready output documents" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Tag="03_Ready to Print" Click="OpenSubfolder_Click">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

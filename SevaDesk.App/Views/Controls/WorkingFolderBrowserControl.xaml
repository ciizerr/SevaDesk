<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevaDesk_App.Views.Controls.WorkingFolderBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:local="using:SevaDesk_App.Views.Controls"
    xmlns:models="using:SevaDesk.Core.Models"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <!-- Subfolder Selector Strip -->
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" loc:Loc.Key="Sessions.WorkingSubfolders"
                       Text="Customer Working Subfolders on Desktop"
                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <Button Grid.Column="1" HorizontalAlignment="Right" Padding="8,4"
                    Click="AddSubfolder_Click" ToolTipService.ToolTip="Create New Application Subfolder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                    <TextBlock Text="New Subfolder" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Dynamic Subfolder Tiles / Pills -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SubfolderTilesPanel" Orientation="Horizontal" Spacing="10">
                <!-- 1. Unorganised Files (Root) Tile -->
                <Button x:Name="BtnTileUnorganised" Click="SubfolderTile_Click" Tag="Root"
                        Padding="14,10" MinWidth="180" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#FEF3C7" Margin="0,0,10,0">
                            <FontIcon Glyph="&#xE8B7;" Foreground="#F59E0B" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock loc:Loc.Key="Sessions.TileLooseFilesTitle" Text="Unorganised Files" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="Root Desktop" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Background="#FDE68A" Padding="8,2" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtUnorganisedBadge" Text="0" FontWeight="Bold" Foreground="#92400E" FontSize="11" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 2. Shared Docs Tile -->
                <Button x:Name="BtnTileShared" Click="SubfolderTile_Click" Tag="Shared Docs"
                        Padding="14,10" MinWidth="180" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#E0F2FE" Margin="0,0,10,0">
                            <FontIcon Glyph="&#xE8A5;" Foreground="#0284C7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock loc:Loc.Key="Sessions.TileSharedDocsTitle" Text="Shared Docs" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="Permanent" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Background="#BAE6FD" Padding="8,2" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtSharedBadge" Text="0" FontWeight="Bold" Foreground="#0369A1" FontSize="11" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Dynamic Application Subfolder Chips Container -->
                <ItemsControl x:Name="AppSubfoldersControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SubfolderItem">
                            <Button Click="AppSubfolderChip_Click" Tag="{x:Bind RelativePath}"
                                    Padding="14,10" MinWidth="160" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#F3E8FF" Margin="0,0,10,0">
                                        <FontIcon Glyph="&#xED25;" Foreground="#9333EA" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Application" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Background="#E9D5FF" Padding="8,2" Margin="6,0,0,0">
                                        <TextBlock Text="{x:Bind FileCount}" FontWeight="Bold" Foreground="#6B21A8" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Selected Subfolder File Manager Card -->
        <Border CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Padding="16,14">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <!-- Subfolder Header Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="CurrentFolderGlyph" Glyph="&#xE8B7;" FontSize="16" Foreground="#F59E0B" />
                        <TextBlock x:Name="TxtCurrentFolderName" Text="Unorganised Files (Root)" FontWeight="Bold" FontSize="15" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TxtFolderStatsSummary" Text="0 files" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Actions Toolbar: Explorer, Refresh, Add File -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="AddFile_Click" Style="{StaticResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="13" />
                                <TextBlock loc:Loc.Key="FolderBrowser.AddFile" Text="Add File" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Click="RefreshFolder_Click" ToolTipService.ToolTip="Refresh Folder">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                        <Button Click="OpenFolderInExplorer_Click" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Open in Windows Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                                <TextBlock loc:Loc.Key="FolderBrowser.OpenExplorer" Text="Open in Explorer" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- Empty State View -->
                <Border Grid.Row="2" x:Name="EmptyStateBorder" Visibility="Collapsed" Padding="32,24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock loc:Loc.Key="FolderBrowser.EmptyTitle" Text="No Files in this Subfolder"
                                       FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock loc:Loc.Key="FolderBrowser.EmptyDesc"
                                       Text="Save files here or move from incoming queue to organize them."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxWidth="340" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live File List -->
                <ListView Grid.Row="2" x:Name="FilesListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FolderFileItem">
                            <Grid Padding="8,8" Margin="0,0,0,4" CornerRadius="6"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                  ColumnDefinitions="Auto,*,Auto,Auto">

                                <!-- File Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                              Foreground="{x:Bind GlyphColor}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Normal Filename Display -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                            DoubleTapped="FileRow_DoubleTapped"
                                            Visibility="{x:Bind local:WorkingFolderBrowserControl.CollapsedIf(IsRenaming), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Inline Rename Editor -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                                      Visibility="{x:Bind local:WorkingFolderBrowserControl.VisibleIf(IsRenaming), Mode=OneWay}">
                                    <TextBox Grid.Column="0" Text="{x:Bind EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus"
                                             Loaded="RenameTextBox_Loaded"
                                             Tag="{x:Bind}" FontSize="13" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="SaveRename_Click" Tag="{x:Bind}"
                                            Style="{StaticResource AccentButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Save New Name (Enter)">
                                        <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                    </Button>
                                    <Button Grid.Column="2" Click="CancelRename_Click" Tag="{x:Bind}"
                                            Padding="8,4" ToolTipService.ToolTip="Cancel Rename (Esc)">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>

                                <!-- Quick Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <!-- Open in Default App -->
                                    <Button Click="OpenInDefaultApp_Click" Tag="{x:Bind}" Padding="6"
                                            Background="Transparent" BorderBrush="Transparent"
                                            ToolTipService.ToolTip="Open in Default Windows App">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>

                                    <!-- Smart Tag & Rename Button -->
                                    <Button Click="SmartTagButton_Click" Tag="{x:Bind}" Padding="6"
                                            Background="Transparent" BorderBrush="Transparent"
                                            ToolTipService.ToolTip="Quick Tag &amp; Smart Rename">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="#F59E0B" />
                                    </Button>

                                    <!-- Rename Button -->
                                    <Button Click="StartRename_Click" Tag="{x:Bind}" Padding="6"
                                            Background="Transparent" BorderBrush="Transparent"
                                            ToolTipService.ToolTip="Rename File (F2)">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>

                                    <!-- Delete File -->
                                    <Button Click="DeleteFile_Click" Tag="{x:Bind}" Padding="6"
                                            Background="Transparent" BorderBrush="Transparent"
                                            ToolTipService.ToolTip="Delete File">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

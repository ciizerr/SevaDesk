<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SevaDesk_App.Views.Controls.ToastNotificationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0,0,0,24"
    IsHitTestVisible="True">

    <UserControl.Resources>
        <Storyboard x:Name="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="ToastTransform"
                             Storyboard.TargetProperty="Y"
                             From="30" To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="ToastTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="30" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="ToastBorder"
            Opacity="0"
            MinWidth="280" MaxWidth="560"
            Padding="14,10,14,10"
            CornerRadius="8"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderThickness="1"
            Shadow="{ThemeResource SharedShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTransform" Y="30" />
        </Border.RenderTransform>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <!-- Severity Icon -->
            <Border x:Name="SeverityDot" Grid.Column="0"
                    Width="24" Height="24" CornerRadius="12"
                    VerticalAlignment="Center">
                <FontIcon x:Name="SeverityIcon" FontSize="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13" FontWeight="SemiBold"
                       MaxLines="3" TextTrimming="CharacterEllipsis" />

            <!-- Close Button -->
            <Button x:Name="CloseButton" Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="4" Width="28" Height="28">
                <FontIcon Glyph="&#xE711;" FontSize="10"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>

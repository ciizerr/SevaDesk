<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SevaDesk_App.Views.Flyouts.IncomingFileOverlayWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    Title="SevaDesk Triage HUD"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Padding="14,12,14,12"
        PointerEntered="Widget_PointerEntered"
        PointerExited="Widget_PointerExited">

        <Grid>
            <!-- Mode 1: Standard File Detection Triage Panel -->
            <Grid x:Name="TriageContentPanel" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <!-- 1. Header with Icon and Dismiss Button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock loc:Loc.Key="Triage.DetectedTitle" Text="New File Detected" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Padding="4" Click="Dismiss_Click" ToolTipService.ToolTip="Dismiss" UseSystemFocusVisuals="False">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- 2. File Details Card -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon x:Name="FileGlyphIcon" Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TxtFileName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="TxtFileMeta" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 3. Quick Document Rename Chips -->
                <StackPanel x:Name="QuickRenamePanel" Grid.Row="2" Spacing="4">
                    <TextBlock x:Name="TxtRenamePrompt" Text="Quick Tag &amp; Move:" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="DocChipsPanel" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                </StackPanel>

                <!-- 4. Auto-Move Checkbox -->
                <CheckBox x:Name="ChkAutoRoute" Grid.Row="3"
                          Content="Auto-move future files for this session"
                          FontSize="11" Margin="2,0,0,0"
                          ToolTipService.ToolTip="When checked, upcoming downloads and scans will automatically move to this customer" />

                <!-- 5. Dynamic Customer Action Buttons Container -->
                <Grid x:Name="ActionButtonsGrid" Grid.Row="4" Margin="0,2,0,0" MinHeight="34">
                    <!-- Populated dynamically in code-behind for 1, 2, or multiple sessions -->
                </Grid>

                <!-- 6. Countdown Progress Bar -->
                <ProgressBar x:Name="TimeoutProgressBar"
                             Grid.Row="5"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Height="2"
                             Margin="0,4,0,0"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>

            <!-- Mode 2: Auto-Moved Undo Panel (Appears when file was auto-routed) -->
            <Grid x:Name="AutoMovedUndoPanel" Visibility="Collapsed" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <!-- 1. Header with Success Dot -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="File Auto-Moved" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Padding="4" Click="Dismiss_Click" ToolTipService.ToolTip="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- 2. Auto-Moved File Description -->
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock x:Name="TxtAutoMovedFileName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="TxtAutoMovedTarget" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 3. Quick Rename Tags (shown after file is auto-moved) -->
                <StackPanel x:Name="AutoMovedRenamePanel" Grid.Row="2" Spacing="4">
                    <TextBlock Text="Quick Rename:" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="AutoMovedChipsPanel" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                </StackPanel>

                <!-- 4. Undo / Dismiss Actions -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Background="#E11D48" Foreground="White" HorizontalAlignment="Stretch" Click="UndoAutoMove_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Undo &amp; Stop Auto-Move" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Click="Dismiss_Click" Padding="12,5">
                        <TextBlock Text="Dismiss" FontSize="12" />
                    </Button>
                </Grid>

                <!-- 5. Quick Auto-Dismiss Bar -->
                <ProgressBar x:Name="UndoTimeoutProgressBar"
                             Grid.Row="4"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Height="2"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>

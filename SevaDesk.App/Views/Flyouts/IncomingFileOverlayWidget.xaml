<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SevaDesk_App.Views.Flyouts.IncomingFileOverlayWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    Title="SevaDesk Triage HUD"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0"
        CornerRadius="12"
        Padding="14,10,14,10">

        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
            <!-- 1. Header with Glyph and Dismiss Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock loc:Loc.Key="Triage.DetectedTitle" Text="Incoming File Detected" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Padding="4" Click="Dismiss_Click" ToolTipService.ToolTip="Dismiss" UseSystemFocusVisuals="False">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>

            <!-- 2. File Details Card -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon x:Name="FileGlyphIcon" Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtFileName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="TxtFileMeta" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 3. Action Buttons Row -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                <Button x:Name="BtnMainAction" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="MainAction_Click" UseSystemFocusVisuals="False">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock x:Name="TxtMainAction" Text="Move to Customer" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Click="Dismiss_Click" Padding="10,5" UseSystemFocusVisuals="False">
                    <TextBlock loc:Loc.Key="Triage.DismissBtn" Text="Dismiss" FontSize="12" />
                </Button>
            </Grid>

            <!-- 4. Subtle 12-Second Countdown Progress Bar -->
            <ProgressBar x:Name="TimeoutProgressBar"
                         Grid.Row="3"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         Height="2"
                         Margin="0,2,0,0"
                         Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </Border>
</Window>

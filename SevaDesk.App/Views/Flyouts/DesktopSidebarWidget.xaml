<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SevaDesk_App.Views.Flyouts.DesktopSidebarWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:models="using:SevaDesk.Core.Models"
    xmlns:flyouts="using:SevaDesk_App.Views.Flyouts"
    Title="SevaDesk Sidebar"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Collapsed Pill View (Visible when collapsed) -->
        <Border x:Name="CollapsedPillPanel"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,1"
                CornerRadius="16,0,0,16"
                PointerPressed="CollapsedPill_PointerPressed"
                PointerEntered="CollapsedPill_PointerEntered"
                PointerExited="CollapsedPill_PointerExited"
                ToolTipService.ToolTip="SevaDesk Sidebar (Click to expand)"
                Visibility="Visible">
            <Grid Padding="6,12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <!-- Expand Chevron Icon -->
                    <Border x:Name="PillChevronBorder"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8" Width="32" Height="28">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Small App Logo -->
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="22" Height="22" HorizontalAlignment="Center" />

                    <!-- Active Count Badge -->
                    <Border x:Name="CollapsedActiveBadge"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10" MinWidth="26" Height="20" Padding="5,1"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Active Sessions">
                        <TextBlock x:Name="TxtCollapsedActiveCount" Text="0" FontSize="11" FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Expanded Full Panel (Visible when expanded) -->
        <Grid x:Name="ExpandedPanel"
              Width="380"
              MinWidth="380"
              MaxWidth="380"
              HorizontalAlignment="Right"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Area -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="20" Height="20" />
                        <TextBlock x:Name="TxtShopName" Text="SevaDesk" FontWeight="Bold" FontSize="14" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="ActiveCountPill" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtActiveCount" Text="0 Active" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Background="Transparent" BorderBrush="Transparent" Click="OpenFullApp_Click"
                                ToolTipService.ToolTip="Open SevaDesk Full Window" Padding="6,4">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        </Button>
                        <Button Background="Transparent" BorderBrush="Transparent" Click="CollapseButton_Click"
                                ToolTipService.ToolTip="Collapse to edge" Padding="6,4">
                            <FontIcon Glyph="&#xE76C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Sessions List or Empty State -->
            <Grid Grid.Row="1" Padding="14,10">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE716;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock loc:Loc.Key="Widget.NoActiveSessions" Text="No active sessions currently running"
                                FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                </StackPanel>

                <!-- Sessions List -->
                <ListView x:Name="SessionsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ActiveSessionItem">
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <!-- Top Row: Name, Status, Timer, and Actions -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <!-- Customer Name, Status Badge, Live Timer -->
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Customer.Name}" FontWeight="SemiBold" FontSize="13" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                                <Border CornerRadius="3" Padding="4,1"
                                                        Background="{x:Bind flyouts:DesktopSidebarWidget.SessionStatusBackground(IsPaused), Mode=OneWay}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{x:Bind flyouts:DesktopSidebarWidget.SessionStatusForeground(IsPaused), Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Live Running / Paused Timer Chip -->
                                            <Border CornerRadius="4" Padding="5,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE916;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ElapsedDisplay, Mode=OneWay}" FontSize="11" FontFamily="Consolas" FontWeight="Medium" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions: Folder, Pause/Resume, End & More Menu -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <!-- Open Customer Working Folder in File Explorer -->
                                            <Button Background="Transparent" BorderThickness="0" Padding="5,4"
                                                    Click="OpenFolder_Click" Tag="{x:Bind Session.Id}"
                                                    ToolTipService.ToolTip="Open working folder in File Explorer">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>

                                            <!-- Pause / Resume Toggle -->
                                            <Button Background="Transparent" BorderThickness="0" Padding="5,4"
                                                    Click="TogglePauseSession_Click" Tag="{x:Bind Session.Id}"
                                                    ToolTipService.ToolTip="{x:Bind ToggleActionText, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind ToggleActionGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Button>

                                            <!-- End Session Button -->
                                            <Button Background="Transparent" BorderThickness="0" Padding="5,4"
                                                    Click="EndSessionItem_Click" Tag="{x:Bind Session.Id}"
                                                    ToolTipService.ToolTip="End session &amp; proceed to billing">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    <TextBlock loc:Loc.Key="Widget.EndSession" Text="End" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- More Options Menu (...) -->
                                            <Button Background="Transparent" BorderThickness="0" Padding="5,4"
                                                    ToolTipService.ToolTip="More options">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem loc:Loc.Key="Widget.CustomerWorkspace" Text="Open Customer Workspace"
                                                                        Click="OpenCustomerWorkspace_Click" Tag="{x:Bind Session.Id}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7EE;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem loc:Loc.Key="Widget.DeleteSession" Text="Delete Session"
                                                                        Click="DeleteSession_Click" Tag="{x:Bind Session.Id}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Online Form Linking (Add / Remove) -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <!-- Linked Application Chip (if linked) -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToVisible(HasLinkedApplication), Mode=OneWay}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind LinkedApplicationTitle, Mode=OneWay}" FontSize="11" FontWeight="Medium" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                                <Border CornerRadius="3" Padding="4,1" Margin="2,0,2,0"
                                                        Background="{x:Bind flyouts:DesktopSidebarWidget.AppStatusBackground(LinkedApplicationStatus), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind flyouts:DesktopSidebarWidget.AppStatusDisplay(LinkedApplicationStatus), Mode=OneWay}"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{x:Bind flyouts:DesktopSidebarWidget.AppStatusForeground(LinkedApplicationStatus), Mode=OneWay}" />
                                                </Border>
                                                <Button Click="UnlinkApplication_Click" Tag="{x:Bind Session.Id}" Background="Transparent" BorderThickness="0" Padding="3,1"
                                                        ToolTipService.ToolTip="Remove linked application">
                                                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- '+ Link Form' Button (if not linked) -->
                                        <Button Grid.Column="0" Click="OpenLinkFormFlyout_Click" Tag="{x:Bind Session.Id}"
                                                Background="Transparent" BorderBrush="Transparent" Padding="4,2" HorizontalAlignment="Left"
                                                Visibility="{x:Bind loc:CustomerAvatarHelper.BoolToCollapsed(HasLinkedApplication), Mode=OneWay}"
                                                ToolTipService.ToolTip="Link an online form / application">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Link Form" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Mobile / Code info on the right -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Customer.Mobile}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Customer.Code}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Bottom Quick-Actions: Quick Start Customer & UPI QR -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <!-- Quick Start Session Section -->
                    <StackPanel Spacing="6">
                        <TextBlock loc:Loc.Key="Widget.QuickStart" Text="Quick Start Session" FontWeight="SemiBold" FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <!-- Input Box or Staged Customer Chip -->
                            <Grid Grid.Column="0">
                                <AutoSuggestBox x:Name="TxtQuickCustomerName"
                                                 loc:Loc.PlaceholderKey="Widget.QuickStartPlaceholder"
                                                 PlaceholderText="Customer Name (e.g. Amit Kumar)..."
                                                 UpdateTextOnSelect="False"
                                                 TextChanged="TxtQuickCustomerName_TextChanged"
                                                 SuggestionChosen="TxtQuickCustomerName_SuggestionChosen"
                                                 QuerySubmitted="TxtQuickCustomerName_QuerySubmitted"
                                                 TextMemberPath="Name">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Customer">
                                            <StackPanel Padding="2,2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>

                                <!-- Staged Customer Preview Chip -->
                                <Border x:Name="SelectedCustomerCard" Visibility="Collapsed"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- Avatar Initials -->
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSelectedCustomerInitials" Text="AK" FontSize="10" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Name & Phone / Code -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="TxtSelectedCustomerName" Text="Customer Name" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TxtSelectedCustomerSub" Text="+91 9876543210 · CUST-101" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Clear Button -->
                                        <Button Grid.Column="2" Click="ClearSelectedCustomer_Click"
                                                loc:Loc.Key="Widget.ChangeCustomer"
                                                Background="Transparent" BorderThickness="0" Padding="4"
                                                ToolTipService.ToolTip="Change customer">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Start Button -->
                            <Button Grid.Column="1" x:Name="BtnQuickStart" Style="{StaticResource AccentButtonStyle}" Click="QuickStart_Click">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock loc:Loc.Key="Widget.StartBtn" Text="Start" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Quick UPI Bar -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Click="ToggleUpiCard_Click" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" Padding="4,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock loc:Loc.Key="Widget.QuickUpi" Text="Quick UPI QR" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="CopyUpi_Click" Background="Transparent" BorderBrush="Transparent" Padding="4,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                <TextBlock loc:Loc.Key="Widget.CopyUpi" Text="Copy UPI" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Expandable UPI Card -->
                    <Border x:Name="UpiCardPanel" Visibility="Collapsed" CornerRadius="8" Padding="12"
                            Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- Scannable High-Contrast QR Code -->
                            <Border Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center" Width="144" Height="144"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid Width="132" Height="132">
                                    <ProgressRing x:Name="WidgetQrLoadingRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="ImgWidgetQrCode" Width="132" Height="132" Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtPayeeName" Text="SevaDesk Cyber Center" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <TextBlock x:Name="TxtUpiVpa" Text="sevadesk.csc@upi" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="GooglePay · PhonePe · Paytm · BHIM" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

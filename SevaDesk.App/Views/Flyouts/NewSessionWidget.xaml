<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SevaDesk_App.Views.Flyouts.NewSessionWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:models="using:SevaDesk.Core.Models"
    Title="Start Customer Session"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="12"
        Padding="20,16,20,16">

        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock loc:Loc.Key="Dialog.NewCustomer.Title" Text="Start Customer Session" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="12" Margin="0,0,6,0">
                    <AutoSuggestBox
                        x:Name="NameSuggestBox"
                        loc:Loc.HeaderKey="Dialog.NewCustomer.NameHeader"
                        Header="Customer Name *"
                        loc:Loc.PlaceholderKey="Dialog.NewCustomer.NamePlaceholder"
                        PlaceholderText="Type name to search or create..."
                        TextChanged="NameSuggestBox_TextChanged"
                        SuggestionChosen="NameSuggestBox_SuggestionChosen"
                        QuerySubmitted="NameSuggestBox_QuerySubmitted"
                        TextMemberPath="Name">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Customer">
                                <StackPanel Padding="4,2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <Border x:Name="ExistingCustomerBadge"
                            Visibility="Collapsed"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtBadgeInfo"
                                       loc:Loc.Key="Dialog.NewCustomer.ExistingCustomerFound"
                                       Text="Existing customer matched — session will be linked to profile."
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox
                            x:Name="MobileBox"
                            Grid.Column="0"
                            loc:Loc.HeaderKey="Dialog.NewCustomer.MobileHeader"
                            Header="Mobile Number"
                            Margin="0,0,8,0"
                            loc:Loc.PlaceholderKey="Dialog.NewCustomer.MobilePlaceholder"
                            PlaceholderText="e.g. 9876543210" />

                        <TextBox
                            x:Name="VillageBox"
                            Grid.Column="1"
                            loc:Loc.HeaderKey="Dialog.NewCustomer.VillageHeader"
                            Header="Village / Locality"
                            Margin="8,0,0,0"
                            loc:Loc.PlaceholderKey="Dialog.NewCustomer.VillagePlaceholder"
                            PlaceholderText="e.g. Rampur" />
                    </Grid>

                    <TextBox
                        x:Name="IdRefBox"
                        loc:Loc.HeaderKey="Dialog.NewCustomer.IdRefHeader"
                        Header="Aadhaar / ID Ref (Optional)"
                        loc:Loc.PlaceholderKey="Dialog.NewCustomer.IdRefPlaceholder"
                        PlaceholderText="e.g. Last 4 digits: 1234" />

                    <TextBox
                        x:Name="NotesBox"
                        loc:Loc.HeaderKey="Dialog.NewCustomer.NotesHeader"
                        Header="Session Notes / Service (Optional)"
                        loc:Loc.PlaceholderKey="Dialog.NewCustomer.NotesPlaceholder"
                        PlaceholderText="e.g. PAN application &amp; photo scan" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <Button Grid.Column="1" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6" UseSystemFocusVisuals="False">
                    <TextBlock loc:Loc.Key="Common.Cancel" Text="Cancel" />
                </Button>
                <Button Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="StartSession_Click" Padding="16,6" UseSystemFocusVisuals="False">
                    <TextBlock loc:Loc.Key="Dialog.NewCustomer.PrimaryBtn" Text="Start Session" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

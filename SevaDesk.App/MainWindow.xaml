<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SevaDesk_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SevaDesk_App"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:controls="using:SevaDesk_App.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SevaDesk — Cyber Café Management System"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            loc:Loc.Key="App.Title"
            Title="SevaDesk — Cyber Café Management System"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="230"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    loc:Loc.Key="Nav.Dashboard"
                    Content="Dashboard"
                    IsSelected="True"
                    Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Sessions"
                    Content="Counter Sessions"
                    Tag="sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Documents"
                    Content="Document Hub"
                    Tag="documents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Payments"
                    Content="Cashier &amp; Billing"
                    Tag="payments">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Applications"
                    Content="Online Forms"
                    Tag="applications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Resources"
                    Content="Offline Forms"
                    Tag="resources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    loc:Loc.Key="Nav.Customers"
                    Content="Customers"
                    Tag="customers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE779;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    loc:Loc.Key="Nav.About"
                    Content="About"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Global In-App Triage InfoBar for Incoming Files -->
                <InfoBar x:Name="GlobalTriageBar"
                         Grid.Row="0"
                         IsOpen="False"
                         IsClosable="True"
                         CloseButtonClick="GlobalTriageBar_CloseButtonClick"
                         Severity="Informational"
                         Title="Incoming File Detected"
                         Margin="16,8,16,0">
                    <InfoBar.Content>
                        <ScrollViewer x:Name="InAppTriageChipsScrollViewer" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" Margin="0,4,0,2">
                            <StackPanel x:Name="InAppTriageChipsPanel" Orientation="Horizontal" Spacing="6" />
                        </ScrollViewer>
                    </InfoBar.Content>
                    <InfoBar.ActionButton>
                        <Button x:Name="BtnTriageAction" Style="{StaticResource AccentButtonStyle}" Click="TriageAction_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                <TextBlock x:Name="TxtTriageAction" Text="Move to Customer" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="NavFrame" Grid.Row="1" />

                <!-- Global Toast Notification Overlay (bottom-center) -->
                <controls:ToastNotificationControl Grid.RowSpan="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>

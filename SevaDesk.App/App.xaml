<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SevaDesk_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SevaDesk_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- CommunityToolkit.WinUI.Controls.SettingsControls styles (SharedShadow etc.) -->
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/Themes/Generic.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SevaDesk_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevaDesk_App.Pages"
    xmlns:loc="using:SevaDesk_App.Services"
    xmlns:vm="using:SevaDesk_App.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top Header Area -->
        <StackPanel Grid.Row="0" Spacing="4" Padding="24,20,24,12">
            <TextBlock loc:Loc.Key="Settings.Title" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock loc:Loc.Key="Settings.Subtitle" Text="Personalization, cyber café branding, printer configuration, and system information"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Segmented Tab Navigation -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="24,0,24,8">
            <SelectorBar x:Name="TabSelector" SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabAppearance" loc:Loc.Key="Settings.Tab.Appearance" Text="Appearance" />
                <SelectorBarItem x:Name="TabProfile" loc:Loc.Key="Settings.Tab.Profile" Text="Café Profile" />
                <SelectorBarItem x:Name="TabHardware" loc:Loc.Key="Settings.Tab.Hardware" Text="Hardware &amp; Rates" />
                <SelectorBarItem x:Name="TabStorage" loc:Loc.Key="Settings.Tab.Storage" Text="Storage &amp; Automation" />
                <SelectorBarItem x:Name="TabAbout" loc:Loc.Key="Settings.Tab.About" Text="About" />
            </SelectorBar>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="1040" HorizontalAlignment="Left">
                
                <!-- Status InfoBar with Auto-Dismiss -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Margin="0,0,0,8" />

                <!-- ======================================================== -->
                <!-- 1. APPEARANCE TAB -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelAppearance" Spacing="12">
                    <TextBlock loc:Loc.Key="Settings.Appearance.ThemeGroup" Text="Application Theme" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" />

                    <!-- Card: App Theme -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Appearance.ThemeTitle" Text="Theme Mode" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock loc:Loc.Key="Settings.Appearance.ThemeDesc" Text="Select your preferred application color mode"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="180"
                                      SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeSystem" Content="Windows Default" />
                                <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeLight" Content="Light" />
                                <ComboBoxItem loc:Loc.Key="Settings.Appearance.ThemeDark" Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Card: Mica Backdrop -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Appearance.MicaTitle" Text="Windows 11 Mica Backdrop" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock loc:Loc.Key="Settings.Appearance.MicaDesc" Text="Translucent window backdrop reflecting your desktop wallpaper"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableMicaBackdrop, Mode=TwoWay}"
                                          OnContent="Enabled" OffContent="Disabled" />
                        </Grid>
                    </Border>

                    <!-- Card: Window Close Action -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.General.CloseBehavior" Text="Window Close Action" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock loc:Loc.Key="Settings.General.CloseBehaviorDesc" Text="Choose whether clicking 'X' minimizes to the system tray or exits the app"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="180"
                                      SelectedIndex="{x:Bind ViewModel.SelectedCloseBehaviorIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Loc.Key="Settings.General.ClosePrompt" Content="Always Ask" />
                                <ComboBoxItem loc:Loc.Key="Settings.General.CloseMinimize" Content="Minimize to Tray" />
                                <ComboBoxItem loc:Loc.Key="Settings.General.CloseExit" Content="Exit Application" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock loc:Loc.Key="Settings.Appearance.LanguageGroup" Text="Language &amp; Regional Preferences" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <!-- Card: Language / भाषा -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock loc:Loc.Key="Settings.Appearance.LanguageTitle" Text="Language / भाषा" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock loc:Loc.Key="Settings.Appearance.LanguageDesc" Text="Select your application display language or sync new translations from GitHub"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox Width="200"
                                          ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Click="CheckLanguageUpdates_Click"
                                        IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsCheckingLanguageUpdates), Mode=OneWay}"
                                        ToolTipService.ToolTip="Check GitHub repository for new language translations">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE895;" FontSize="13" />
                                        <TextBlock loc:Loc.Key="Settings.Appearance.CheckUpdatesBtn" Text="Sync Languages" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 2. CAFÉ PROFILE TAB -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelProfile" Spacing="12" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Cafe.Header" Text="Center &amp; Operator Details" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" />

                    <!-- Card: Shop Name -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.ShopName" Text="Cyber Café / CSC Center Name" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.ShopNameDesc" Text="Printed on customer receipts, invoices, and payment screens"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{x:Bind ViewModel.ShopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: Operator Name -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.OperatorName" Text="VLE / Operator Name" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.OperatorNameDesc" Text="Primary cashier &amp; system operator name"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{x:Bind ViewModel.OperatorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: CSC VLE ID -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.CscId" Text="CSC VLE ID / Shop Code" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.CscIdDesc" Text="Official registration ID for CSC or cyber café center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320" FontFamily="Consolas"
                                     Text="{x:Bind ViewModel.CscVleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: Contact Number -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.Contact" Text="WhatsApp / Support Phone Number" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.ContactDesc" Text="Customer support phone displayed on bills"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{x:Bind ViewModel.ContactNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: Address -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.Address" Text="Shop Physical Address" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.AddressDesc" Text="Location address shown on receipts &amp; certificate printouts"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{x:Bind ViewModel.ShopAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <TextBlock loc:Loc.Key="Settings.Cafe.UpiHeader" Text="Digital UPI Payments" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <!-- Card: Shop UPI VPA -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.UpiVpa" Text="Shop UPI VPA (UPI ID)" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.UpiVpaDesc" Text="Destination address for dynamic UPI QR code generator (e.g. yourshop@upi)"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320" FontFamily="Consolas"
                                     Text="{x:Bind ViewModel.ShopUpiVpa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: Payee Name -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Cafe.PayeeName" Text="UPI Payee Display Name" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Cafe.PayeeNameDesc" Text="Account holder / business name shown inside customer UPI apps"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="320"
                                     Text="{x:Bind ViewModel.PayeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 3. HARDWARE & RATES TAB -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelHardware" Spacing="12" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Hardware.PrintersHeader" Text="Connected Printers" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" />

                    <!-- Card: B&W Printer -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Hardware.BwPrinter" Text="Counter B&amp;W Laser Printer" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Hardware.BwPrinterDesc" Text="Default hardware output for document and form printing"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="300" IsEditable="True"
                                      ItemsSource="{x:Bind ViewModel.InstalledPrinters}"
                                      Text="{x:Bind ViewModel.DefaultBwPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Card: Color Printer -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Hardware.ColorPrinter" Text="Photo &amp; Color Inkjet Printer" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Hardware.ColorPrinterDesc" Text="High resolution printer for photo, certificate, and color work"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="300" IsEditable="True"
                                      ItemsSource="{x:Bind ViewModel.InstalledPrinters}"
                                      Text="{x:Bind ViewModel.DefaultColorPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <TextBlock loc:Loc.Key="Settings.Hardware.RatesHeader" Text="Standard Service Rates (₹ INR)" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <!-- Grid of Rates -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <!-- B&W Single -->
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateBwSingle" Text="B&amp;W Print (Single Side)" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateBwSingleDesc" Text="Standard A4 per page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.BwSinglePageRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- B&W Double -->
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateBwDouble" Text="B&amp;W Print (Both Sides)" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateBwDoubleDesc" Text="Duplex A4 sheet" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.BwDoublePageRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- Color Document -->
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateColor" Text="Color Document Print" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateColorDesc" Text="A4 color printout per page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.ColorPageRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- Passport Photo -->
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RatePhoto" Text="Passport Photo Set" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RatePhotoDesc" Text="6 / 8 passport photo card" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.PhotoPrintRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- Lamination -->
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateLamination" Text="Lamination Service" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateLaminationDesc" Text="ID / A4 pouch per sheet" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.LaminationRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- Scanning -->
                        <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateScan" Text="Document Scanning" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock loc:Loc.Key="Settings.Hardware.RateScanDesc" Text="Scan to PDF / JPEG per doc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="80" TextAlignment="Right"
                                         Text="{x:Bind ViewModel.ScanRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 4. STORAGE & AUTOMATION TAB -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelStorage" Spacing="12" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.Storage.Header" Text="Working Folders &amp; Ingestion" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" />

                    <!-- Card: Working Root Directory -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Storage.WorkingFolder" Text="Desktop Working Root Directory" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.WorkingRootPath, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.OpenFolderBtn" Text="Open in Explorer" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card: Auto-Triage Bluetooth -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Storage.BluetoothTriage" Text="Auto-Detect Incoming Files" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Storage.BluetoothTriageDesc" Text="Watch Bluetooth Exchange &amp; WhatsApp downloads to route to active customer"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoOrganizeBluetooth, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Card: Auto-Archive Sessions -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Storage.AutoArchive" Text="Auto-Archive Customer Sessions" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock loc:Loc.Key="Settings.Storage.AutoArchiveDesc" Text="Automatically archive completed customer folders older than duration"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="180"
                                      SelectedIndex="{x:Bind ViewModel.AutoArchiveDaysIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="After 7 days" />
                                <ComboBoxItem Content="After 15 days" />
                                <ComboBoxItem Content="After 30 days" />
                                <ComboBoxItem Content="After 60 days" />
                                <ComboBoxItem Content="Never" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock loc:Loc.Key="Settings.Storage.DbHeader" Text="Database &amp; Data Safety" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <!-- Card: Database Backup -->
                    <Border CornerRadius="8" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.Storage.DbTitle" Text="SQLite Application Database" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="Backup_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE792;" FontSize="14" />
                                    <TextBlock loc:Loc.Key="Settings.Storage.DbBackupBtn" Text="Backup Database Now" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- 5. ABOUT & SYSTEM TAB (TWO-COLUMN MODERN LAYOUT) -->
                <!-- ======================================================== -->
                <StackPanel x:Name="PanelAbout" Spacing="16" Visibility="Collapsed">
                    <TextBlock loc:Loc.Key="Settings.About.Header" Text="About SevaDesk" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />

                    <!-- Two-Column Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- ================= LEFT COLUMN: Application Info, Feedback & Reset ================= -->
                        <StackPanel Grid.Column="0" Spacing="12">
                            <TextBlock loc:Loc.Key="Settings.About.AppSectionTitle" Text="Application &amp; System" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

                            <!-- Card 1: Brand Identity & Runtime Specs -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Image Grid.Column="0" Source="Assets/Square44x44Logo.scale-200.png"
                                               Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="SevaDesk" FontSize="18" FontWeight="Bold" />
                                                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock loc:Loc.Key="Common.Active" Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Runtime Badges & Specs -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.BuildInfoDisplay, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="WinUI 3" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text=".NET 8 (win-x64)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="SQLite Offline DB" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Issues & Feature Requests -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE939;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock loc:Loc.Key="Settings.About.FeedbackTitle" Text="Issues &amp; Feedback" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                        <TextBlock loc:Loc.Key="Settings.About.FeedbackDesc" Text="Encountered a bug or want to suggest a new feature for SevaDesk?"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="ReportBug_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xEBE8;" FontSize="13" />
                                                <TextBlock loc:Loc.Key="Settings.About.ReportBugBtn" Text="Report a Bug" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="RequestFeature_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE734;" FontSize="13" />
                                                <TextBlock loc:Loc.Key="Settings.About.RequestFeatureBtn" Text="Request Feature" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Restore Defaults -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock loc:Loc.Key="Settings.About.ResetTitle" Text="Restore Defaults" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock loc:Loc.Key="Settings.About.ResetDesc" Text="Restore all themes, rates, and configuration values to initial factory defaults"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="Reset_Click">
                                        <TextBlock loc:Loc.Key="Settings.About.ResetBtn" Text="Restore Defaults" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ================= RIGHT COLUMN: Developer, Community & Sponsorship ================= -->
                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock loc:Loc.Key="Settings.About.DevSectionTitle" Text="Developer &amp; Community" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

                            <!-- Card 1: Developed by ciizerr with GitHub Profile -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock loc:Loc.Key="Settings.About.DevelopedBy" Text="Developed by ciizerr" FontSize="15" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock loc:Loc.Key="Settings.About.DeveloperDesc" Text="Open-source cyber café and CSC center workspace platform"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="OpenGitHub_Click" Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Width="15" Height="15">
                                                    <Path Fill="White" Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                                                </Viewbox>
                                                <TextBlock loc:Loc.Key="Settings.About.GithubBtn" Text="github.com/ciizerr" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Support & Sponsorship (Buy Me a Coffee & UPI) -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEB51;" FontSize="15" Foreground="#FF5E36" />
                                            <TextBlock loc:Loc.Key="Settings.About.SponsorTitle" Text="Support &amp; Sponsorship" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                        <TextBlock loc:Loc.Key="Settings.About.SponsorDesc" Text="Help keep SevaDesk active, open-source, and free for local café operators"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <!-- Buy Me a Coffee Button -->
                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="BuyMeCoffee_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#FFDD00" Data="M3 13.5C3 17.09 5.91 20 9.5 20h3C16.09 20 19 17.09 19 13.5V6H3v7.5z" />
                                                        <Path Fill="#FFDD00" Data="M19 8h1.5C21.88 8 23 9.12 23 10.5S21.88 13 20.5 13H19V8zm0 3.5h1.5c.55 0 1-.45 1-1s-.45-1-1-1H19v2z" />
                                                        <Path Fill="#FF813F" Data="M7 2h2v2H7zm4-1h2v3h-2zm4 1h2v2h-2z" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock loc:Loc.Key="Settings.About.BuyMeCoffeeBtn" Text="Buy Me a Coffee" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- UPI Support Button -->
                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="CopyUpi_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#F37021" Data="M14.5 4L8 15h5.5l-2 5L18 9h-5.5z" />
                                                        <Path Fill="#43A047" Data="M9.5 4L3 15h5.5l-2 5L13 9H7.5z" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock loc:Loc.Key="Settings.About.CopyUpiBtn" Text="Copy UPI ID" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Community & Discussions -->
                            <Border CornerRadius="8" Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Viewbox Width="16" Height="16">
                                                <Path Fill="#5865F2" Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                                            </Viewbox>
                                            <TextBlock loc:Loc.Key="Settings.About.CommunityTitle" Text="Community &amp; Discussions" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock loc:Loc.Key="Settings.About.CommunityDesc" Text="Join community discussions, ask questions, and share café setups"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="Community_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="13" />
                                            <TextBlock loc:Loc.Key="Settings.About.CommunityBtn" Text="GitHub Discussions" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
